## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Visual Studio
.vs/
.vscode/
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# NuGet
*.nupkg
*.snupkg
.nuget/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.user

# ASP.NET Core
Properties/launchSettings.json

# IDEs
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project-specific
bin/
obj/
wwwroot/uploads/
*.log
appsettings.local.json

# Large files / build artifacts
*.tar
*.tar.gz

# Node
node_modules/
package-lock.json

# Claude local state
.claude/worktrees/
.claude/settings.local.json

# Screenshot / font / temp files at repo root
*.png
*.ttf
*.mjs
*.tmp
.tmp-*
