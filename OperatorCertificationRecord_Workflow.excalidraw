    {
      "id": "dc-snapshot-lbl",
      "type": "text",
      "x": 1907.37597517117,
      "y": 981.4734767424288,
      "width": 314.572265625,
      "height": 224,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "text": "DashboardSnapshot (sealed record)\n─────────────────────────────────────\n+ Data: DashboardData\n+ CapturedAt: DateTimeOffset\n+ IsStale(maxAge): bool\n\nvolatile _snapshot: DashboardSnapshot?\n  ← lock-free reads\n  ← atomic reference swap on write\n\nSemaphoreSlim(1,1) _refreshLock\n  ← WaitAsync(0) = non-blocking tryacquire\n  ← prevents cache stampedes",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "version": 109,
      "versionNonce": 892275811,
      "index": "b2K",
      "isDeleted": false,
      "seed": 1,
      "frameId": null,
