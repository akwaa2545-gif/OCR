@page
@model OperatorCertificationRecord.Web.Pages.AdminsModel
@inject OperatorCertificationRecord.Web.Services.DeveloperRoleService DeveloperRoles
@{
    ViewData["Title"] = "Access Management";
    ViewData["ActivePage"] = "Admins";
    int adminCount = Model.AdminCount;
    int developerCount = Model.DeveloperCount;
    int memberCount = Model.AccessMembers.Count;
    bool isDeveloper = DeveloperRoles.IsDeveloper(HttpContext.Session.GetString("UserCode"));
    bool hasStatus = !string.IsNullOrEmpty(Model.StatusMessage);
    bool isSuccess = hasStatus && (Model.StatusMessage!.StartsWith("Added") || Model.StatusMessage.StartsWith("Removed"));
}

@section Styles {
<style>
    /* ── Hero – orange / black / white / gray theme ── */
    .adm-hero {
        background: linear-gradient(135deg, #fff7ed 0%, #fef9f6 55%, #fff 100%);
        border: 1px solid #fed7aa;
        border-left: 5px solid #f97316;
        border-radius: var(--radius-lg);
        padding: 1.5rem 1.75rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 2px 12px rgba(249,115,22,0.10);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        position: relative;
        overflow: hidden;
    }
    .adm-hero::after {
        content: '';
        position: absolute;
        right: -40px; top: -40px;
        width: 160px; height: 160px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(249,115,22,0.08) 0%, transparent 70%);
        pointer-events: none;
    }
    .adm-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: #ea580c;
        background: #ffedd5;
        border: 1px solid #fed7aa;
        border-radius: 999px;
        padding: 0.18rem 0.6rem;
        margin-bottom: 0.45rem;
    }
    .adm-hero-title {
        font-size: 1.45rem;
        font-weight: 800;
        color: #111827;
        margin: 0 0 0.25rem;
        line-height: 1.2;
        letter-spacing: -0.01em;
    }
    .adm-hero-sub {
        font-size: 0.82rem;
        color: #6b7280;
        margin: 0;
        max-width: 460px;
    }
    /* ── Stat chip ── */
    .adm-stat {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: #fff;
        border: 1px solid #fed7aa;
        border-radius: var(--radius-lg);
        padding: 0.75rem 1.25rem;
        box-shadow: 0 1px 6px rgba(249,115,22,0.10);
    }
    .adm-stat-icon {
        width: 44px; height: 44px;
        border-radius: 12px;
        background: linear-gradient(135deg, #f97316, #ea580c);
        display: flex; align-items: center; justify-content: center;
        color: #fff;
        font-size: 1.25rem;
        flex-shrink: 0;
    }
    .adm-stat-val { font-size: 1.6rem; font-weight: 800; color: #111827; line-height: 1; }
    .adm-stat-lbl { font-size: 0.73rem; color: #6b7280; font-weight: 500; }
    /* ── Toast notification ── */
    .adm-toast {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        border-radius: var(--radius-md);
        padding: 0.75rem 1.1rem;
        margin-bottom: 1.1rem;
        font-size: 0.85rem;
        font-weight: 500;
        animation: toastIn 0.3s ease;
    }
    @@keyframes toastIn { from { opacity:0; transform:translateY(-8px); } to { opacity:1; transform:none; } }
    .adm-toast-success { background: #fff7ed; border: 1px solid #fdba74; color: #c2410c; }
    .adm-toast-info    { background: #f9fafb; border: 1px solid #d1d5db; color: #374151; }
    .adm-toast i { font-size: 1.1rem; flex-shrink: 0; }
    /* ── Add admin card ── */
    .adm-add-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: var(--radius-lg);
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 1px 6px rgba(0,0,0,0.06);
    }
    .adm-add-title {
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #374151;
        margin-bottom: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }
    .adm-add-title i { color: #f97316; }
    .adm-input-wrap {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
    }
    .adm-input {
        flex: 1;
        min-width: 180px;
        height: 40px;
        padding: 0 0.85rem;
        border: 1.5px solid #d1d5db;
        border-radius: var(--radius-md);
        font-size: 0.88rem;
        color: #111827;
        background: #fafafa;
        outline: none;
        transition: border-color .15s, box-shadow .15s;
    }
    .adm-input:focus { border-color: #f97316; box-shadow: 0 0 0 3px rgba(249,115,22,0.12); background: #fff; }
    .adm-btn-add {
        height: 40px;
        padding: 0 1.3rem;
        border: none;
        border-radius: var(--radius-md);
        background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
        color: #fff;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: all .18s;
        white-space: nowrap;
        box-shadow: 0 2px 8px rgba(249,115,22,0.35);
    }
    .adm-btn-add:hover {
        background: linear-gradient(135deg, #ea580c 0%, #f97316 100%);
        box-shadow: 0 4px 14px rgba(249,115,22,0.45);
        transform: translateY(-1px);
    }
    .adm-btn-add:active { transform: scale(0.96); }
    /* ── Admin list card ── */
    .adm-list-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: 0 1px 6px rgba(0,0,0,0.07);
    }
    .adm-list-header {
        background: linear-gradient(90deg, #1f2937 0%, #374151 100%);
        color: rgba(255,255,255,0.92);
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        padding: 0.65rem 1.1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }
    .adm-list-header-left { display: flex; align-items: center; gap: 0.5rem; }
    .adm-count-pill {
        background: rgba(255,255,255,0.18);
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.1rem 0.55rem;
    }
    .adm-table { width: 100%; border-collapse: collapse; }
    .adm-table thead tr {
        border-bottom: 1px solid #e5e7eb;
        background: #f9fafb;
    }
    .adm-table thead th {
        font-size: 0.73rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .07em;
        color: #6b7280;
        padding: 0.6rem 1rem;
    }
    .adm-table tbody tr {
        border-bottom: 1px solid #f3f4f6;
        transition: background .12s;
    }
    .adm-table tbody tr:last-child { border-bottom: none; }
    .adm-table tbody tr:hover { background: #fff7ed; }
    .adm-table td { padding: 0.75rem 1rem; vertical-align: middle; }
    /* ── Avatar ── */
    .adm-avatar {
        width: 38px; height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, #f97316, #ea580c);
        color: #fff;
        font-size: 0.8rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        letter-spacing: .02em;
        box-shadow: 0 2px 6px rgba(249,115,22,0.30);
    }
    .adm-name-block { display: flex; align-items: center; gap: 0.65rem; }
    .adm-name { font-size: 0.88rem; font-weight: 600; color: #111827; }
    .adm-code-badge {
        display: inline-flex;
        align-items: center;
        background: #f3f4f6;
        color: #1f2937;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.2rem 0.55rem;
        letter-spacing: .04em;
        font-variant-numeric: tabular-nums;
    }
    .adm-role-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        background: #ffedd5;
        color: #c2410c;
        border: 1px solid #fdba74;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.2rem 0.6rem;
    }
    .adm-role-badge i { font-size: 0.75rem; }
    /* ── Remove button ── */
    .adm-btn-remove {
        height: 32px;
        padding: 0 0.85rem;
        border: 1.5px solid #fca5a5;
        border-radius: var(--radius-md);
        background: #fff;
        color: #dc2626;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        transition: all .15s;
        white-space: nowrap;
    }
    .adm-btn-remove:hover { background: #fef2f2; border-color: #f87171; box-shadow: 0 2px 8px rgba(220,38,38,0.15); }
    .adm-btn-remove:active { transform: scale(0.95); }
    /* ── Empty state ── */
    .adm-empty {
        padding: 2.5rem 1rem;
        text-align: center;
        color: #9ca3af;
    }
    .adm-empty i { font-size: 2.5rem; display: block; margin-bottom: 0.5rem; }
    .adm-empty p { font-size: 0.88rem; margin: 0; }
    /* ── Confirm modal overlay ── */
    .adm-modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,0.45);
        z-index: 1050;
        align-items: center;
        justify-content: center;
    }
    .adm-modal-backdrop.open { display: flex; }
    .adm-modal {
        background: #fff;
        border-radius: var(--radius-lg);
        padding: 1.75rem 1.75rem 1.5rem;
        max-width: 380px;
        width: 90%;
        box-shadow: 0 20px 60px rgba(0,0,0,0.18);
        animation: modalIn 0.22s cubic-bezier(0.34,1.56,0.64,1);
    }
    @@keyframes modalIn { from { opacity:0; transform:scale(0.88); } to { opacity:1; transform:none; } }
    .adm-modal-icon {
        width: 52px; height: 52px;
        border-radius: 50%;
        background: #fef2f2;
        border: 2px solid #fca5a5;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 1rem;
        color: #dc2626;
        font-size: 1.4rem;
    }
    .adm-modal-title { font-size: 1.05rem; font-weight: 700; color: #111827; text-align: center; margin-bottom: 0.4rem; }
    .adm-modal-body  { font-size: 0.85rem; color: #6b7280; text-align: center; margin-bottom: 1.4rem; }
    .adm-modal-body strong { color: #111827; }
    .adm-modal-actions { display: flex; gap: 0.6rem; justify-content: center; }
    .adm-modal-cancel {
        flex: 1;
        height: 38px;
        border: 1.5px solid #d1d5db;
        border-radius: var(--radius-md);
        background: #fff;
        color: #374151;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
    }
    .adm-modal-cancel:hover { background: #f9fafb; }
    .adm-modal-confirm {
        flex: 1;
        height: 38px;
        border: none;
        border-radius: var(--radius-md);
        background: linear-gradient(135deg, #dc2626, #ef4444);
        color: #fff;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(220,38,38,0.30);
        transition: all .15s;
    }
    .adm-modal-confirm:hover { background: linear-gradient(135deg, #b91c1c, #dc2626); }
    /* Access directory: compact rows, independent role badges, clear actions. */
    .adm-hero { background: #fff; border: 1px solid #e2e8f0; border-left: 4px solid #f97316; padding: 24px; box-shadow: none; }
    .adm-hero::after { display: none; }
    .adm-hero-title { font-size: 24px; }
    .adm-hero-sub { max-width: 560px; color: #475569; font-size: 14px; line-height: 1.6; }
    .adm-hero-badge { background: #fff7ed; color: #9a3412; border-radius: 5px; letter-spacing: .05em; }
    .adm-stats { display: flex; flex-wrap: wrap; gap: 10px; }
    .adm-stat { gap: 10px; padding: 12px 16px; border-color: #e2e8f0; border-radius: 8px; box-shadow: none; min-width: 120px; }
    .adm-stat-icon { width: 36px; height: 36px; background: #fff7ed; color: #c2410c; border-radius: 8px; font-size: 18px; }
    .adm-stat-dev .adm-stat-icon { background: #e8eef8; color: #1e3a5f; }
    .adm-stat-val { font-size: 24px; }
    .adm-stat-lbl { font-size: 12px; color: #475569; margin-top: 4px; }
    .adm-add-card { box-shadow: none; border-color: #e2e8f0; padding: 18px 20px; }
    .adm-add-title { text-transform: none; letter-spacing: normal; font-size: 15px; margin-bottom: 6px; }
    .adm-add-help { margin: 0 0 14px; color: #475569; font-size: 13px; }
    .adm-code-label { display: block; margin-bottom: 6px; font-size: 12px; color: #475569; font-weight: 600; }
    .adm-input { min-width: 140px; border-color: #64748b; background: #fff; }
    .adm-btn-add { background: #0f172a; box-shadow: none; }
    .adm-btn-add:hover { background: #334155; box-shadow: none; transform: none; }
    .adm-list-card { border-color: #e2e8f0; box-shadow: none; }
    .adm-list-header { background: #0f172a; padding: 16px 20px; font-size: 15px; }
    .adm-list-hint { color: #cbd5e1; font-size: 12px; font-weight: 400; }
    .adm-table-wrap { overflow-x: auto; }
    .adm-table { min-width: 680px; }
    .adm-table thead th { text-align: left; font-size: 11px; color: #475569; padding: 12px 18px; }
    .adm-table td { padding: 14px 18px; }
    .adm-table tbody tr:hover { background: #f8fafc; }
    .adm-name { font-size: 14px; }
    .adm-avatar { background: #fff7ed; color: #9a3412; box-shadow: none; border: 1px solid #fed7aa; }
    .adm-code-badge { font-size: 12px; background: #f8fafc; border-color: #e2e8f0; }
    .adm-role-list, .adm-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
    .adm-actions { justify-content: flex-end; }
    .adm-role-badge { border-radius: 6px; padding: 5px 9px; font-size: 12px; font-weight: 600; white-space: nowrap; }
    .adm-role-developer { background: #e8eef8; color: #1e3a5f; border-color: #bccce1; }
    .adm-protected { display: inline-flex; align-items: center; gap: 6px; color: #475569; font-size: 12px; padding: 8px 0; }
    .adm-btn-manage { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 40px; padding: 8px 12px; border: 1px solid #64748b; border-radius: 7px; color: #0f172a; background: #fff; text-decoration: none; font-size: 12px; font-weight: 600; white-space: nowrap; }
    .adm-btn-manage:hover { background: #f1f5f9; color: #0f172a; }
    .adm-btn-remove { min-height: 40px; height: auto; font-size: 12px; color: #b91c1c; border-color: #fca5a5; }
    .adm-btn-manage:focus-visible, .adm-btn-remove:focus-visible, .adm-btn-add:focus-visible, .adm-input:focus-visible { outline: 3px solid #ea580c; outline-offset: 3px; }
    .adm-table-wrap:focus-visible { outline: 3px solid #ea580c; outline-offset: -3px; }
    @@media (max-width: 700px) {
        .adm-hero { padding: 18px; }
        .adm-stats { width: 100%; }
        .adm-stat { flex: 1; min-width: 0; padding: 12px; }
        .adm-list-header { align-items: flex-start; flex-direction: column; }
        .adm-add-card { padding: 18px; }
    }
</style>
}

<!-- Hero -->
<div class="adm-hero page-intro">
    <div>
        <p class="adm-hero-sub">Review Admin and Developer access in one place. Employees can have either role or both.</p>
    </div>
    <div class="adm-stats" aria-label="Access totals">
      <div class="adm-stat">
        <div class="adm-stat-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></div>
        <div>
            <div class="adm-stat-val">@adminCount</div>
            <div class="adm-stat-lbl">@(adminCount == 1 ? "Admin" : "Admins")</div>
        </div>
      </div>
      <div class="adm-stat adm-stat-dev">
        <div class="adm-stat-icon"><i class="bi bi-code-slash" aria-hidden="true"></i></div>
        <div>
            <div class="adm-stat-val">@developerCount</div>
            <div class="adm-stat-lbl">@(developerCount == 1 ? "Developer" : "Developers")</div>
        </div>
      </div>
    </div>
</div>

@if (hasStatus)
{
    <div class="adm-toast @(isSuccess ? "adm-toast-success" : "adm-toast-info")">
        <i class="bi @(isSuccess ? "bi-check-circle-fill" : "bi-info-circle-fill")"></i>
        @Model.StatusMessage
    </div>
}

<!-- Add Admin -->
<div class="adm-add-card">
    <div class="adm-add-title">
        <i class="bi bi-person-plus-fill" aria-hidden="true"></i> Grant Admin access
    </div>
    <p class="adm-add-help">@(isDeveloper ? "For Developer access or other role changes, open the employee's Manage access page." : "Grant Admin access to employees who do not have Developer access.")</p>
    <form method="post" asp-page-handler="Add">
        <label asp-for="NewEmpCode" class="adm-code-label">Employee code</label>
        <div class="adm-input-wrap">
            <input asp-for="NewEmpCode"
                   class="adm-input"
                   placeholder="e.g. 0402567" inputmode="numeric" maxlength="20" pattern="[0-9]{1,20}"
                   autocomplete="off"
                   required />
            <button type="submit" class="adm-btn-add">
                <i class="bi bi-shield-plus"></i> Add Admin
            </button>
        </div>
    </form>
</div>

<!-- Admin list -->
<div class="adm-list-card">
    <div class="adm-list-header">
        <div class="adm-list-header-left">
            <i class="bi bi-people-fill"></i>
            Employees with access
            <span class="adm-count-pill">@memberCount</span>
        </div>
        <span class="adm-list-hint">@(isDeveloper ? "Manage Admin and Developer access independently." : "Developer accounts are protected.")</span>
    </div>

    @if (!Model.AccessMembers.Any())
    {
        <div class="adm-empty">
            <i class="bi bi-inbox"></i>
            <p>No Admin or Developer access configured.</p>
        </div>
    }
    else
    {
        <div class="adm-table-wrap" role="region" aria-label="Employees and application access" tabindex="0">
        <table class="adm-table">
            <thead>
                <tr>
                    <th scope="col">Employee</th>
                    <th scope="col">Employee Code</th>
                    <th scope="col">Access roles</th>
                    <th scope="col" style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.AccessMembers)
                {
                    var initials = string.Join("",
                        (a.FullName ?? a.EmpCode)
                            .Split(' ', System.StringSplitOptions.RemoveEmptyEntries)
                            .Take(2)
                            .Select(w => w[0].ToString().ToUpper()));
                    <tr>
                        <td>
                            <div class="adm-name-block">
                                <div class="adm-avatar" data-ini="@initials">
                                    @if (!string.IsNullOrEmpty(a.PhotoUrl))
                                    {
                                        <img src="@OperatorCertificationRecord.Web.Services.EmployeeFileUrls.Photo(a.PhotoUrl)" alt="@a.FullName"
                                             style="width:100%;height:100%;border-radius:50%;object-fit:cover;"
                                             onerror="if(this.src.includes('/api/photo/employee/')){this.alt='Photo unavailable';this.title='Photo unavailable';return;}this.onerror=null;this.parentElement.textContent=this.parentElement.getAttribute('data-ini');" />
                                    }
                                    else
                                    {
                                        @initials
                                    }
                                </div>
                                <span class="adm-name">@(a.FullName == a.EmpCode ? "—" : a.FullName)</span>
                            </div>
                        </td>
                        <td><span class="adm-code-badge">@a.EmpCode</span></td>
                        <td>
                            <div class="adm-role-list">
                                @if (a.IsAdmin && !a.IsDeveloper)
                                {
                                    <span class="adm-role-badge"><i class="bi bi-shield-fill-check" aria-hidden="true"></i> Admin</span>
                                }
                                @if (a.IsDeveloper)
                                {
                                    <span class="adm-role-badge adm-role-developer"><i class="bi bi-code-slash" aria-hidden="true"></i> Developer</span>
                                }
                            </div>
                        </td>
                        <td style="text-align:right;">
                            <div class="adm-actions">
                            @if (isDeveloper)
                            {
                                <a class="adm-btn-manage" asp-page="/UpdateUser" asp-route-empCode="@a.EmpCode" aria-label="Manage access for @a.EmpCode">Manage access <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                            }
                            @if (!isDeveloper && a.IsDeveloper)
                            {
                                <span class="adm-protected"><i class="bi bi-lock" aria-hidden="true"></i> Protected account</span>
                            }
                            @if (a.IsAdmin && (isDeveloper || !a.IsDeveloper))
                            {
                            <button type="button" aria-label="Remove Admin access for @a.EmpCode"
                                    class="adm-btn-remove"
                                    data-empcode="@a.EmpCode"
                                    data-name="@(a.FullName == a.EmpCode ? a.EmpCode : a.FullName)"
                                    onclick="openRemoveModal(this)">
                                <i class="bi bi-person-dash-fill" aria-hidden="true"></i> Remove Admin
                            </button>
                            }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

<!-- Confirm Remove Modal -->
<div class="adm-modal-backdrop" id="admRemoveBackdrop">
    <div class="adm-modal">
        <div class="adm-modal-icon"><i class="bi bi-person-x-fill"></i></div>
        <div class="adm-modal-title">Remove Administrator</div>
        <div class="adm-modal-body">
            Remove admin privileges for <strong id="admModalName"></strong>?
            They will no longer have administrator access.
        </div>
        <div class="adm-modal-actions">
            <button class="adm-modal-cancel" onclick="closeRemoveModal()">Cancel</button>
            <form id="admRemoveForm" method="post" asp-page-handler="Remove" style="flex:1;display:contents;">
                <input type="hidden" id="admRemoveInput" name="empCode" value="" />
                <button type="submit" class="adm-modal-confirm">
                    <i class="bi bi-trash3-fill"></i> Remove
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openRemoveModal(btn) {
        document.getElementById('admModalName').textContent = btn.dataset.name;
        document.getElementById('admRemoveInput').value = btn.dataset.empcode;
        document.getElementById('admRemoveBackdrop').classList.add('open');
    }
    function closeRemoveModal() {
        document.getElementById('admRemoveBackdrop').classList.remove('open');
    }
    document.getElementById('admRemoveBackdrop').addEventListener('click', function (e) {
        if (e.target === this) closeRemoveModal();
    });
</script>
}
