// relocate modals to body to escape any transformed ancestors\n(function(){\n  document.querySelectorAll('.modal').forEach(function(m){\n    if(m.parentElement !== document.body) document.body.appendChild(m);\n  });\n})();\n
function validateDateRange(startId, endId, errId, previewBtnId, dlBtnId) {
    const s = document.getElementById(startId);
    const e = document.getElementById(endId);
    const err = document.getElementById(errId);
    if (!s || !e || !err) return true;
    const invalid = s.value && e.value && s.value > e.value;
    if (invalid) {
        s.classList.add('dm-invalid'); e.classList.add('dm-invalid');
        err.textContent = 'End date must be on or after start date.';
        err.classList.add('visible');
    } else {
        s.classList.remove('dm-invalid'); e.classList.remove('dm-invalid');
        err.classList.remove('visible'); err.textContent = '';
    }
    if (previewBtnId) { const b = document.getElementById(previewBtnId); if (b) b.disabled = !!invalid; }
    if (dlBtnId)      { const b = document.getElementById(dlBtnId);      if (b) b.disabled = !!invalid; }

    return !invalid;
}

// ═══ FORCE Modal Centering Override ═══
document.addEventListener('DOMContentLoaded', function() {
    const modals = document.querySelectorAll('.modal');
    
    modals.forEach(modal => {
        modal.addEventListener('show.bs.modal', function(e) {
            // Remove ALL inline styles and force our own
            this.removeAttribute('style');
            this.setAttribute('style', `
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                width: 100% !important;
                height: 100% !important;
                z-index: 1050 !important;
                padding: 1rem !important;
            `);
        });
        
        modal.addEventListener('shown.bs.modal', function(e) {
            // Keep forcing it after Bootstrap finishes
            this.style.display = 'flex';
            this.style.alignItems = 'center';
            this.style.justifyContent = 'center';
            this.style.position = 'fixed';
            this.style.top = '0';
            this.style.left = '0';
            this.style.width = '100%';
            this.style.height = '100%';
            this.style.zIndex = '1050';
            this.style.padding = '1rem';
            this.style.boxSizing = 'border-box';
            
            const dialog = this.querySelector('.modal-dialog');
            if (dialog) {
                dialog.style.position = 'relative';
                dialog.style.margin = '0 auto';
                dialog.style.width = 'auto';
            }
        });
    });
    
    // Also intercept modal display changes
    const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
                const modal = mutation.target;
                if (modal.classList.contains('show') && modal.classList.contains('modal')) {
                    modal.style.display = 'flex !important';
                    modal.style.alignItems = 'center !important';
                    modal.style.justifyContent = 'center !important';
                }
            }
        });
    });
    
    modals.forEach(modal => {
        observer.observe(modal, { attributes: true, attributeFilter: ['style'] });
    });
});
