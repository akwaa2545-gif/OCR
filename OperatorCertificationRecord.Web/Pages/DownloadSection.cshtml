<script>
// preset helper used by preset buttons

// Defensive modal open handler for Operator No-skill (ensures modal opens even if data-attrs are blocked)
(function initOperatorNoSkillModal(){
    function openModalFallback(el){
        document.querySelectorAll('.modal-backdrop').forEach(b=>b.remove());
        const backdrop = document.createElement('div');
        backdrop.className = 'modal-backdrop fade show';
        document.body.appendChild(backdrop);
        // force display
        el.classList.add('show');
        el.style.display = 'flex';
        el.setAttribute('aria-modal','true');
        el.removeAttribute('aria-hidden');
        const focusable = el.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        if (focusable) focusable.focus();
        // dispatch Bootstrap-like event so listeners in modal partial run
        try{ el.dispatchEvent(new Event('shown.bs.modal')); } catch(e){ /* ignore */ }
        if (window.Toast) try{ window.Toast.info('Modal','Operator No-skill opened (fallback)'); } catch(e){}
        backdrop.addEventListener('click', ()=> {
        // ensure close buttons inside fallback modal also clear backdrop
        el.querySelectorAll("[data-bs-dismiss=\"modal\"], .btn-close").forEach(function(btn){ btn.addEventListener("click", function(){ try{ el.classList.remove("show"); el.style.display="none"; backdrop.remove(); } catch(e){ console.error("Backdrop close error", e); } }); });
            try{ el.classList.remove('show'); el.style.display = 'none'; backdrop.remove(); }catch(e){ console.error('Backdrop close error', e); }
        });
    }

    function handler(e){
        e && e.preventDefault();
        console.debug('[OperatorNoSkill] click handler invoked');
        try{
            const el = document.getElementById('operatorNoSkillModal');
            if(!el){ console.error('[OperatorNoSkill] modal not found in DOM'); if(window.Toast) window.Toast.warning('Modal not available','Operator No-skill modal is not present on this page'); return; }
            console.debug('[OperatorNoSkill] bootstrap=', !!(window.bootstrap && window.bootstrap.Modal));
            if (window.bootstrap && typeof window.bootstrap.Modal === 'function') {
                try {
                    const inst = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el);
                    inst.show();
                    // if bootstrap didn't actually show the modal (race/issue), fallback after short delay
                    setTimeout(()=>{
                        if (!el.classList.contains('show')){
                            console.warn('[OperatorNoSkill] bootstrap modal did not become visible — using fallback');
                            openModalFallback(el);
                        } else {
                            if (window.Toast) try{ window.Toast.info('Modal','Operator No-skill opened'); } catch(e){}
                        }
                    }, 80);
                    return;
                } catch(e) {
                    console.error('[OperatorNoSkill] bootstrap modal show failed', e);
                }
            }
            openModalFallback(el);
        }catch(err){
            console.error('[OperatorNoSkill] Error opening modal', err);
            document.querySelectorAll('.modal-backdrop').forEach(b=>b.remove());
        }
    }

    function setup(){
        const btn = document.getElementById('operatorNoSkillBtn');
        console.debug('[OperatorNoSkill] setup — btn found=', !!btn);
        if(!btn) return;
        // hide the button when the modal markup is not present on the page (prevents toast/error)
        const modalEl = document.getElementById('operatorNoSkillModal');
        if (!modalEl) {
            console.warn('[OperatorNoSkill] operatorNoSkillModal not found — hiding button');
            btn.style.display = 'none';
            btn.setAttribute('aria-hidden', 'true');
            return;
        }
        btn.removeEventListener('click', handler);
        btn.addEventListener('click', handler);
    }

    if (document.readyState === 'loading'){
        document.addEventListener('DOMContentLoaded', setup);
    } else {
        setup();
    }
})();
function setSkillPreset(days){
    const startEl = document.getElementById('skillStart');
    const endEl = document.getElementById('skillEnd');
    if (!startEl || !endEl) return;
    const today = new Date();
    function fmt(d){
        const y = d.getFullYear();
        const m = String(d.getMonth()+1).padStart(2,'0');
        const dd = String(d.getDate()).padStart(2,'0');
        return `${y}-${m}-${dd}`;
    }
    if (!days || days <= 0){ startEl.value = ''; endEl.value = ''; return; }
    const start = new Date(); start.setDate(today.getDate() - (days - 1));
    startEl.value = fmt(start);
    endEl.value = fmt(today);
}

// toggle active preset button for every preset container and invoke corresponding preset handler
;(function(){
    const containers = document.querySelectorAll('.dq-presets');
    if(!containers || containers.length === 0) return;

    containers.forEach(container => {
        container.addEventListener('click', function(e){
            const btn = e.target.closest('button');
            if(!btn) return;

            // clear active within this container only
            container.querySelectorAll('button').forEach(b=>b.classList.remove('active'));
            btn.classList.add('active');

            // determine days and target modal to call the right preset function
            const days = parseInt(btn.getAttribute('data-days') || '0', 10);
            const modal = btn.closest('.modal');
            if(modal){
                switch(modal.id){
                    case 'skillInventoryModal': if(typeof setSkillPreset === 'function') setSkillPreset(days); break;
                    case 'expiryModal': if(typeof setExpiryPreset === 'function') setExpiryPreset(days); break;
                    case 'operatorNoSkillModal': if(typeof setOnsPreset === 'function') setOnsPreset(days); break;
                    default:
                        // try generic handlers defined on some modals
                        if(typeof setPresetModal === 'function') setPresetModal(days);
                        else if(typeof setPreset === 'function') setPreset(days);
                        break;
                }
            } else {
                // fallback: attempt to call function named in onclick attribute (safer than eval)
                const onclick = btn.getAttribute('onclick');
                if(onclick){
                    try{ new Function(onclick)(); }catch(err){ console.error('preset onclick failed', err); }
                }
            }
        });
    });
})();

// Skill Inventory modal behavior (preview + download)
(function(){
    const previewBtn = document.getElementById('previewSkillBtn');
    const downloadBtn = document.getElementById('downloadSkillBtn');
    const selectEl = document.getElementById('skillSectionSelect');
    const allDeptEl = document.getElementById('skillAllDepartments');
    const badge = document.getElementById('skillCountBadge');
    const loading = document.getElementById('skillLoading');
    const formatEl = document.getElementById('skillFormat');

    if (!previewBtn) return;

    function setBadge(count){
        badge.style.background=''; badge.style.color='';
        if(count === null){ badge.textContent='err'; badge.style.background='#ef4444'; badge.style.color='#fff'; return; }
        badge.textContent = String(count);
        if(count <= 0){ badge.style.background='#ef4444'; badge.style.color='#fff'; }
        else if(count <= 10){ badge.style.background='#f59e0b'; badge.style.color='#111827'; }
        else { badge.style.background='#10b981'; badge.style.color='#fff'; }
    }

    async function preview(){
        const section = selectEl.value;
        const allDept = allDeptEl?.checked;
        if (!section && !allDept) { if(window.Toast) window.Toast.warning('No Selection','Please select a section or choose All Departments to preview'); return; }
        const start = document.getElementById('skillStart')?.value;
        const end = document.getElementById('skillEnd')?.value;
        badge.textContent = '…'; loading.style.display = 'inline'; previewBtn.disabled = true;
        try{
            let url = '/api/download/skillinventory/count?';
            if (!allDept) url += 'section=' + encodeURIComponent(section);
            if (start && end) url += (url.endsWith('?') ? '' : '&') + 'start=' + encodeURIComponent(start) + '&end=' + encodeURIComponent(end);
            const res = await fetch(url);
            if (!res.ok) throw new Error('Server returned ' + res.status);
            const ct = (res.headers.get('content-type') || '').toLowerCase();
            if (!ct.includes('application/json')) {
                const txt = await res.text();
                console.error('[Preview] expected JSON but got', ct, txt.slice(0,200));
                throw new Error('Invalid server response (not JSON)');
            }
            const j = await res.json();
            const cnt = j.count ?? 0;
            setBadge(cnt);
            downloadBtn.classList.remove('dl-pending');
            downloadBtn.disabled = false;
            if (window.Toast) window.Toast.info('Preview complete', 'Found ' + cnt + ' records');
            return true;
        }catch(err){
            console.error('Preview error', err);
            setBadge(null);
            downloadBtn.classList.add('dl-pending');
            if (window.Toast) window.Toast.error('Preview failed', err.message || 'Check console');
            return false;
        } finally {
            loading.style.display = 'none';
            previewBtn.disabled = false;
        }
    }

    async function download(){
        const section = selectEl.value;
        const allDept = allDeptEl?.checked;
        if (!section && !allDept) { if(window.Toast) window.Toast.warning('No Selection','Please select a section or choose All Departments before downloading'); return; }
        if (downloadBtn.classList.contains('dl-pending')) { const ok = await preview(); if (!ok || downloadBtn.classList.contains('dl-pending')) return; }
        if (window.showLoading) window.showLoading('Generating file...');
        if (window.Toast) window.Toast.success('Download Started','Your file is being generated...');
        const start = document.getElementById('skillStart')?.value;
        const end = document.getElementById('skillEnd')?.value;
        const fmt = formatEl?.value || 'xlsx';
        let url = '/Download/SkillInventory?';
        if (!allDept) url += 'section=' + encodeURIComponent(section);
        if (start && end) url += (url.endsWith('?') ? '' : '&') + 'start=' + encodeURIComponent(start) + '&end=' + encodeURIComponent(end);
        if (fmt) url += (url.endsWith('?') ? '' : '&') + 'format=' + encodeURIComponent(fmt);
        window.location.href = url;
    }

    previewBtn.addEventListener('click', function(e){ e.preventDefault(); preview(); });
    downloadBtn.addEventListener('click', function(e){ e.preventDefault(); download(); });

    // Checkbox (All Departments) uses native change event — reliable
    if(allDeptEl) allDeptEl.addEventListener('change', function(){
        if(this.checked){ selectEl.value = ''; selectEl.disabled = true; preview(); }
        else { selectEl.disabled = false; badge.textContent='—'; downloadBtn.classList.add('dl-pending'); }
    });
    // Polling: detect fancy-select section changes
    let _skp = '', _skt = null;
    const _skEl = document.getElementById('skillInventoryModal');
    if (_skEl) {
        _skEl.addEventListener('shown.bs.modal', function() {
            _skp = selectEl.value;
            if (_skp || (allDeptEl && allDeptEl.checked)) preview();
            _skt = setInterval(function() {
                if (previewBtn.disabled) return;
                if (!_skEl.classList.contains('show')) { clearInterval(_skt); _skt = null; return; }
                const sv = selectEl.value;
                if (sv !== _skp) {
                    _skp = sv;
                    if(allDeptEl) allDeptEl.checked = false;
                    selectEl.disabled = false;
                    if (sv) preview();
                    else { badge.textContent='—'; downloadBtn.classList.add('dl-pending'); }
                }
            }, 250);
        });
        _skEl.addEventListener('hidden.bs.modal', function() { if (_skt) { clearInterval(_skt); _skt = null; } });
    }
})();

// preset helper used by skill preset buttons
function setSkillPreset(days){
    const startEl = document.getElementById('skillStart');
    const endEl = document.getElementById('skillEnd');
    if (!startEl || !endEl) return;
    const today = new Date();
    function fmt(d){
        const y = d.getFullYear();
        const m = String(d.getMonth()+1).padStart(2,'0');
        const dd = String(d.getDate()).padStart(2,'0');
        return `${y}-${m}-${dd}`;
    }
    if (!days || days <= 0){ startEl.value = ''; endEl.value = ''; return; }
    const end = today;
    const start = new Date(); start.setDate(today.getDate() - (days-1));
    startEl.value = fmt(start);
    endEl.value = fmt(end);
}

