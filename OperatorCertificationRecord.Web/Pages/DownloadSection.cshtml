@page
@model OperatorCertificationRecord.Web.Pages.DownloadSectionModel
@{
    ViewData["Title"] = "Download Reports";
    ViewData["ActivePage"] = "DownloadSection";
}

<style>
/* ── Hero ── */
.dl-hero {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border-radius: 20px; padding: 2rem 2rem 1.75rem;
    margin-bottom: 1.75rem; position: relative; overflow: hidden;
}
.dl-hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse at 85% 0%, rgba(124,58,237,.28) 0%, transparent 55%),
                radial-gradient(ellipse at 15% 100%, rgba(29,78,216,.20) 0%, transparent 50%);
}
.dl-hero-inner { position: relative; z-index: 1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem; }
.dl-hero-badge {
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.15);
    border-radius: 999px; padding: 0.28rem 0.85rem;
    font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: #94a3b8;
    margin-bottom: 0.6rem;
}
.dl-hero-title { font-size: 2.2rem; font-weight: 800; color: #f1f5f9; margin: 0 0 0.35rem; line-height: 1.2; }
.dl-hero-sub   { font-size: 1.05rem; color: #94a3b8; margin: 0; max-width: 520px; }
.dl-hero-chips { display: flex; flex-wrap: wrap; gap: 0.55rem; }
.dl-hero-chip  {
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12);
    border-radius: 10px; padding: 0.42rem 0.85rem;
    font-size: 0.95rem; font-weight: 600; color: #cbd5e1;
}
.dl-hero-chip i { font-size: 1.05rem; }

/* ── Category label ── */
.dl-cat-label {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em;
    color: #94a3b8; margin: 0 0 0.9rem;
}
.dl-cat-label::after {
    content: ''; flex: 1; height: 1px; background: #e2e8f0; margin-left: 0.4rem;
}

/* ── Card grid ── */
.dl-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
    gap: 1.1rem;
    margin-bottom: 1.75rem;
}
.dl-card {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.8rem;
    background: #fff; border: 1.5px solid #e2e8f0;
    border-radius: 18px; padding: 1.8rem 1rem 1.5rem;
    text-align: center; cursor: pointer; width: 100%;
    transition: transform .15s, box-shadow .18s, border-color .15s;
    box-shadow: 0 1px 4px rgba(0,0,0,.05);
}
.dl-card:hover, .dl-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 12px 36px rgba(0,0,0,.12);
    outline: none;
}
.dl-card:active { transform: translateY(-1px) scale(.99); }
.dl-card-strip {
    position: absolute; top: 0; left: 0; right: 0; height: 4px; border-radius: 18px 18px 0 0;
}
.dl-card-icon {
    width: 80px; height: 80px; border-radius: 20px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 2.6rem;
    transition: transform .15s;
}
.dl-card:hover .dl-card-icon { transform: scale(1.1); }
.dl-card-title { font-size: 1.15rem; font-weight: 700; color: #0f172a; margin: 0; line-height: 1.3; }

/* dq-download + modal-close-btn retained */
.dq-download {
    display:inline-flex; align-items:center; gap:0.5rem;
    background: linear-gradient(180deg,var(--accent) 0%, #f6c46b 100%);
    color: var(--white); padding: 0.8rem 1.3rem;
    border-radius: 0.6rem; border: none;
    box-shadow: 0 6px 18px rgba(16,185,129,0.12);
    transition: transform .12s ease, box-shadow .12s ease, opacity .12s ease;
    cursor: pointer; font-weight: 700; font-size: 1.1rem;
    min-width:130px; justify-content:center;
}
.dq-download:hover, .dq-download:focus { transform: translateY(-2px); box-shadow: 0 14px 36px rgba(16,185,129,0.18); }
.dq-download:active { transform: translateY(0) scale(.99); }
.dq-download[disabled], .dq-download[disabled]:hover { opacity: 0.55; cursor: not-allowed; transform: none; box-shadow: none; }
.modal-close-btn { background: transparent; border: 1px solid var(--gray-300); color: var(--gray-700); padding: 0.6rem 1rem; border-radius: 0.5rem; font-weight:600; transition: all .12s ease; }
.modal-close-btn:hover { background: var(--gray-50); border-color: var(--gray-400); color: var(--gray-900); transform: translateY(-1px); }
.modal-close-btn[disabled] { opacity:.6; cursor:not-allowed }

/* Date range validation */
@@keyframes dm-fadein { from { opacity:0; transform:translateY(-3px); } to { opacity:1; transform:translateY(0); } }
.dm-date-err { display:none; font-size:0.85rem; color:#ef4444; margin-top:0.35rem; font-weight:500; }
.dm-date-err.visible { display:block; animation: dm-fadein 0.2s ease; }
.dm-input.dm-invalid { border-color:#ef4444 !important; box-shadow:0 0 0 3px rgba(239,68,68,0.15) !important; }

@@media (max-width: 640px) {
    .dl-card-grid { grid-template-columns: 1fr; }
    .dl-hero-title { font-size: 1.7rem; }
}
</style>

