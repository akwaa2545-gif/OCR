<div class="modal fade" id="sectionDlModal" tabindex="-1" aria-labelledby="sectionDlModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content dm-modal-content" style="--dm-color:#7c3aed;--dm-light:#fdf4ff;">
      <div class="dm-header">
        <div class="dm-hdr-icon"><i class="bi bi-building-fill"></i></div>
        <div class="dm-hdr-text">
          <div class="dm-hdr-title" id="sectionDlModalLabel">Section</div>
          <div class="dm-hdr-sub">Download records filtered by department &amp; section</div>
        </div>
        <button type="button" class="dm-close" data-bs-dismiss="modal" aria-label="Close"><i class="bi bi-x-lg"></i></button>
      </div>
      <div class="dm-body">
        <div class="dm-section-lbl"><i class="bi bi-funnel-fill"></i> Filter</div>
        <div class="dm-grid-2">
          <div class="dm-field">
            <label class="dm-label" for="secDlDeptModal">Department</label>
            <select id="secDlDeptModal" class="dm-input"><option value="">— Any —</option></select>
          </div>
          <div class="dm-field">
            <label class="dm-label" for="secDlSectModal">Section</label>
            <select id="secDlSectModal" class="dm-input"><option value="">— Any —</option></select>
          </div>
        </div>
        <div class="dm-section-lbl" style="margin-top:1rem"><i class="bi bi-calendar3"></i> Date Range</div>
        <div class="dm-grid-2">
          <div class="dm-field">
            <label class="dm-label" for="secDlStartModal">Start Date</label>
            <input id="secDlStartModal" type="date" class="dm-input" />
          </div>
          <div class="dm-field">
            <label class="dm-label" for="secDlEndModal">End Date</label>
            <input id="secDlEndModal" type="date" class="dm-input" />
          </div>
        </div>
        <div class="dm-pill-row secDl-preset-btns">
          <button type="button" class="dm-pill" data-days="7"  onclick="setSecDlPreset(7)">7 days</button>
          <button type="button" class="dm-pill" data-days="30" onclick="setSecDlPreset(30)">30 days</button>
          <button type="button" class="dm-pill" data-days="365" onclick="setSecDlPreset(365)">1 year</button>
          <button type="button" class="dm-pill active" data-days="0" onclick="setSecDlPreset(0)">All time</button>
        </div>
        <div class="dm-summary">
          <div class="dm-field dm-format-field">
            <label class="dm-label">Format</label>
            <select id="secDlFormatModal" class="dm-input">
              <option value="xlsx">Excel (.xlsx)</option>
              <option value="csv">CSV (.csv)</option>
            </select>
          </div>
          <button id="secDlPreviewBtn" type="button" class="dm-preview-btn">
            <i class="bi bi-search"></i> Preview
          </button>
          <div class="dm-count-wrap">
            <div class="dm-count-lbl">Records</div>
            <div id="secDlCountBadge" class="dm-count-badge">—</div>
            <div id="secDlLoading" style="display:none" class="dm-loading"><i class="bi bi-hourglass-split"></i></div>
          </div>
        </div>
      </div>
      <div class="dm-footer">
        <button type="button" class="dm-btn-cancel" data-bs-dismiss="modal">Cancel</button>
        <button id="secDlDownloadBtn" type="button" class="dm-btn-dl dl-pending">
          <i class="bi bi-download"></i> Download
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  const previewBtn  = document.getElementById('secDlPreviewBtn');
  const downloadBtn = document.getElementById('secDlDownloadBtn');
  const badge       = document.getElementById('secDlCountBadge');
  const loading     = document.getElementById('secDlLoading');
  const startEl     = document.getElementById('secDlStartModal');
  const endEl       = document.getElementById('secDlEndModal');
  const deptEl      = document.getElementById('secDlDeptModal');
  const sectEl      = document.getElementById('secDlSectModal');

  if (!previewBtn) return;

  function toInputDate(d){ return d.toISOString().slice(0,10); }
  function setActive(days){ document.querySelectorAll('.secDl-preset-btns button').forEach(b => b.classList.toggle('active', b.getAttribute('data-days') == String(days))); }

  window.setSecDlPreset = function(days){
    if (days === 0){ startEl.value = ''; endEl.value = ''; }
    else { const e = new Date(); const s = new Date(); s.setDate(e.getDate() - (days-1)); startEl.value = toInputDate(s); endEl.value = toInputDate(e); }
    setActive(days);
    scheduleAutoPreview();
  };
  setActive(0);

  let previewDone = false, timer = null;
  function scheduleAutoPreview(){ if(timer) clearTimeout(timer); timer = setTimeout(() => preview(), 600); }

  function setBadge(count){
    badge.style.removeProperty('background'); badge.style.removeProperty('color');
    if (count === null){ badge.style.background='#ef4444'; badge.style.color='#fff'; badge.textContent='Err'; return; }
    badge.textContent = String(count);
    if(count <= 0){ badge.style.background='#ef4444'; badge.style.color='#fff'; }
    else if(count <= 10){ badge.style.background='#f59e0b'; badge.style.color='#111827'; }
    else { badge.style.background='#10b981'; badge.style.color='#fff'; }
  }

  function escapeHtml(s){ return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":"&#39;"}[c])); }

  async function preview(){
    const dept = deptEl.value;
    const sect = sectEl.value;
    if (!dept && !sect){
      if(window.Toast) window.Toast.warning('No Selection','Please select a department or section');
      return;
    }
    badge.textContent = '…'; loading.style.display = 'inline'; previewBtn.disabled = true;
    try{
      const params = [];
      if (dept) params.push('department=' + encodeURIComponent(dept));
      else if (sect) params.push('section=' + encodeURIComponent(sect));
      if (startEl.value && endEl.value){ params.push('start=' + encodeURIComponent(startEl.value)); params.push('end=' + encodeURIComponent(endEl.value)); }
      const res = await fetch('/api/download/section/count?' + params.join('&'));
      if (!res.ok) throw new Error('Server ' + res.status);
      const ct = (res.headers.get('content-type') || '').toLowerCase();
      if (!ct.includes('application/json')) throw new Error('Invalid server response');
      const j = await res.json();
      const cnt = j.count ?? 0;
      setBadge(cnt);
      previewDone = true;
      downloadBtn.classList.remove('dl-pending');
      if(window.Toast) window.Toast.info('Preview complete', 'Found ' + cnt + ' records');
      return true;
    }catch(err){
      console.error('[Section] Preview error', err);
      setBadge(null);
      previewDone = false;
      downloadBtn.classList.add('dl-pending');
      if(window.Toast) window.Toast.error('Preview failed', err.message || '');
      return false;
    }finally{
      loading.style.display = 'none';
      previewBtn.disabled = false;
    }
  }

  async function download(){
    if (downloadBtn.classList.contains('dl-pending')){ const ok = await preview(); if (!ok || downloadBtn.classList.contains('dl-pending')) return; }
    const dept = deptEl.value;
    const sect = sectEl.value;
    if (!dept && !sect){ if(window.Toast) window.Toast.warning('No Selection','Please select a department or section'); return; }
    const fmt = encodeURIComponent((document.getElementById('secDlFormatModal')?.value) || 'xlsx');
    const params = [];
    if (dept) params.push('department=' + encodeURIComponent(dept));
    else if (sect) params.push('section=' + encodeURIComponent(sect));
    if (startEl.value && endEl.value){ params.push('start=' + encodeURIComponent(startEl.value)); params.push('end=' + encodeURIComponent(endEl.value)); }
    params.push('format=' + fmt);
    window.location.href = '/Download/Section?' + params.join('&');
  }

  previewBtn.addEventListener('click',  function(e){ e.preventDefault(); preview(); });
  downloadBtn.addEventListener('click', function(e){ e.preventDefault(); download(); });
  startEl.addEventListener('input', scheduleAutoPreview);
  endEl.addEventListener('input',   scheduleAutoPreview);
  deptEl.addEventListener('change', function(){ if(this.value){ sectEl.value=''; } scheduleAutoPreview(); });
  sectEl.addEventListener('change', function(){ if(this.value){ deptEl.value=''; } scheduleAutoPreview(); });

  document.getElementById('sectionDlModal').addEventListener('shown.bs.modal', async function(){
    badge.textContent = '—'; downloadBtn.classList.add('dl-pending'); previewDone = false;
    try{
      const res = await fetch('/api/download/meta/disqualified');
      if (!res.ok) return;
      const ct = (res.headers.get('content-type') || '').toLowerCase();
      if (!ct.includes('application/json')) return;
      const j = await res.json();
      if (Array.isArray(j.departments)){
        deptEl.innerHTML = '<option value="">— Any —</option>' +
          j.departments.map(d => `<option value="${escapeHtml(d)}">${escapeHtml(d)}</option>`).join('');
      }
      if (Array.isArray(j.sections)){
        sectEl.innerHTML = '<option value="">— Any —</option>' +
          j.sections.map(s => `<option value="${escapeHtml(s)}">${escapeHtml(s)}</option>`).join('');
      }
    }catch(err){
      console.error('[Section] Failed to load depts/sections', err);
    }
  });
})();
</script>
