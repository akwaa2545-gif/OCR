    <!-- App Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="/js/fancy-select.js"></script>
    <script src="~/lib/flatpickr/flatpickr.min.js" asp-append-version="true"></script>
    <script src="~/lib/flatpickr/th.js" asp-append-version="true"></script>
    <script src="~/js/global-date-picker.js" asp-append-version="true"></script>
    <script>
        // Global helper: escape HTML for safe insertion into option lists
        window.escapeHtml = window.escapeHtml || function(s){ return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":"&#39;"}[c]; }); };

        // Start each page with the sidebar collapsed; opening applies to this page only.
        (function(){
            const container = document.querySelector('.app-container');
            const btn = document.getElementById('toggleSidebarBtn');
            let mobileOverlay = null;

            function isMobile() { return window.innerWidth <= 900; }

            function applyState(collapsed) {
                if(!container) return;
                if (btn) btn.setAttribute('aria-expanded', String(!collapsed));
                if (collapsed) {
                    container.classList.add('sidebar-collapsed');
                    btn && btn.classList.add('collapsed');
                    setBtnIconCollapsed(true);
                } else {
                    container.classList.remove('sidebar-collapsed');
                    btn && btn.classList.remove('collapsed');
                    setBtnIconCollapsed(false);
                }
            }

            function setBtnIconCollapsed(collapsed){
                if (!btn) return;
                const ic = btn.querySelector('i');
                if (!ic) return;
                // Use chevron for desktop toggle and rotate via .collapsed class
                ic.className = 'bi bi-chevron-left';
                if (collapsed) btn.classList.add('collapsed'); else btn.classList.remove('collapsed');
            }

            function openMobile(){
                if(!container) return;
                container.classList.add('sidebar-open');
                // overlay
                mobileOverlay = document.createElement('div');
                mobileOverlay.className = 'sidebar-overlay';
                document.body.appendChild(mobileOverlay);
                // allow fade
                requestAnimationFrame(()=> mobileOverlay.classList.add('visible'));
                mobileOverlay.addEventListener('click', closeMobile);
                document.body.style.overflow = 'hidden';
                // show close icon on mobile
                if (btn) {
                    btn.setAttribute('aria-expanded', 'true');
                    const ic = btn.querySelector('i');
                    if (ic) ic.className = 'bi bi-x';
                }
            }

            
            function closeMobile(){
                if(!container) return;
                container.classList.remove('sidebar-open');
                if (mobileOverlay) {
                    mobileOverlay.classList.remove('visible');
                    setTimeout(()=>{ mobileOverlay && mobileOverlay.remove(); mobileOverlay = null; }, 200);
                }
                document.body.style.overflow = '';
                // restore button icon to collapsed/expanded desktop state
                applyState(container.classList.contains('sidebar-collapsed'));
                if (btn && isMobile()) btn.setAttribute('aria-expanded', 'false');
            }

            applyState(true);
            window.addEventListener('pageshow', function(){ closeMobile(); applyState(true); });

            if (btn) {
                btn.addEventListener('click', function(){
                    if (isMobile()) {
                        // mobile toggles overlay slide-in
                        if (container.classList.contains('sidebar-open')) closeMobile();
                        else openMobile();
                        return;
                    }

                    const collapsed = container.classList.toggle('sidebar-collapsed');
                    applyState(collapsed);
                });
            }

            // Close mobile sidebar when resizing to desktop
            window.addEventListener('resize', function(){
                if (!isMobile()) {
                    closeMobile();
                }
            });
        })();

        // Update datetime in header
        function updateDateTime() {
            const now = new Date();
            const formatted = now.toLocaleDateString('en-US', { 
                month: 'short', 
                day: 'numeric', 
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
            const el = document.getElementById('currentDateTime');
            if (el) el.textContent = formatted;
        }
        updateDateTime();
        setInterval(updateDateTime, 60000);
    </script>
    
    @* Global modals included here so buttons across pages can open them without missing DOM errors *@
    @if (ViewData["HasOperatorNoSkillModal"] is not true)
    {
        @await Html.PartialAsync("Shared/_OperatorNoSkillDownloadModal")
    }
    @await RenderSectionAsync("Scripts", required: false)

    <script>
    /* ===== Animation system ===== */
    (function(){
        var bar = document.getElementById('page-progress-bar');

        /* Progress bar helpers */
        var _pTimer = null;
        var _pFrame = null;
        var _pDoneTimer = null;
        var _pHideTimer = null;
        function cancelProgress(){
            clearTimeout(_pTimer);
            clearTimeout(_pDoneTimer);
            clearTimeout(_pHideTimer);
            cancelAnimationFrame(_pFrame);
            _pTimer = _pFrame = _pDoneTimer = _pHideTimer = null;
        }
        function pbStart(){
            cancelProgress();
            if (!bar) return;
            bar.style.transition = 'width 0.25s ease';
            bar.style.opacity = '1';
            bar.classList.remove('complete');
            bar.style.width = '0%';
            _pFrame = requestAnimationFrame(function(){
                _pFrame = requestAnimationFrame(function(){
                    _pFrame = null;
                    bar.style.width = '70%';
                });
            });
            _pTimer = setTimeout(function(){ bar.style.width = '90%'; }, 500);
        }
        function pbDone(){
            cancelProgress();
            if (!bar) return;
            bar.style.transition = 'none';
            bar.style.width = '100%';
            bar.style.opacity = '1';
            _pDoneTimer = setTimeout(function(){
                bar.style.transition = 'opacity 0.3s ease';
                bar.style.opacity = '0';
                _pHideTimer = setTimeout(function(){ bar.style.width = '0%'; }, 300);
            }, 150);
        }

        /* Page-enter: complete bar */
        pbStart();
        window.addEventListener('DOMContentLoaded', function(){ pbDone(); });
        // History restoration can retain the outgoing page's animation state.
        window.addEventListener('pageshow', function(){
            document.body.classList.remove('page-leaving');
            pbDone();
        });

        /* Page-leave: animate out then navigate */
        document.addEventListener('click', function(e){
            var anchor = e.target.closest('a[href]');
            if (!anchor) return;
            var href = anchor.getAttribute('href');
            /* skip hash links, external, download, mailto, js: */
            if (!href || href.startsWith('#') || href.startsWith('javascript') || href.startsWith('mailto') || href.startsWith('http') || anchor.hasAttribute('download') || anchor.target === '_blank') return;
            /* skip api calls */
            if (href.startsWith('/api/') || href.startsWith('?handler=')) return;
            e.preventDefault();
            pbStart();
            var body = document.body;
            body.classList.add('page-leaving');
            setTimeout(function(){ window.location.href = href; }, 160);
        });
        /* Popup placement is established before opening by modal-layer.js. */

        /* Sidebar ripple effect */
        document.querySelectorAll('.sidebar-link').forEach(function(link){
            link.addEventListener('click', function(e){
                var r = document.createElement('span');
                r.className = 'sidebar-link-ripple';
                var rect = link.getBoundingClientRect();
                var size = Math.max(rect.width, rect.height);
                r.style.cssText = 'width:'+size+'px;height:'+size+'px;left:'+(e.clientX-rect.left-size/2)+'px;top:'+(e.clientY-rect.top-size/2)+'px';
                link.appendChild(r);
                setTimeout(function(){ r.remove(); }, 520);
            });
        });

        /* Date-card icon button → open native date picker */
        document.addEventListener('click', function(e){
            var btn = e.target.closest('.date-icon');
            if (!btn) return;
            e.preventDefault();
            var card = btn.closest('.date-card');
            if (!card) return;
            var inp = card.querySelector('.date-input');
            if (!inp) return;
            if (window.AppDatePicker) { window.AppDatePicker.open(inp); return; }
            try { inp.showPicker(); } catch(err) { inp.focus(); inp.click(); }
        });

        /* Card stagger entrance via IntersectionObserver */
        var cards = document.querySelectorAll('.card, .emp-profile-card, .upd-profile-card');
        if ('IntersectionObserver' in window && cards.length){
            cards.forEach(function(c, i){
                c.classList.add('anim-card-enter');
                c.style.transitionDelay = Math.min(i * 0.07, 0.4) + 's';
            });
            var io = new IntersectionObserver(function(entries){
                entries.forEach(function(entry){
                    if (entry.isIntersecting){
                        entry.target.classList.add('visible');
                        io.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.08 });
            cards.forEach(function(c){ io.observe(c); });
        }
    })();
    </script>
</body>
</html>
