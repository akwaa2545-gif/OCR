    }
    .dm-preview-btn:hover {
        background: var(--dm-color,#f97316); color: #fff;
        box-shadow: 0 5px 18px color-mix(in srgb, var(--dm-color,#f97316) 38%, transparent);
        transform: translateY(-1px);
    }
    .dm-count-wrap { margin-left: auto; display: flex; flex-direction: column; align-items: flex-end; }
    .dm-count-lbl  { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #94a3b8; margin-bottom: 0.25rem; }
    .dm-count-badge {
        font-weight: 800; font-size: 1.45rem; line-height: 1;
        padding: 0.35rem 1rem; border-radius: 10px; min-width: 76px; text-align: center;
        background: #e2e8f0; color: #64748b; transition: background .2s, color .2s;
    }
    .dm-loading { font-size: 0.85rem; color: #94a3b8; }
    .dm-footer {
        display: flex; align-items: center; justify-content: flex-end; gap: 0.65rem;
        padding: 1rem 1.6rem; border-top: 1px solid #f1f5f9;
