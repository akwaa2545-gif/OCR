    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/app.js"></script>
    <script src="/js/fancy-select.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
    <script>
    // ===== Flatpickr — enhance all input[type="date"] globally =====
    (function () {
        if (typeof flatpickr === 'undefined') return;
        var proto = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value');
        var GREGORIAN_WEEKDAYS = {
            shorthand: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
            longhand: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
        };
        var GREGORIAN_MONTHS = {
            shorthand: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
            longhand: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
        };

        function enhance(el) {
            if (el._fpInit) return;
            if (el.hasAttribute('data-no-flatpickr')) return;
            if ((el.getAttribute('type') || '').toLowerCase() !== 'date') return;
            el._fpInit = true;

            var fp = flatpickr(el, {
                dateFormat: 'Y-m-d',
                altInput: true,
                altFormat: 'j M Y',
                allowInput: true,
                disableMobile: true,
                monthSelectorType: 'static',
                weekNumbers: false,
                locale: {
                    firstDayOfWeek: 1,
                    weekdays: GREGORIAN_WEEKDAYS,
                    months: GREGORIAN_MONTHS
                },
                defaultDate: el.value || null,
                onChange: function(selectedDates, dateStr) {
                    // Keep original element's value in sync and fire native change/input events
                    // so existing onchange="" attributes and addEventListener('change') handlers fire.
                    proto.set.call(el, dateStr);
                    el.dispatchEvent(new Event('change', { bubbles: true }));
                    el.dispatchEvent(new Event('input',  { bubbles: true }));
                },
                onReady: function(_, __, instance) {
                    var cal = instance.calendarContainer;
                    var MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];

                    function makeHdr(title) {
                        var hdr = document.createElement('div'); hdr.className = 'fp-overlay-hdr';
                        var t = document.createElement('span'); t.className = 'fp-overlay-title'; t.textContent = title;
                        var x = document.createElement('button'); x.type = 'button'; x.className = 'fp-overlay-close'; x.innerHTML = '&#10005;';
                        hdr.appendChild(t); hdr.appendChild(x);
                        return hdr;
                    }

                    // ── Month overlay ─────────────────────────────────────────
                    var mOverlay = document.createElement('div');
                    mOverlay.className = 'fp-month-overlay';
                    document.body.appendChild(mOverlay);
                    var mHdr = makeHdr('Select Month');
                    mHdr.querySelector('.fp-overlay-close').addEventListener('mousedown', function(e){ e.preventDefault(); mOverlay.classList.remove('open'); });
                    mOverlay.appendChild(mHdr);
                    MONTHS.forEach(function(name, idx) {
                        var btn = document.createElement('button');
                        btn.type = 'button'; btn.className = 'fp-month-btn';
                        btn.textContent = name; btn.dataset.idx = idx;
                        btn.addEventListener('mousedown', function(e) {
                            e.preventDefault(); e.stopPropagation();
                            instance.changeMonth(idx, false);
                            mOverlay.classList.remove('open');
                        });
                        mOverlay.appendChild(btn);
                    });

                    // ── Year overlay ──────────────────────────────────────────
                    var yOverlay = document.createElement('div');
                    yOverlay.className = 'fp-year-overlay';
                    document.body.appendChild(yOverlay);
                    var yPageStart = instance.currentYear - 6;

                    function buildYearGrid() {
                        yOverlay.innerHTML = '';
                        var yHdr = makeHdr('Select Year');
                        yHdr.querySelector('.fp-overlay-close').addEventListener('mousedown', function(e){ e.preventDefault(); yOverlay.classList.remove('open'); });
                        yOverlay.appendChild(yHdr);
                        // pager nav
                        var nav = document.createElement('div'); nav.className = 'fp-year-nav';
                        var prev = document.createElement('button'); prev.type = 'button'; prev.className = 'fp-year-nav-btn'; prev.innerHTML = '&#8249;';
                        var lbl  = document.createElement('span');  lbl.className = 'fp-year-range-lbl';
                        lbl.textContent = yPageStart + '\u2013' + (yPageStart + 11);
                        var next = document.createElement('button'); next.type = 'button'; next.className = 'fp-year-nav-btn'; next.innerHTML = '&#8250;';
                        prev.addEventListener('mousedown', function(e){ e.preventDefault(); yPageStart -= 12; buildYearGrid(); });
                        next.addEventListener('mousedown', function(e){ e.preventDefault(); yPageStart += 12; buildYearGrid(); });
                        nav.appendChild(prev); nav.appendChild(lbl); nav.appendChild(next);
                        yOverlay.appendChild(nav);
                        for (var y = yPageStart; y < yPageStart + 12; y++) {
                            (function(yr){
                                var btn = document.createElement('button');
                                btn.type = 'button'; btn.className = 'fp-year-btn';
                                if (yr === instance.currentYear) btn.classList.add('active');
                                btn.textContent = yr;
                                btn.addEventListener('mousedown', function(e) {
                                    e.preventDefault(); e.stopPropagation();
                                    instance.changeMonth((yr - instance.currentYear) * 12, true);
                                    yOverlay.classList.remove('open');
                                });
                                yOverlay.appendChild(btn);
                            })(y);
                        }
                    }

                    // ── Month click (event delegation) ─────────────────────────
                    cal.addEventListener('click', function(e) {
                        if (!e.target.closest('.cur-month')) return;
                        e.stopPropagation();
                        var r = cal.getBoundingClientRect();
                        yOverlay.classList.remove('open');
                        mOverlay.querySelectorAll('.fp-month-btn').forEach(function(b) {
                            b.classList.toggle('active', parseInt(b.dataset.idx) === instance.currentMonth);
                        });
                        mOverlay.style.top = r.top + 'px'; mOverlay.style.left = r.left + 'px';
                        mOverlay.style.width = r.width + 'px'; mOverlay.style.height = r.height + 'px';
                        mOverlay.classList.toggle('open');
                    });

                    // ── Year click (direct listener on numInputWrapper) ─────────
                    var numWrapper = cal.querySelector('.numInputWrapper');
                    if (numWrapper) {
                        numWrapper.addEventListener('click', function(e) {
                            e.stopPropagation(); e.preventDefault();
                            var r = cal.getBoundingClientRect();
                            mOverlay.classList.remove('open');
                            yPageStart = instance.currentYear - 6;
                            buildYearGrid();
                            yOverlay.style.top = r.top + 'px'; yOverlay.style.left = r.left + 'px';
                            yOverlay.style.width = r.width + 'px'; yOverlay.style.height = r.height + 'px';
                            yOverlay.classList.toggle('open');
                        });
                    }

                    // Close on outside click
                    document.addEventListener('click', function(e) {
                        if (!mOverlay.contains(e.target) && !cal.contains(e.target)) mOverlay.classList.remove('open');
                        if (!yOverlay.contains(e.target) && !cal.contains(e.target)) yOverlay.classList.remove('open');
                    });
                },
            });

            // Copy original classes onto altInput so it inherits .dm-input / .ask-input / etc.
            if (fp && fp.altInput) {
                Array.from(el.classList)
                    .filter(function(c){ return c !== 'flatpickr-input'; })
                    .forEach(function(c){ fp.altInput.classList.add(c); });

                // Wrap altInput in a relative container and append a calendar icon
                var wrap = document.createElement('div');
                wrap.className = 'fp-date-wrap';
                fp.altInput.parentNode.insertBefore(wrap, fp.altInput);
                wrap.appendChild(fp.altInput);
                var icon = document.createElement('span');
                icon.className = 'fp-cal-icon';
                icon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>';
                wrap.appendChild(icon);
            }

            // Intercept programmatic el.value = '...' so altInput display stays in sync.
            // Guard _busy to prevent re-entrant calls when fp.setDate() writes back to el.value.
            var _busy = false;
            Object.defineProperty(el, 'value', {
                get: function() { return proto.get.call(el); },
                set: function(v) {
                    proto.set.call(el, v);
                    if (_busy || !fp) return;
                    _busy = true;
                    try { if (v) fp.setDate(v, false); else fp.clear(false); }
                    finally { _busy = false; }
                },
                configurable: true,
            });
        }

        // Enhance all date inputs already in the DOM
        document.querySelectorAll('input[type="date"]').forEach(enhance);

        // Enhance date inputs added later (e.g. dynamic modal content loaded via JS)
        new MutationObserver(function(muts) {
            muts.forEach(function(m) {
                m.addedNodes.forEach(function(node) {
                    if (node.nodeType !== 1) return;
                    if (node.matches && node.matches('input[type="date"]')) enhance(node);
                    if (node.querySelectorAll) node.querySelectorAll('input[type="date"]').forEach(enhance);
                });
            });
        }).observe(document.body, { childList: true, subtree: true });
    })();
    </script>
    <script>
        // Global helper: escape HTML for safe insertion into option lists
        window.escapeHtml = window.escapeHtml || function(s){ return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":"&#39;"}[c]; }); };

        // Sidebar toggle behavior with persistence
        (function(){
            const container = document.querySelector('.app-container');
            const btn = document.getElementById('toggleSidebarBtn');
            const STORAGE_KEY = 'ocr_sidebar_collapsed';
            let mobileOverlay = null;

            function isMobile() { return window.innerWidth <= 900; }

            function applyState(collapsed) {
                if(!container) return;
                if (collapsed) {
                    container.classList.add('sidebar-collapsed');
                    btn && btn.classList.add('collapsed');
                    setBtnIconCollapsed(true);
                } else {
                    container.classList.remove('sidebar-collapsed');
                    btn && btn.classList.remove('collapsed');
                    setBtnIconCollapsed(false);
                }
            }

            function setBtnIconCollapsed(collapsed){
                if (!btn) return;
                const ic = btn.querySelector('i');
                if (!ic) return;
                // Use chevron for desktop toggle and rotate via .collapsed class
                ic.className = 'bi bi-chevron-left';
                if (collapsed) btn.classList.add('collapsed'); else btn.classList.remove('collapsed');
            }

            function openMobile(){
                if(!container) return;
                container.classList.add('sidebar-open');
                // overlay
                mobileOverlay = document.createElement('div');
                mobileOverlay.className = 'sidebar-overlay';
                document.body.appendChild(mobileOverlay);
                // allow fade
                requestAnimationFrame(()=> mobileOverlay.classList.add('visible'));
                mobileOverlay.addEventListener('click', closeMobile);
                document.body.style.overflow = 'hidden';
                // show close icon on mobile
                if (btn) {
                    const ic = btn.querySelector('i');
                    if (ic) ic.className = 'bi bi-x';
                }
            }

            
            function closeMobile(){
                if(!container) return;
                container.classList.remove('sidebar-open');
                if (mobileOverlay) {
                    mobileOverlay.classList.remove('visible');
                    setTimeout(()=>{ mobileOverlay && mobileOverlay.remove(); mobileOverlay = null; }, 200);
                }
                document.body.style.overflow = '';
                // restore button icon to collapsed/expanded desktop state
                try{ const saved = localStorage.getItem(STORAGE_KEY); applyState(saved === '1'); }catch(e){}
            }

            // initialize from localStorage for desktop
            try{
                const saved = localStorage.getItem(STORAGE_KEY);
                if (!isMobile()) applyState(saved === '1');
                else setBtnIconCollapsed(true);
            }catch(e){}

            if (btn) {
                btn.addEventListener('click', function(){
                    if (isMobile()) {
                        // mobile toggles overlay slide-in
                        if (container.classList.contains('sidebar-open')) closeMobile();
                        else openMobile();
                        return;
                    }

                    const collapsed = container.classList.toggle('sidebar-collapsed');
                    try{ localStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0'); }catch(e){}
                    setBtnIconCollapsed(collapsed);
                });
            }

            // Close mobile sidebar when resizing to desktop
            window.addEventListener('resize', function(){
                if (!isMobile()) {
                    closeMobile();
                    try{ const saved = localStorage.getItem(STORAGE_KEY); applyState(saved === '1'); }catch(e){}
                }
            });
        })();

        // Update datetime in header
        function updateDateTime() {
            const now = new Date();
            const formatted = now.toLocaleDateString('en-US', { 
                month: 'short', 
                day: 'numeric', 
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
            const el = document.getElementById('currentDateTime');
            if (el) el.textContent = formatted;
        }
        updateDateTime();
        setInterval(updateDateTime, 60000);
    </script>
    
    @* Global modals included here so buttons across pages can open them without missing DOM errors *@
    @await Html.PartialAsync("Shared/_OperatorNoSkillDownloadModal")
    @await RenderSectionAsync("Scripts", required: false)

    <script>
    /* ===== Animation system ===== */
    (function(){
        var bar = document.getElementById('page-progress-bar');

        /* Progress bar helpers */
        var _pTimer = null;
        function pbStart(){
            if (!bar) return;
            bar.style.transition = 'width 0.25s ease';
            bar.style.opacity = '1';
            bar.classList.remove('complete');
            bar.style.width = '0%';
            requestAnimationFrame(function(){
                requestAnimationFrame(function(){
                    bar.style.width = '70%';
                });
            });
            _pTimer = setTimeout(function(){ bar.style.width = '90%'; }, 500);
        }
        function pbDone(){
            if (!bar) return;
            clearTimeout(_pTimer);
            bar.style.transition = 'none';
            bar.style.width = '100%';
            bar.style.opacity = '1';
            setTimeout(function(){
                bar.style.transition = 'opacity 0.3s ease';
                bar.style.opacity = '0';
                setTimeout(function(){ bar.style.width = '0%'; }, 300);
            }, 150);
        }

        /* Page-enter: complete bar */
        pbStart();
        window.addEventListener('DOMContentLoaded', function(){ pbDone(); });

        /* Page-leave: animate out then navigate */
        document.addEventListener('click', function(e){
            var anchor = e.target.closest('a[href]');
            if (!anchor) return;
            var href = anchor.getAttribute('href');
            /* skip hash links, external, download, mailto, js: */
            if (!href || href.startsWith('#') || href.startsWith('javascript') || href.startsWith('mailto') || href.startsWith('http') || anchor.hasAttribute('download') || anchor.target === '_blank') return;
            /* skip api calls */
            if (href.startsWith('/api/') || href.startsWith('?handler=')) return;
            e.preventDefault();
            pbStart();
            var body = document.body;
            body.classList.add('page-leaving');
            setTimeout(function(){ window.location.href = href; }, 160);
        });
        /* globally keep modals on top and in body */
        document.addEventListener('shown.bs.modal', function(e){
            try {
                var m = e.target;
                if (m && m.parentElement !== document.body) document.body.appendChild(m);
                if (m) m.style.zIndex = '10050';
                var bd = document.querySelector('.modal-backdrop');
                if (bd) bd.style.zIndex = '1040';
            } catch(err) { console.error('modal placement error', err); }
        });
        document.addEventListener('hidden.bs.modal', function(e){
            document.querySelectorAll('.modal-backdrop').forEach(b=>b.remove());
        });

        /* Sidebar ripple effect */
        document.querySelectorAll('.sidebar-link').forEach(function(link){
            link.addEventListener('click', function(e){
                var r = document.createElement('span');
                r.className = 'sidebar-link-ripple';
                var rect = link.getBoundingClientRect();
                var size = Math.max(rect.width, rect.height);
                r.style.cssText = 'width:'+size+'px;height:'+size+'px;left:'+(e.clientX-rect.left-size/2)+'px;top:'+(e.clientY-rect.top-size/2)+'px';
                link.appendChild(r);
                setTimeout(function(){ r.remove(); }, 520);
            });
        });

        /* Date-card icon button → open native date picker */
        document.addEventListener('click', function(e){
            var btn = e.target.closest('.date-icon');
            if (!btn) return;
            e.preventDefault();
            var card = btn.closest('.date-card');
            if (!card) return;
            var inp = card.querySelector('.date-input');
            if (!inp) return;
            try { inp.showPicker(); } catch(err) { inp.focus(); inp.click(); }
        });

        /* Card stagger entrance via IntersectionObserver */
        var cards = document.querySelectorAll('.card, .emp-profile-card, .upd-profile-card');
        if ('IntersectionObserver' in window && cards.length){
            cards.forEach(function(c, i){
                c.classList.add('anim-card-enter');
                c.style.transitionDelay = Math.min(i * 0.07, 0.4) + 's';
            });
            var io = new IntersectionObserver(function(entries){
                entries.forEach(function(entry){
                    if (entry.isIntersecting){
                        entry.target.classList.add('visible');
                        io.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.08 });
            cards.forEach(function(c){ io.observe(c); });
        }
    })();
    </script>
</body>
</html>
