    .dm-btn-cancel {
        padding: 0.6rem 1.25rem; border-radius: 10px; font-size: 0.93rem; font-weight: 600;
        color: #475569; background: #f1f5f9; border: 1.5px solid #e2e8f0;
        cursor: pointer; transition: all .12s;
    }
    .dm-btn-cancel:hover { background: #e2e8f0; color: #0f172a; }
    .dm-btn-dl {
        display: inline-flex; align-items: center; gap: 0.45rem;
        padding: 0.62rem 1.5rem; border-radius: 10px; font-size: 0.97rem; font-weight: 700;
        background: linear-gradient(135deg,#ea580c,#f97316); color: #fff; border: none;
        box-shadow: 0 4px 16px rgba(249,115,22,.30); cursor: pointer; transition: all .12s;
    }
    .dm-btn-dl:hover { box-shadow: 0 6px 24px rgba(249,115,22,.44); transform: translateY(-1px); color: #fff; }
    .dm-btn-dl[disabled] { opacity: .5; cursor: not-allowed; transform: none; box-shadow: none; }
    .dm-btn-dl.dl-pending { opacity: .5; cursor: default; transform: none; box-shadow: none; }
