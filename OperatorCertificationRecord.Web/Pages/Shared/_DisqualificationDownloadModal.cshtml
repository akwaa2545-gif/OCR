<div class="modal fade" id="disqualificationModal" tabindex="-1" aria-labelledby="disqualificationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content dm-modal-content" style="--dm-color:#dc2626;--dm-light:#fef2f2;">
      <div class="dm-header">
        <div class="dm-hdr-icon"><i class="bi bi-slash-circle-fill"></i></div>
        <div class="dm-hdr-text">
          <div class="dm-hdr-title" id="disqualificationModalLabel">Disqualification</div>
          <div class="dm-hdr-sub">Download operator disqualification records</div>
        </div>
        <button type="button" class="dm-close" data-bs-dismiss="modal" aria-label="Close"><i class="bi bi-x-lg"></i></button>
      </div>
      <div class="dm-body">
        <div class="dm-section-lbl"><i class="bi bi-funnel-fill"></i> Filter</div>
        <div class="dm-grid-2">
          <div class="dm-field">
            <label class="dm-label" for="dqDeptModal">Department</label>
            <select id="dqDeptModal" class="dm-input"><option value="">— Any —</option></select>
          </div>
          <div class="dm-field">
            <label class="dm-label" for="dqSectModal">Section</label>
            <select id="dqSectModal" class="dm-input"><option value="">— Any —</option></select>
          </div>
        </div>
        <div class="dm-section-lbl" style="margin-top:1rem"><i class="bi bi-calendar3"></i> Date Range</div>
        <div class="dm-grid-2">
          <div class="dm-field">
            <label class="dm-label" for="dqStartModal">Start Date</label>
            <input id="dqStartModal" type="date" class="dm-input" onchange="validateDateRange('dqStartModal','dqEndModal','dqDateErr','previewCountModal','downloadBtnModal')" />
          </div>
          <div class="dm-field">
            <label class="dm-label" for="dqEndModal">End Date</label>
            <input id="dqEndModal" type="date" class="dm-input" onchange="validateDateRange('dqStartModal','dqEndModal','dqDateErr','previewCountModal','downloadBtnModal')" />
          </div>
        </div>
        <span class="dm-date-err" id="dqDateErr"></span>
        <div class="dm-pill-row dq-preset-btns">
          <button type="button" class="dm-pill" data-days="7" onclick="setPresetModal(7)">7 days</button>
          <button type="button" class="dm-pill" data-days="30" onclick="setPresetModal(30)">30 days</button>
          <button type="button" class="dm-pill" data-days="365" onclick="setPresetModal(365)">1 year</button>
          <button type="button" class="dm-pill active" data-days="0" onclick="setPresetModal(0)">All time</button>
        </div>
        <div class="dm-summary">
          <div class="dm-field dm-format-field">
            <label class="dm-label">Format</label>
            <select id="dqFormatModal" class="dm-input">
              <option value="xlsx">Excel (.xlsx)</option>
              <option value="csv">CSV (.csv)</option>
            </select>
          </div>
          <button id="previewCountModal" type="button" class="dm-preview-btn">
            <i class="bi bi-search"></i> Preview
          </button>
          <div class="dm-count-wrap">
            <div class="dm-count-lbl">Records</div>
            <div id="dqCountBadgeModal" class="dm-count-badge">—</div>
            <div id="dqLoadingModal" style="display:none" class="dm-loading"><i class="bi bi-hourglass-split"></i></div>
          </div>
        </div>
      </div>
      <div class="dm-footer">
        <button type="button" class="dm-btn-cancel" data-bs-dismiss="modal">Cancel</button>
        <button id="downloadBtnModal" type="button" class="dm-btn-dl dl-pending">
          <i class="bi bi-download"></i> Download
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function(){
    const startEl = document.getElementById('dqStartModal');
    const endEl = document.getElementById('dqEndModal');
    const formatEl = document.getElementById('dqFormatModal');
    const previewBtn = document.getElementById('previewCountModal');
    const downloadBtn = document.getElementById('downloadBtnModal');
    const dqCountBadge = document.getElementById('dqCountBadgeModal');
    const dqLoading = document.getElementById('dqLoadingModal');

    const today = new Date();
    const prior = new Date(); prior.setDate(today.getDate() - 30);
    function toInputDate(d){ return d.toISOString().slice(0,10); }
    
    // Default to "All time"
    if (startEl) startEl.value = '2000-01-01';
    if (endEl) endEl.value = '2099-12-31';

    function setActivePresetModal(days){
      document.querySelectorAll('.dq-preset-btns button').forEach(b => b.classList.toggle('active', b.getAttribute('data-days') == String(days)));
    }
    
    // Set "All time" as active by default
    setActivePresetModal(0);

    window.setPresetModal = function(days){
      const e = new Date();
      if (days === 0) {
        const s = new Date(2000,0,1);
        startEl.value = toInputDate(s);
        endEl.value = toInputDate(new Date(2099,11,31));
      } else {
        const s = new Date(); s.setDate(e.getDate() - (days-1));
        startEl.value = toInputDate(s);
        endEl.value = toInputDate(e);
      }
      setActivePresetModal(days);
      scheduleAutoPreviewModal();
    };
    setActivePresetModal(30);

    function validateDates(){
      if(!startEl.value || !endEl.value) { if(window.Toast) window.Toast.warning('Missing dates','Please select start and end dates'); return false; }
      if(new Date(startEl.value) > new Date(endEl.value)){ if(window.Toast) window.Toast.warning('Invalid range','Start date must be before end date'); return false; }
      return true;
    }

    let previewDone = false, previewTimer = null;
    function scheduleAutoPreviewModal(){ if(previewTimer) clearTimeout(previewTimer); previewTimer = setTimeout(()=> previewCount(), 600); }

    function setBadge(el, count){ el.style.removeProperty('background'); el.style.removeProperty('color'); if (count === null) { el.style.background='#ef4444'; el.style.color='#fff'; el.textContent='Err'; return; } if(count<=0){el.style.background='#ef4444'; el.style.color='#fff'; el.textContent='0';} else if(count<=10){el.style.background='#f59e0b'; el.style.color='#111827'; el.textContent=String(count);} else {el.style.background='#10b981'; el.style.color='#fff'; el.textContent=String(count);} }

    async function previewCount(){
      if(!validateDates()) return;
      dqCountBadge.textContent='…'; dqLoading.style.display='inline';
      const s=encodeURIComponent(startEl.value), e=encodeURIComponent(endEl.value);
      try{
        const res = await fetch(`/api/download/disqualified/count?start=${s}&end=${e}`);
        if(!res.ok) throw new Error('Server returned '+res.status);
        const ct = (res.headers.get('content-type') || '').toLowerCase();
        if (!ct.includes('application/json')) {
          const txt = await res.text();
          console.error('[Disqualification.preview] expected JSON but got', ct, txt.slice(0,200));
          throw new Error('Invalid server response (not JSON)');
        }
        let j;
        try { j = await res.json(); } catch(parseErr) {
          console.error('Failed to parse JSON from /api/download/disqualified/count', parseErr);
          if (window.Toast) window.Toast.error('Data error','Invalid response from server');
          setBadge(dqCountBadge, null); previewDone=false; downloadBtn.classList.add('dl-pending'); return;
        }
        setBadge(dqCountBadge, j.count ?? 0); previewDone=true; downloadBtn.classList.remove('dl-pending'); if(window.Toast) window.Toast.info('Preview', 'Found '+(j.count??0)+' records'); return true;
      }catch(err){ console.error(err); setBadge(dqCountBadge, null); previewDone=false; downloadBtn.classList.add('dl-pending'); if(window.Toast) window.Toast.error('Preview failed', err.message||''); return false; }
      finally{ dqLoading.style.display='none'; }
    }

    async function download(){ if(!validateDates()) return; if(!previewDone){ const ok = await previewCount(); if(!ok || !previewDone) return; } const s=encodeURIComponent(startEl.value), e=encodeURIComponent(endEl.value), fmt=encodeURIComponent(formatEl.value||'xlsx'); window.location.href=`/api/download/disqualified?start=${s}&end=${e}&format=${fmt}`; }

    startEl.addEventListener('input', scheduleAutoPreviewModal); endEl.addEventListener('input', scheduleAutoPreviewModal);
    previewBtn.addEventListener('click', function(e){ e.preventDefault(); previewCount(); });
    downloadBtn.addEventListener('click', function(e){ e.preventDefault(); download(); });

    // Reset when modal opens
    document.getElementById('disqualificationModal').addEventListener('shown.bs.modal', async function(){
      previewDone=false; downloadBtn.classList.add('dl-pending'); setBadge(dqCountBadge, '—');
      // populate department/section lists from server
      try{
                const res = await fetch('/api/download/meta/disqualified');
                if (!res.ok) {
                    console.warn('/api/download/meta/disqualified returned', res.status);
                    if (window.Toast) window.Toast.warning('Data unavailable', 'Unable to load department/section list');
                } else {
                    const ct = (res.headers.get('content-type') || '').toLowerCase();
                    if (ct.includes('application/json')) {
                        let j;
                        try { j = await res.json(); } catch(parseErr) {
                            console.error('Failed to parse JSON from /api/download/meta/disqualified', parseErr);
                            if (window.Toast) window.Toast.error('Data error', 'Invalid response from server');
                            return;
                        }
                        const deptEl = document.getElementById('dqDeptModal');
                        const sectEl = document.getElementById('dqSectModal');
                        if (Array.isArray(j.departments) && deptEl) {
                            deptEl.innerHTML = '<option value="">-- Any --</option>' + j.departments.map(d => `<option value="${escapeHtml(d)}">${escapeHtml(d)}</option>`).join('');
                        }
                        if (Array.isArray(j.sections) && sectEl) {
                            sectEl.innerHTML = '<option value="">-- Any --</option>' + j.sections.map(s => `<option value="${escapeHtml(s)}">${escapeHtml(s)}</option>`).join('');
                        }
                        if(deptEl) deptEl.addEventListener('change', scheduleAutoPreviewModal);
                        if(sectEl) sectEl.addEventListener('change', scheduleAutoPreviewModal);
                    } else {
                        const txt = await res.text();
                        console.error('Unexpected /api/download/meta/disqualified response (not JSON)', ct, txt.slice(0,200));
                        if (window.Toast) window.Toast.error('Server error', 'Unable to load department list');
                    }
                }
            }catch(err){ console.error('Failed to load departments/sections', err); if(window.Toast) window.Toast.error('Network error','Failed to load department/section list'); }
    });

    // helper to escape HTML inserted into select
    function escapeHtml(s){ return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":"&#39;"}[c]; }); }

    // include dept/sect in preview/download calls
    async function previewCount(){
      if(!validateDates()) return;
      dqCountBadge.textContent='…'; dqLoading.style.display='inline';
      const s=encodeURIComponent(startEl.value), e=encodeURIComponent(endEl.value);
      const dept = encodeURIComponent((document.getElementById('dqDeptModal')?.value)||'');
      const sect = encodeURIComponent((document.getElementById('dqSectModal')?.value)||'');
      const extras = (dept? ('&dept=' + dept) : '') + (sect? ('&sect=' + sect) : '');
      try{
        const res = await fetch(`/api/download/disqualified/count?start=${s}&end=${e}${extras}`);
        if(!res.ok) throw new Error('Server returned '+res.status);
        const ct = (res.headers.get('content-type') || '').toLowerCase();
        if (!ct.includes('application/json')) {
          const txt = await res.text();
          console.error('[Disqualification.preview] expected JSON but got', ct, txt.slice(0,200));
          throw new Error('Invalid server response (not JSON)');
        }
        let j;
        try { j = await res.json(); } catch(parseErr) {
          console.error('Failed to parse JSON from /api/download/disqualified/count', parseErr);
          if (window.Toast) window.Toast.error('Data error','Invalid response from server');
          setBadge(dqCountBadge, null); previewDone=false; downloadBtn.classList.add('dl-pending'); return;
        }
        setBadge(dqCountBadge, j.count ?? 0); previewDone=true; downloadBtn.classList.remove('dl-pending'); if(window.Toast) window.Toast.info('Preview', 'Found '+(j.count??0)+' records'); return true;
      }catch(err){ console.error(err); setBadge(dqCountBadge, null); previewDone=false; downloadBtn.classList.add('dl-pending'); if(window.Toast) window.Toast.error('Preview failed', err.message||''); return false; }
      finally{ dqLoading.style.display='none'; }
    }

    async function download(){
      if(!validateDates()) return; if(!previewDone){ const ok = await previewCount(); if(!ok || !previewDone) return; }
      const s=encodeURIComponent(startEl.value), e=encodeURIComponent(endEl.value), fmt=encodeURIComponent(formatEl.value||'xlsx');
      const dept = encodeURIComponent((document.getElementById('dqDeptModal')?.value)||'');
      const sect = encodeURIComponent((document.getElementById('dqSectModal')?.value)||'');
      const extras = (dept? ('&dept=' + dept) : '') + (sect? ('&sect=' + sect) : '');
      window.location.href=`/api/download/disqualified?start=${s}&end=${e}&format=${fmt}${extras}`;
    }
  })();
</script>
