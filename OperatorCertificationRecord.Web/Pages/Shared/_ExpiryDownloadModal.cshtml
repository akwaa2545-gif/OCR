<div class="modal fade" id="expiryModal" tabindex="-1" aria-labelledby="expiryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content dm-modal-content" style="--dm-color:#ea580c;--dm-light:#fff7ed;">
      <div class="dm-header">
        <div class="dm-hdr-icon"><i class="bi bi-calendar-x-fill"></i></div>
        <div class="dm-hdr-text">
          <div class="dm-hdr-title" id="expiryModalLabel">Expiry Date</div>
          <div class="dm-hdr-sub">Download operator expiry date records</div>
        </div>
        <button type="button" class="dm-close" data-bs-dismiss="modal" aria-label="Close"><i class="bi bi-x-lg"></i></button>
      </div>
      <div class="dm-body">
        <div class="dm-section-lbl"><i class="bi bi-funnel-fill"></i> Filter</div>
        <div class="dm-grid-2">
          <div class="dm-field">
            <label class="dm-label" for="exDeptModal">Department</label>
            <select id="exDeptModal" class="dm-input"><option value="">— Any —</option></select>
          </div>
          <div class="dm-field">
            <label class="dm-label" for="exSectModal">Section</label>
            <select id="exSectModal" class="dm-input"><option value="">— Any —</option></select>
          </div>
        </div>
        <div class="dm-section-lbl" style="margin-top:1rem"><i class="bi bi-calendar3"></i> Date Range</div>
        <div class="dm-grid-2">
          <div class="dm-field">
            <label class="dm-label" for="exStartModal">Start Date</label>
            <input id="exStartModal" type="date" class="dm-input" onchange="validateDateRange('exStartModal','exEndModal','exDateErr','exPreviewCountModal','exDownloadBtnModal')" />
          </div>
          <div class="dm-field">
            <label class="dm-label" for="exEndModal">End Date</label>
            <input id="exEndModal" type="date" class="dm-input" onchange="validateDateRange('exStartModal','exEndModal','exDateErr','exPreviewCountModal','exDownloadBtnModal')" />
          </div>
        </div>
        <span class="dm-date-err" id="exDateErr"></span>
        <div class="dm-pill-row dq-preset-btns">
          <button type="button" class="dm-pill" data-days="7" onclick="setExpiryPreset(7)">7 days</button>
          <button type="button" class="dm-pill" data-days="30" onclick="setExpiryPreset(30)">30 days</button>
          <button type="button" class="dm-pill" data-days="365" onclick="setExpiryPreset(365)">1 year</button>
          <button type="button" class="dm-pill active" data-days="year" onclick="setExpiryPreset('year')">This year</button>
          <button type="button" class="dm-pill" data-days="0" onclick="setExpiryPreset(0)">All time</button>
        </div>
        <div class="dm-summary">
          <div class="dm-field dm-format-field">
            <label class="dm-label">Format</label>
            <select id="exFormatModal" class="dm-input">
              <option value="xlsx">Excel (.xlsx)</option>
              <option value="csv">CSV (.csv)</option>
            </select>
          </div>
          <button id="exPreviewCountModal" type="button" class="dm-preview-btn">
            <i class="bi bi-search"></i> Preview
          </button>
          <div class="dm-count-wrap">
            <div class="dm-count-lbl">Records</div>
            <div id="exCountBadgeModal" class="dm-count-badge">—</div>
            <div id="exLoadingModal" style="display:none" class="dm-loading"><i class="bi bi-hourglass-split"></i></div>
          </div>
        </div>
      </div>
      <div class="dm-footer">
        <button type="button" class="dm-btn-cancel" data-bs-dismiss="modal">Cancel</button>
        <button id="exDownloadBtnModal" type="button" class="dm-btn-dl dl-pending">
          <i class="bi bi-download"></i> Download
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  const startEl = document.getElementById('exStartModal');
  const endEl = document.getElementById('exEndModal');
  const formatEl = document.getElementById('exFormatModal');
  const previewBtn = document.getElementById('exPreviewCountModal');
  const downloadBtn = document.getElementById('exDownloadBtnModal');
  const exCountBadge = document.getElementById('exCountBadgeModal');
  const exLoading = document.getElementById('exLoadingModal');

  const today = new Date();
  const prior = new Date(); prior.setDate(today.getDate() - 30);
  function toInputDate(d){ return ReportDateRanges.formatLocal(d); }
  ReportDateRanges.initialize(startEl, endEl, document.getElementById('expiryModal'));

  function setActive(days){ document.getElementById('expiryModal').querySelectorAll('.dq-preset-btns button').forEach(b => b.classList.toggle('active', b.getAttribute('data-days') == String(days))); }
  window.setExpiryPreset = function(days){ ReportDateRanges.apply(startEl, endEl, days); setActive(days); scheduleAutoPreview(); };
  setActive('year');

  function validate(){ if(!startEl.value || !endEl.value){ if(window.Toast) window.Toast.warning('Missing dates','Please select start and end dates'); return false; } if(new Date(startEl.value) > new Date(endEl.value)){ if(window.Toast) window.Toast.warning('Invalid range','Start date must be before end date'); return false; } return true; }

  let previewDone=false;
  function scheduleAutoPreview(){ previewState.schedule(previewCount); }

  const previewState = DownloadPreview.create({ modal: document.getElementById('expiryModal'), badge: exCountBadge, loading: exLoading, preview: previewBtn, download: downloadBtn, filters: [startEl,endEl,document.getElementById('exDeptModal'),document.getElementById('exSectModal')], onInvalidate: function(){ previewDone = false; } });

  [document.getElementById('exDeptModal'),document.getElementById('exSectModal')].filter(Boolean).forEach(field => field.addEventListener('change', scheduleAutoPreview));

  function setBadge(el, count){ el.style.removeProperty('background'); el.style.removeProperty('color'); if (count === null) { el.style.background='#ef4444'; el.style.color='#fff'; el.textContent='Err'; return; } if(count<=0){el.style.background='#ef4444'; el.style.color='#fff'; el.textContent='0';} else if(count<=10){/* highlight 10-day or fewer as red */el.style.background='#ef4444'; el.style.color='#fff'; el.textContent=String(count);} else {el.style.background='#10b981'; el.style.color='#fff'; el.textContent=String(count);} }

  async function previewCount(){
    const ticket = previewState.begin(); if(!validate()) return; exCountBadge.textContent='…'; exLoading.style.display='inline'; const s=encodeURIComponent(startEl.value), e=encodeURIComponent(endEl.value); const dept = encodeURIComponent((document.getElementById('exDeptModal')?.value)||''); const sect = encodeURIComponent((document.getElementById('exSectModal')?.value)||''); const extras = (dept?('&dept='+dept):'') + (sect?('&sect='+sect):''); try{ const res = await fetch(`/api/download/expiry/count?start=${s}&end=${e}${extras}`); if(!res.ok) throw new Error('Server '+res.status); const ct = (res.headers.get('content-type') || '').toLowerCase(); if (!ct.includes('application/json')) { const txt = await res.text(); console.error('[Expiry.preview] expected JSON but got', ct, txt.slice(0,200)); throw new Error('Invalid server response (not JSON)'); } let j; try { j = await res.json(); if (!previewState.current(ticket)) return false; } catch(parseErr){ if (!previewState.current(ticket)) return false; console.error('Failed to parse JSON from /api/download/expiry/count', parseErr); if (window.Toast) window.Toast.error('Data error','Invalid response from server'); setBadge(exCountBadge, null); previewDone=false; downloadBtn.classList.add('dl-pending'); return; } setBadge(exCountBadge, j.count ?? 0); previewDone=true; previewState.complete(ticket);  return true; }catch(err){ if (!previewState.current(ticket)) return false; console.error(err); setBadge(exCountBadge, null); previewDone=false; downloadBtn.classList.add('dl-pending'); if(window.Toast) window.Toast.error('Preview failed', err.message||''); return false; } finally { if (previewState.current(ticket)) { exLoading.style.display='none'; } } }

  async function download(){ if(!validate()) return; if(!previewDone){ const ok = await previewCount(); if(!ok || !previewDone) return; } const s=encodeURIComponent(startEl.value), e=encodeURIComponent(endEl.value), fmt=encodeURIComponent(formatEl.value||'xlsx'); const dept = encodeURIComponent((document.getElementById('exDeptModal')?.value)||''); const sect = encodeURIComponent((document.getElementById('exSectModal')?.value)||''); const extras = (dept?('&dept='+dept):'') + (sect?('&sect='+sect):''); window.location.href=`/api/download/expiry?start=${s}&end=${e}&format=${fmt}${extras}`; }

  startEl.addEventListener('input', scheduleAutoPreview); endEl.addEventListener('input', scheduleAutoPreview);
  previewBtn.addEventListener('click', function(e){ e.preventDefault(); previewCount(); });
  downloadBtn.addEventListener('click', function(e){ e.preventDefault(); download(); });

  document.getElementById('expiryModal').addEventListener('shown.bs.modal', async function(){
    const opening = previewState.open();
    await previewState.loadOptions(opening, [{ element: document.getElementById('exDeptModal'), key: 'departments' }, { element: document.getElementById('exSectModal'), key: 'sections' }]);
    if (previewState.isOpen(opening) && (true)) scheduleAutoPreview();
  });

  function escapeHtml(s){ return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":"&#39;"}[c]; }); }
})();
</script>
