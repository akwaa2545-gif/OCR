@*
  Partial: Obsoleted Download Modal (clean)
*@
<div class="modal fade" id="obsoletedModal" tabindex="-1" aria-labelledby="obsoletedModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content dm-modal-content" style="--dm-color:#92400e;--dm-light:#fffbeb;">
      <div class="dm-header">
        <div class="dm-hdr-icon"><i class="bi bi-archive-fill"></i></div>
        <div class="dm-hdr-text">
          <div class="dm-hdr-title" id="obsoletedModalLabel">Obsoleted Records</div>
          <div class="dm-hdr-sub">Download obsoleted certification records</div>
        </div>
        <button type="button" class="dm-close" data-bs-dismiss="modal" aria-label="Close"><i class="bi bi-x-lg"></i></button>
      </div>
      <div class="dm-body">
        <div class="dm-section-lbl"><i class="bi bi-funnel-fill"></i> Filter</div>
        <div class="dm-grid-2">
          <div class="dm-field">
            <label class="dm-label" for="obDeptModal">Department</label>
            <select id="obDeptModal" class="dm-input"><option value="">— Any —</option></select>
          </div>
          <div class="dm-field">
            <label class="dm-label" for="obSectModal">Section</label>
            <select id="obSectModal" class="dm-input"><option value="">— Any —</option></select>
          </div>
        </div>
        <div class="dm-section-lbl" style="margin-top:1rem"><i class="bi bi-calendar3"></i> Date Range</div>
        <div class="dm-grid-2">
          <div class="dm-field">
            <label class="dm-label" for="obStartModal">Start Date</label>
            <input id="obStartModal" type="date" class="dm-input" onchange="validateDateRange('obStartModal','obEndModal','obDateErr','obPreviewBtn','obDownloadBtn')" />
          </div>
          <div class="dm-field">
            <label class="dm-label" for="obEndModal">End Date</label>
            <input id="obEndModal" type="date" class="dm-input" onchange="validateDateRange('obStartModal','obEndModal','obDateErr','obPreviewBtn','obDownloadBtn')" />
          </div>
        </div>
        <span class="dm-date-err" id="obDateErr"></span>
        <div class="dm-pill-row dq-preset-btns">
          <button type="button" class="dm-pill" data-days="7">7 days</button>
          <button type="button" class="dm-pill" data-days="30">30 days</button>
          <button type="button" class="dm-pill" data-days="365">1 year</button>
          <button type="button" class="dm-pill active" data-days="0">All time</button>
        </div>
        <div class="dm-summary">
          <div class="dm-field dm-format-field">
            <label class="dm-label">Format</label>
            <select id="obFormat" class="dm-input">
              <option value="xlsx">Excel (.xlsx)</option>
              <option value="csv">CSV (.csv)</option>
            </select>
          </div>
          <button id="obPreviewBtn" type="button" class="dm-preview-btn">
            <i class="bi bi-search"></i> Preview
          </button>
          <div class="dm-count-wrap">
            <div class="dm-count-lbl">Records</div>
            <div id="obCountBadge" class="dm-count-badge">—</div>
            <div id="obLoading" style="display:none" class="dm-loading"><i class="bi bi-hourglass-split"></i></div>
          </div>
        </div>
      </div>
      <div class="dm-footer">
        <button type="button" class="dm-btn-cancel" data-bs-dismiss="modal">Cancel</button>
        <button id="obDownloadBtn" type="button" class="dm-btn-dl dl-pending">
          <i class="bi bi-download"></i> Download
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  // Single, consolidated obsoleted-modal script (guards added)
  const startEl = document.getElementById('obStartModal');
  const endEl = document.getElementById('obEndModal');
  const previewBtn = document.getElementById('obPreviewBtn');
  const badge = document.getElementById('obCountBadge');
  const loading = document.getElementById('obLoading');
  const downloadBtn = document.getElementById('obDownloadBtn');
  const fmt = document.getElementById('obFormat');
  const presets = Array.from(document.querySelectorAll('.dq-preset-btns button'));

  const today = new Date();
  function toInputDate(d){ return d.toISOString().slice(0,10); }
  
  // Default to "All time"
  if (startEl) startEl.value = '2000-01-01';
  if (endEl) endEl.value = '2099-12-31';

  function setActive(days){ presets.forEach(p=> p.classList.toggle('active', p.getAttribute('data-days')==String(days))); }
  window.setObPreset = function(days){ const now=new Date(); if(days===0){ if (startEl) startEl.value='2000-01-01'; if (endEl) endEl.value='2099-12-31'; } else { const s=new Date(); s.setDate(now.getDate()-(days-1)); if (startEl) startEl.value=toInputDate(s); if (endEl) endEl.value=toInputDate(now); } setActive(days); scheduleAutoPreview(); };
  setActive(0);

  // wire preset buttons
  presets.forEach(btn => btn.addEventListener('click', () => {
    const days = parseInt(btn.getAttribute('data-days') || '0', 10);
    window.setObPreset(days);
  }));

  let timer=null;
  function scheduleAutoPreview(){ if(timer) clearTimeout(timer); timer=setTimeout(()=> previewCount(), 700); }

  function valid(){ if(!(startEl && endEl)) return false; if(!startEl.value || !endEl.value) return false; if(new Date(startEl.value) > new Date(endEl.value)) return false; return true; }

  function setBadge(count){ if(!badge) return; badge.style.removeProperty('background'); badge.style.removeProperty('color'); if (count === null) { badge.style.background='#ef4444'; badge.style.color='#fff'; badge.textContent='Err'; return; } badge.textContent = String(count); if(count<=0){ badge.style.background='#ef4444'; badge.style.color='#fff'; } else if(count<=10){ badge.style.background='#f59e0b'; badge.style.color='#111827'; } else { badge.style.background='#10b981'; badge.style.color='#fff'; } }

  async function previewCount(){ if(!valid()){ setBadge(null); if(downloadBtn) downloadBtn.classList.add('dl-pending'); return; } if(badge) badge.textContent='…'; if(loading) loading.style.display='inline'; if(previewBtn) previewBtn.disabled=true; try{ const s = encodeURIComponent(startEl.value), e = encodeURIComponent(endEl.value); const dept = encodeURIComponent((document.getElementById('obDeptModal')?.value)||''); const sect = encodeURIComponent((document.getElementById('obSectModal')?.value)||''); const extras = (dept?('&dept='+dept):'') + (sect?('&sect='+sect):''); const res = await fetch(`/api/download/obsoleted/count?start=${s}&end=${e}${extras}`); if(!res.ok) throw new Error('server'); const ct = (res.headers.get('content-type') || '').toLowerCase(); if (!ct.includes('application/json')) { const txt = await res.text(); console.error('[Obsoleted.preview] expected JSON but got', ct, txt.slice(0,200)); throw new Error('Invalid server response (not JSON)'); } let j; try { j = await res.json(); } catch(parseErr){ console.error('Failed to parse JSON from /api/download/obsoleted/count', parseErr); if (window.Toast) window.Toast.error('Data error','Invalid response from server'); setBadge(null); if(downloadBtn) downloadBtn.classList.add('dl-pending'); return; } setBadge(j.count ?? 0); if(downloadBtn) downloadBtn.classList.remove('dl-pending'); return true; }catch(err){ console.error(err); setBadge(null); if(downloadBtn) downloadBtn.classList.add('dl-pending'); return false; } finally{ if(loading) loading.style.display='none'; if(previewBtn) previewBtn.disabled=false; } }

  async function download(){ if(downloadBtn && downloadBtn.classList.contains('dl-pending')){ const ok = await previewCount(); if(!ok || downloadBtn.classList.contains('dl-pending')) return; } if(!downloadBtn) return; if(!valid()){ if(window.Toast) window.Toast.warning('Invalid dates','Please check the date range'); return; } const s = encodeURIComponent(startEl.value), e = encodeURIComponent(endEl.value), f = encodeURIComponent((fmt?.value)||'xlsx'); const dept = encodeURIComponent((document.getElementById('obDeptModal')?.value)||''); const sect = encodeURIComponent((document.getElementById('obSectModal')?.value)||''); const extras = (dept?('&dept='+dept):'') + (sect?('&sect='+sect):''); window.location.href = `/api/download/obsoleted?start=${s}&end=${e}&format=${f}${extras}`; }

  if (previewBtn) previewBtn.addEventListener('click', (e)=>{ e.preventDefault(); previewCount(); });
  if (downloadBtn) downloadBtn.addEventListener('click', (e)=>{ e.preventDefault(); download(); });
  if (startEl) startEl.addEventListener('input', scheduleAutoPreview);
  if (endEl) endEl.addEventListener('input', scheduleAutoPreview);

  const obModalEl = document.getElementById('obsoletedModal');
  if (obModalEl) obModalEl.addEventListener('shown.bs.modal', async function(){ if(downloadBtn) downloadBtn.classList.add('dl-pending'); setBadge('—'); try{
                const res = await fetch('/api/download/meta/disqualified');
                if (!res.ok) {
                    console.warn('/api/download/meta/disqualified returned', res.status);
                    if (window.Toast) window.Toast.warning('Data unavailable', 'Unable to load department/section list');
                } else {
                    const ct = (res.headers.get('content-type') || '').toLowerCase();
                    if (ct.includes('application/json')) {
                        let j;
                        try { j = await res.json(); } catch(parseErr) {
                            console.error('Failed to parse JSON from /api/download/meta/disqualified', parseErr);
                            if (window.Toast) window.Toast.error('Data error', 'Invalid response from server');
                            return;
                        }
                        const deptEl = document.getElementById('obDeptModal');
                        const sectEl = document.getElementById('obSectModal');
                        if (Array.isArray(j.departments) && deptEl) deptEl.innerHTML = '<option value="">-- Any --</option>' + j.departments.map(d=>`<option value="${escapeHtml(d)}">${escapeHtml(d)}</option>`).join('');
                        if (Array.isArray(j.sections) && sectEl) sectEl.innerHTML = '<option value="">-- Any --</option>' + j.sections.map(s=>`<option value="${escapeHtml(s)}">${escapeHtml(s)}</option>`).join('');
                        if (deptEl) deptEl.addEventListener('change', scheduleAutoPreview);
                        if (sectEl) sectEl.addEventListener('change', scheduleAutoPreview);
                    } else {
                        const txt = await res.text();
                        console.error('Unexpected /api/download/meta/disqualified response (not JSON)', ct, txt.slice(0,200));
                        if (window.Toast) window.Toast.error('Server error', 'Unable to load department list');
                    }
                }
            }catch(err){ console.error('Failed to load departments', err); if(window.Toast) window.Toast.error('Network error','Failed to load department/section list'); } });
})();
</script>

<script>
  (function(){
    // populate dept/section selects if present
    async function populate() {
      try{
        const res = await fetch('/api/download/meta/disqualified');
        if(!res.ok) return;
        const ct = (res.headers.get('content-type') || '').toLowerCase();
        if (!ct.includes('application/json')) {
          console.error('[Obsoleted.populate] meta/disqualified returned non-JSON: ' + ct);
          return;
        }
        let j;
        try { j = await res.json(); } catch(parseErr) { console.error('Failed to parse JSON from /api/download/meta/disqualified', parseErr); return; }
        const map = [ ['obDeptModal','obSectModal'], ['obsoletedDept','obsoletedSect'] ];
        for(const [dId,sId] of map){
          const dEl = document.getElementById(dId); const sEl = document.getElementById(sId);
          if(dEl && Array.isArray(j.departments)) dEl.innerHTML = '<option value="">-- Any --</option>' + j.departments.map(d=>`<option value="${escapeHtml(d)}">${escapeHtml(d)}</option>`).join('');
          if(sEl && Array.isArray(j.sections)) sEl.innerHTML = '<option value="">-- Any --</option>' + j.sections.map(s=>`<option value="${escapeHtml(s)}">${escapeHtml(s)}</option>`).join('');
        }
      }catch(e){ console.error('meta load', e); }
    }
    document.addEventListener('DOMContentLoaded', populate);
  })();
</script>


