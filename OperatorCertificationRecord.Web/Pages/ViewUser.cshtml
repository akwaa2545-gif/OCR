@page
@using OperatorCertificationRecord.Web.Models
@model OperatorCertificationRecord.Web.Pages.ViewUserModel
@inject OperatorCertificationRecord.Web.Services.AdminService AdminService
@{
    ViewData["Title"] = "View Employee";
    ViewData["ActivePage"] = "ViewUser";
    bool isAdmin = AdminService.IsAdmin(HttpContext.Session.GetString("UserCode"));
}

<style>
    /* ============================================================
       VIEW USER — Profile Header + Full-Width Layout (vu-* ns)
       Orange / White modern theme
       ============================================================ */

    /* ── Page wrapper ── */
    .vu-page {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    /* ── Profile header card ── */
    .vu-profile {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        overflow: hidden;
    }
    .vu-profile-banner {
        height: 72px;
        background: linear-gradient(135deg, #f97316 0%, #fb923c 50%, #fed7aa 100%);
    }
    .vu-profile-body {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
        padding: 0 1.5rem 0.75rem;
        margin-top: -36px;
        position: relative;
        flex-wrap: wrap;
    }
    .vu-avatar-wrap { flex-shrink: 0; }
    .vu-avatar-ring {
        width: 76px;
        height: 76px;
        border-radius: 50%;
        padding: 3px;
        background: linear-gradient(135deg, #ea580c, #f97316, #fb923c);
        box-shadow: 0 4px 14px rgba(234,88,12,0.2);
    }
    .vu-avatar-ring.ring-promoted { background: linear-gradient(135deg, #16a34a, #22c55e, #4ade80); box-shadow: 0 4px 14px rgba(22,163,74,0.2); }
    .vu-avatar-ring.ring-resigned { background: linear-gradient(135deg, #b91c1c, #dc2626, #f87171); box-shadow: 0 4px 14px rgba(185,28,28,0.2); }
    .vu-avatar-img {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #fff;
        display: block;
        cursor: pointer;
        transition: transform 0.2s ease;
    }
    .vu-avatar-img:hover { transform: scale(1.06); }

    /* Info block */
    .vu-info-block {
        flex: 1;
        min-width: 160px;
        padding-top: 40px;
    }
    .vu-emp-name {
        font-size: 1.05rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0 0 0.1rem;
        line-height: 1.25;
    }
    .vu-emp-code {
        font-size: 0.75rem;
        color: #64748b;
        font-weight: 500;
        margin: 0 0 0.35rem;
    }
    .vu-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.15rem 0.55rem;
        border-radius: 20px;
        font-size: 0.68rem;
        font-weight: 600;
        border: 1.5px solid;
    }
    .vu-badge.active   { background: #fff7ed; color: #c2410c; border-color: #fed7aa; }
    .vu-badge.promoted { background: #f0fdf4; color: #15803d; border-color: #bbf7d0; }
    .vu-badge.resigned { background: #fff1f2; color: #be123c; border-color: #fecdd3; }

    /* Stats row */
    .vu-stats-row {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        padding-top: 40px;
        align-items: flex-start;
    }
    .vu-stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.38rem;
        padding: 0.38rem 0.75rem;
        border-radius: 20px;
        font-size: 0.73rem;
        font-weight: 600;
        white-space: nowrap;
        border: none;
        letter-spacing: 0.01em;
    }
    .vu-stat-pill i { font-size: 0.8rem; }
    .vu-stat-pill .vu-stat-num { font-weight: 800; font-size: 0.85rem; }
    /* Stat count pills — solid gradients */
    .vu-stat-pill.orange {
        background: linear-gradient(135deg, #f97316, #ea580c);
        color: #fff;
        box-shadow: 0 2px 8px rgba(234,88,12,0.30);
    }
    .vu-stat-pill.orange .vu-stat-num { color: #fff; }
    .vu-stat-pill.red {
        background: linear-gradient(135deg, #f43f5e, #be123c);
        color: #fff;
        box-shadow: 0 2px 8px rgba(190,18,60,0.28);
    }
    .vu-stat-pill.red .vu-stat-num { color: #fff; }
    .vu-stat-pill.amber {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff;
        box-shadow: 0 2px 8px rgba(217,119,6,0.28);
    }
    .vu-stat-pill.amber .vu-stat-num { color: #fff; }
    /* Info pills — colored variants */
    .vu-stat-pill.blue {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: #fff;
        box-shadow: 0 2px 8px rgba(37,99,235,0.30);
    }
    .vu-stat-pill.purple {
        background: linear-gradient(135deg, #8b5cf6, #7c3aed);
        color: #fff;
        box-shadow: 0 2px 8px rgba(124,58,237,0.28);
    }
    .vu-stat-pill.slate {
        background: linear-gradient(135deg, #ea580c, #f97316);
        color: #fff;
        box-shadow: 0 2px 8px rgba(234,88,12,0.28);
    }

    /* Nav row */
    .vu-nav-row {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        padding: 0.75rem 1.5rem 0.85rem;
        border-top: 1px solid #f1f5f9;
    }
    .vu-nav-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.38rem;
        padding: 0.42rem 0.9rem;
        border-radius: 8px;
        font-size: 0.77rem;
        font-weight: 600;
        border: none;
        text-decoration: none;
        cursor: pointer;
        letter-spacing: 0.01em;
        white-space: nowrap;
        line-height: 1.3;
        transition: filter 0.15s, box-shadow 0.15s, transform 0.12s;
    }
    .vu-nav-btn i { font-size: 0.82rem; }
    .vu-nav-btn:hover { transform: translateY(-1px); filter: brightness(1.08); box-shadow: 0 4px 14px rgba(0,0,0,0.14); text-decoration: none; }
    .vu-nav-btn:active { transform: translateY(0); filter: brightness(0.96); box-shadow: none; }
    .vu-nav-btn.disabled { opacity: 0.38; cursor: not-allowed; pointer-events: none; filter: grayscale(0.5); transform: none; }
    .vu-nav-btn-back   { background: linear-gradient(135deg, #64748b, #475569); color: #fff !important; box-shadow: 0 2px 8px rgba(71,85,105,0.22); }
    .vu-nav-btn-update { background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: #fff !important; box-shadow: 0 2px 8px rgba(29,78,216,0.22); }
    .vu-nav-btn-info   { background: linear-gradient(135deg, #06b6d4, #0891b2); color: #fff !important; box-shadow: 0 2px 8px rgba(8,145,178,0.22); }

    /* ── Section cards ── */
    .vu-section {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06), 0 1px 3px rgba(0,0,0,0.04);
        overflow: hidden;
    }
    .vu-section-hdr {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.75rem 1.2rem;
        background: linear-gradient(90deg, #fff7ed 0%, #fffbf8 60%, #fff 100%);
        border-bottom: 1px solid #f1e4d0;
        cursor: pointer;
        user-select: none;
    }
    .vu-section-hdr:hover { background: linear-gradient(90deg, #ffedd5 0%, #fff7ed 60%, #fffbf8 100%); }
    .vu-section-icon {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: linear-gradient(135deg, #fff7ed, #ffedd5);
        border: 1px solid #fed7aa;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #f97316;
        font-size: 0.9rem;
        flex-shrink: 0;
        box-shadow: 0 1px 4px rgba(249,115,22,0.15);
    }
    .vu-section-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: #0f172a;
        flex: 1;
        letter-spacing: 0.01em;
    }
    .vu-toggle-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.22rem 0.55rem;
        border-radius: 20px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #c2410c;
        font-size: 0.7rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s;
        margin-left: auto;
        white-space: nowrap;
    }
    .vu-toggle-btn:hover { background: #ffedd5; }
    .vu-section-body { padding: 1.1rem 1.25rem; background: linear-gradient(180deg, #fafafa 0%, #fff 80%); }

    /* ── Info fields ── */
    .vu-subsection-label {
        font-size: 0.65rem;
        font-weight: 800;
        color: #c2410c;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0.32rem 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        background: linear-gradient(90deg, #fff7ed 0%, #fffbf5 55%, transparent 100%);
        border-left: 3px solid #f97316;
        border-radius: 0 6px 6px 0;
        margin-bottom: 0.65rem;
    }
    .vu-subsection-label.mt-2 { margin-top: 1rem; }
    .vu-subsection-label i { color: #f97316; font-size: 0.78rem; }
    .vu-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.7rem;
    }
    .vu-field {
        background: #fff;
        border: 1px solid #e9eff5;
        border-left: 3px solid #f97316;
        border-radius: 9px;
        padding: 0.5rem 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        box-shadow: 0 1px 4px rgba(0,0,0,0.04);
        transition: box-shadow 0.16s ease, transform 0.13s ease, border-left-color 0.16s ease;
    }
    .vu-field:hover {
        box-shadow: 0 4px 14px rgba(249,115,22,0.13);
        transform: translateY(-1px);
        border-left-color: #ea580c;
    }
    .vu-label {
        font-size: 0.6rem;
        color: #a0aec0;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }
    .vu-value {
        font-size: 0.87rem;
        color: #1e293b;
        font-weight: 500;
        line-height: 1.3;
    }
    .vu-value.accent { color: #ea580c; font-weight: 700; }
    .vu-value.muted  { color: #64748b; }
    .vu-grade-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.55rem;
        border-radius: 20px;
        background: linear-gradient(135deg, #fff7ed, #ffedd5);
        color: #c2410c;
        font-size: 0.75rem;
        font-weight: 700;
        border: 1px solid #fed7aa;
        box-shadow: 0 1px 3px rgba(249,115,22,0.14);
    }

    /* ── Skills action buttons ── */
    .btn-sk {
        display: inline-flex;
        align-items: center;
        gap: 0.38rem;
        padding: 0.45rem 0.9rem;
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        text-decoration: none;
        letter-spacing: 0.01em;
        transition: filter 0.15s, box-shadow 0.15s, transform 0.12s;
        white-space: nowrap;
        line-height: 1.3;
    }
    .btn-sk i { font-size: 0.82rem; }
    .btn-sk:hover  { transform: translateY(-1px); filter: brightness(1.08); box-shadow: 0 4px 14px rgba(0,0,0,0.14); text-decoration: none; }
    .btn-sk:active { transform: translateY(0); filter: brightness(0.96); box-shadow: none; }

    .btn-sk-update     { background: linear-gradient(135deg, #f97316, #ea580c); color: #fff; box-shadow: 0 2px 8px rgba(234,88,12,0.25); }
    .btn-sk-disqualify { background: linear-gradient(135deg, #f43f5e, #be123c); color: #fff; box-shadow: 0 2px 8px rgba(190,18,60,0.25); }
    .btn-sk-add        { background: linear-gradient(135deg, #22c55e, #16a34a); color: #fff; box-shadow: 0 2px 8px rgba(22,163,74,0.25); }
    .btn-sk-download   { background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: #fff; box-shadow: 0 2px 8px rgba(29,78,216,0.25); }
    .btn-sk-fit        { background: #f1f5f9; color: #475569; border: 1.5px solid #e2e8f0; box-shadow: none; }
    .btn-sk-fit:hover  { background: #e2e8f0; filter: none; box-shadow: 0 2px 6px rgba(0,0,0,0.08); }
    .btn-sk-disabled   { opacity: 0.45; cursor: not-allowed; pointer-events: none; filter: grayscale(0.3); }
    .btn-sk:disabled {
        opacity: 0.38 !important;
        filter: grayscale(0.65) brightness(1.05) !important;
        cursor: not-allowed !important;
        box-shadow: none !important;
        transform: none !important;
        pointer-events: none;
    }

    /* ── Badges ── */
    .jbadge {
        display: inline-flex;
        align-items: center;
        gap: 0.18rem;
        padding: 0.1rem 0.4rem;
        border-radius: 5px;
        font-size: 0.72rem;
        font-weight: 600;
        border: 1px solid;
    }
    .jbadge-pass  { background: #dcfce7; color: #15803d; border-color: #bbf7d0; }
    .jbadge-fail  { background: #fee2e2; color: #b91c1c; border-color: #fecaca; }
    .jbadge-other { background: #f1f5f9; color: #475569; border-color: #e2e8f0; }

    /* ── Row highlights ── */
    .table-expiry-10 td { background: rgba(239,68,68,0.06); }
    .table-expiry-30 td { background: rgba(245,158,11,0.06); }
    .table-promoted td  { color: #15803d; opacity: 0.85; }
    .table-obsoleted td { opacity: 0.7; }

    /* ── Empty state ── */
    .empty-state { text-align: center; padding: 2.5rem 1rem; }
    .empty-state-icon  { font-size: 2.5rem; color: #cbd5e1; display: block; margin-bottom: 0.5rem; }
    .empty-state-title { font-size: 1rem; font-weight: 700; color: #475569; margin-bottom: 0.25rem; }
    .empty-state-text  { font-size: 0.82rem; color: #94a3b8; }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .vu-profile-body { flex-direction: column; align-items: center; text-align: center; padding: 0 1rem 0.75rem; }
        .vu-info-block { padding-top: 0.5rem; text-align: center; }
        .vu-stats-row { padding-top: 0; justify-content: center; }
        .vu-grid-3 { grid-template-columns: repeat(2, 1fr); }
        .vu-nav-row { justify-content: center; }
    }
    @@media (max-width: 480px) {
        .vu-grid-3 { grid-template-columns: 1fr; }
    }

    /* ── Two-column main layout ── */
    .vu-main-grid {
        display: grid;
        grid-template-columns: 1fr 3fr;
        gap: 1rem;
        align-items: start;
    }
    .vu-left-col { position: sticky; top: 1rem; }
    .vu-right-col { min-width: 0; }
    /* In the left panel, use single-column info fields so they don't get crushed */
    .vu-left-col .vu-grid-3 {
        grid-template-columns: 1fr;
    }
    @@media (max-width: 992px) {
        .vu-main-grid { grid-template-columns: 1fr; }
        .vu-left-col { position: static; }
        .vu-left-col .vu-grid-3 { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 480px) {
        .vu-left-col .vu-grid-3 { grid-template-columns: 1fr; }
    }
</style>
@if (Model.Employee != null)
{
    var photoUrl = Model.PhotoUrl ?? "/images/placeholder-employee.svg";
    var ringClass = Model.IsResigned ? "ring-resigned" : ((Model.PromotedSkills != null && Model.PromotedSkills.Count > 0) ? "ring-promoted" : "ring-default");

    <div class="vu-page">

    <!-- ── Profile Header ── -->
    <div class="vu-profile">
        <div class="vu-profile-banner"></div>
        <div class="vu-profile-body">
            <div class="vu-avatar-wrap">
                <div class="vu-avatar-ring @ringClass">
                    <img id="employeePhoto" src="@photoUrl" class="vu-avatar-img" alt="Employee Photo"
                         role="button" tabindex="0" title="Click to enlarge" aria-label="View employee photo in full screen" />
                </div>
            </div>
            <div class="vu-info-block">
                <h2 class="vu-emp-name">@Model.Employee.PrefixEng @Model.Employee.FirstNameEng @Model.Employee.LastNameEng</h2>
                <p class="vu-emp-code">@Model.Employee.EmpCode</p>
                <div>
                    @if (Model.PromotedSkills != null && Model.PromotedSkills.Count > 0)
                    {
                        <span class="vu-badge promoted"><i class="bi bi-arrow-up-circle-fill"></i> Promoted</span>
                    }
                    @if (Model.IsResigned || Model.Employee?.ResignDate != null || !string.IsNullOrWhiteSpace(Model.Employee?.ResignBy))
                    {
                        <span class="vu-badge resigned"><i class="bi bi-person-x-fill"></i> Resigned</span>
                    }
                    @if ((Model.PromotedSkills == null || Model.PromotedSkills.Count == 0) && !Model.IsResigned && Model.Employee?.ResignDate == null && string.IsNullOrWhiteSpace(Model.Employee?.ResignBy))
                    {
                        <span class="vu-badge active"><i class="bi bi-check-circle-fill"></i> Active</span>
                    }
                </div>
            </div>
            <div class="vu-stats-row">
                <div class="vu-stat-pill orange"><i class="bi bi-award-fill"></i> <span class="vu-stat-num">@(Model.CurrentSkills?.Count ?? 0)</span> Qualified</div>
                <div class="vu-stat-pill red"><i class="bi bi-x-circle-fill"></i> <span class="vu-stat-num">@(Model.DisqualifiedSkills?.Count ?? 0)</span> Disqualified</div>
                <div class="vu-stat-pill amber"><i class="bi bi-arrow-repeat"></i> <span class="vu-stat-num">@(Model.ObsoletedSkills?.Count ?? 0)</span> Obsoleted</div>
                <div class="vu-stat-pill blue"><i class="bi bi-briefcase-fill"></i> @(Model.Employee.JobGrade ?? "-")</div>
                <div class="vu-stat-pill purple"><i class="bi bi-clock"></i> Shift @(Model.Employee.Shift ?? "-")</div>
                <div class="vu-stat-pill slate"><i class="bi bi-calendar-check"></i> @Model.Employee.JoinDate.ToString("dd MMM yyyy")</div>
            </div>
        </div>
        <div class="vu-nav-row">
            <a href="/Dashboard" class="vu-nav-btn vu-nav-btn-back"><i class="bi bi-arrow-left-circle"></i> Back to Dashboard</a>
            @if (isAdmin)
            {
                <a href="/UpdateUser?empCode=@Model.Employee.EmpCode" class="vu-nav-btn vu-nav-btn-update"><i class="bi bi-person-gear"></i> Update Employee</a>
            }
            else
            {
                <span class="vu-nav-btn vu-nav-btn-update disabled"><i class="bi bi-person-gear"></i> Update Employee</span>
            }
            <button type="button" class="vu-nav-btn vu-nav-btn-info" data-bs-toggle="modal" data-bs-target="#levelCriteriaModal">
                <i class="bi bi-info-circle"></i> Level Criteria
            </button>
        </div>
    </div>

    <!-- ── Two-column main grid ── -->
    <div class="vu-main-grid">

    <!-- ── Left column: Employee Information (always visible) ── -->
    <div class="vu-left-col">
    <div class="vu-section">
        <div class="vu-section-hdr" style="cursor:default;">
            <span class="vu-section-icon"><i class="bi bi-person-vcard"></i></span>
            <span class="vu-section-title">Employee Information</span>
        </div>
        <div class="vu-section-body">
                <div class="vu-subsection-label"><i class="bi bi-translate"></i> English Name</div>
                <div class="vu-grid-3">
                    <div class="vu-field">
                        <span class="vu-label">Prefix</span>
                        <span class="vu-value accent">@(Model.Employee.PrefixEng ?? "-")</span>
                    </div>
                    <div class="vu-field">
                        <span class="vu-label">First Name</span>
                        <span class="vu-value">@(Model.Employee.FirstNameEng ?? "-")</span>
                    </div>
                    <div class="vu-field">
                        <span class="vu-label">Last Name</span>
                        <span class="vu-value">@(Model.Employee.LastNameEng ?? "-")</span>
                    </div>
                </div>
                <div class="vu-subsection-label mt-2"><i class="bi bi-globe-asia-australia"></i> Thai Name</div>
                <div class="vu-grid-3">
                    <div class="vu-field">
                        <span class="vu-label">คำนำหน้า</span>
                        <span class="vu-value accent">@(Model.Employee.PrefixThai ?? "-")</span>
                    </div>
                    <div class="vu-field">
                        <span class="vu-label">ชื่อ</span>
                        <span class="vu-value">@(Model.Employee.FirstNameThai ?? "-")</span>
                    </div>
                    <div class="vu-field">
                        <span class="vu-label">นามสกุล</span>
                        <span class="vu-value">@(Model.Employee.LastNameThai ?? "-")</span>
                    </div>
                </div>
                <div class="vu-subsection-label mt-2"><i class="bi bi-diagram-3"></i> Organisation</div>
                <div class="vu-grid-3">
                    <div class="vu-field">
                        <span class="vu-label">Emp. No.</span>
                        <span class="vu-value accent">@Model.Employee.EmpCode</span>
                    </div>
                    <div class="vu-field">
                        <span class="vu-label">Department</span>
                        <span class="vu-value">@(Model.DepartmentName ?? "-")</span>
                    </div>
                    <div class="vu-field">
                        <span class="vu-label">Section</span>
                        <span class="vu-value">@(Model.SectionName ?? "-")</span>
                    </div>
                    <div class="vu-field">
                        <span class="vu-label">Workshop</span>
                        <span class="vu-value">@(Model.WorkshopName ?? "-")</span>
                    </div>
                    <div class="vu-field">
                        <span class="vu-label">Shift</span>
                        <span class="vu-value muted">@(Model.Employee.Shift ?? "-")</span>
                    </div>
                    <div class="vu-field">
                        <span class="vu-label">Job Grade</span>
                        <span class="vu-value"><span class="vu-grade-pill">@(Model.Employee.JobGrade ?? "-")</span></span>
                    </div>
                </div>
                @if (Model.IsResigned || Model.Employee?.ResignDate != null || !string.IsNullOrWhiteSpace(Model.Employee?.ResignBy))
                {
                    <div class="vu-subsection-label mt-2"><i class="bi bi-person-x"></i> Resignation</div>
                    <div class="vu-grid-3">
                        <div class="vu-field">
                            <span class="vu-label">Resigned On</span>
                            <span class="vu-value">@(Model.Employee?.ResignDate?.ToString("dd MMM yyyy") ?? "-")</span>
                        </div>
                        <div class="vu-field">
                            <span class="vu-label">Resigned By</span>
                            <span class="vu-value">@(Model.Employee?.ResignBy ?? "-")</span>
                        </div>
                    </div>
                }
            </div>
    </div>
    </div><!-- /vu-left-col -->

    <!-- ── Right column: Certification & Skills ── -->
    <div class="vu-right-col">

    <!-- ── Certification & Skills ── -->
    <div class="vu-section">
        <div class="vu-section-hdr" style="cursor:default; flex-wrap:wrap; gap:0.5rem;">
            <span class="vu-section-icon"><i class="bi bi-award"></i></span>
            <span class="vu-section-title">Certification & Skills</span>
        </div>
        <div class="vu-section-body">
            <!-- Action controls row -->
            <div style="display:flex; gap:0.4rem; align-items:center; flex-wrap:wrap; margin-bottom:0.75rem;">
                @{ bool blocked = (Model.PromotedSkills != null && Model.PromotedSkills.Count > 0) || Model.IsResigned; }

                @* ── Update Skill ── *@
                @if (isAdmin && !blocked)
                {
                    <button type="button" id="updateSkillBtn" class="btn-sk btn-sk-update" disabled title="Update Skill">
                        <i class="bi bi-pencil"></i> Update Skill
                    </button>
                }
                else if (isAdmin)
                {
                    <button type="button" class="btn-sk btn-sk-update btn-sk-disabled" aria-disabled="true"
                            title="@(Model.IsResigned ? "Employee resigned — action disabled" : "Employee promoted — action disabled")">
                        <i class="bi bi-pencil"></i> Update Skill
                    </button>
                }
                else
                {
                    <button type="button" class="btn-sk btn-sk-update btn-sk-disabled" aria-disabled="true" title="Admin only">
                        <i class="bi bi-pencil"></i> Update Skill
                    </button>
                }

                @* ── Disqualify Selected ── *@
                @if (isAdmin && !blocked)
                {
                    <button type="button" id="disqualifySelectedBtn" class="btn-sk btn-sk-disqualify" disabled title="Disqualify Selected">
                        <i class="bi bi-x-circle"></i> Disqualify Selected
                    </button>
                }
                else if (isAdmin)
                {
                    <button type="button" class="btn-sk btn-sk-disqualify btn-sk-disabled" aria-disabled="true"
                            title="@(Model.IsResigned ? "Employee resigned — action disabled" : "Employee promoted — action disabled")">
                        <i class="bi bi-x-circle"></i> Disqualify Selected
                    </button>
                }
                else
                {
                    <button type="button" class="btn-sk btn-sk-disqualify btn-sk-disabled" aria-disabled="true" title="Admin only">
                        <i class="bi bi-x-circle"></i> Disqualify Selected
                    </button>
                }

                @* ── Add Skill ── *@
                @if (isAdmin && !blocked)
                {
                    <a href="/AddSkill?empCode=@Model.Employee.EmpCode" class="btn-sk btn-sk-add" title="Add Skill">
                        <i class="bi bi-plus-lg"></i> Add Skill
                    </a>
                }
                else if (isAdmin)
                {
                    <span class="btn-sk btn-sk-add btn-sk-disabled"
                          title="@(Model.IsResigned ? "Employee resigned — cannot add skills" : "Employee promoted — cannot add skills")">
                        <i class="bi bi-plus-lg"></i> Add Skill
                    </span>
                }
                else
                {
                    <span class="btn-sk btn-sk-add btn-sk-disabled" title="Admin only">
                        <i class="bi bi-plus-lg"></i> Add Skill
                    </span>
                }

                @* ── Download ── *@
                <a id="btnDownloadTab"
                   href="?handler=DownloadCurrentSkills&empCode=@Model.Employee.EmpCode"
                   class="btn-sk btn-sk-download"
                   onclick="Toast.info('Download', 'Preparing file...');">
                    <i class="bi bi-download"></i>
                    <span id="lblDownloadTab">Download Current Skills</span>
                </a>

                @* ── Fit ── *@
                <button type="button" id="skillFitBtn" class="btn-sk btn-sk-fit" title="Fit all columns to screen without scrolling">
                    <i class="bi bi-arrows-angle-contract"></i> Fit
                </button>
            </div>

            <style>
                /* Fit mode: compress all skill tab tables to viewport width */
                .skill-table-fit {
                    overflow-x: hidden !important;
                }
                .skill-table-fit .table {
                    width: 100% !important;
                    table-layout: fixed !important;
                    font-size: 0.72rem !important;
                    word-break: break-word;
                }
                .skill-table-fit .table th,
                .skill-table-fit .table td {
                    padding: 0.2rem 0.3rem !important;
                    white-space: nowrap !important;
                    overflow: hidden !important;
                    text-overflow: ellipsis !important;
                }
                #skillFitBtn.fit-active {
                    background: #0f172a !important;
                    color: #fff !important;
                    border-color: #0f172a !important;
                }
                #skillFitBtn.fit-active i::before {
                    content: "\F143"; /* bi-arrows-angle-expand */
                }

                /* ── Column-resize handle ── */
                .table th {
                    position: relative;
                    user-select: none;
                    white-space: nowrap;
                }
                .col-resizer {
                    position: absolute;
                    right: 0;
                    top: 0;
                    height: 100%;
                    width: 6px;
                    cursor: col-resize;
                    z-index: 1;
                    background: transparent;
                    transition: background 0.15s;
                }
                .col-resizer:hover,
                .col-resizer.resizing {
                    background: var(--accent, #3b82f6);
                    opacity: 0.55;
                    border-radius: 3px;
                }
                /* While dragging, prevent text selection across the page */
                body.col-resizing * {
                    cursor: col-resize !important;
                    user-select: none !important;
                }
            </style>

            <!-- Tab Navigation (order changed: Current, Disqualified, Obsoleted, Timeline, Promoted, Resigned) -->
            <div class="tabs-container mb-4">
                <button class="tab-btn active" data-tab="current-skill">
                    <i class="bi bi-check-circle"></i> Current Skill <span class="text-success" style="margin-left:0.5rem;">@Model.CurrentSkills.Count</span>
                </button>

                <!-- Disqualified immediately after Current -->
                <button class="tab-btn" data-tab="disqualified">
                    <i class="bi bi-x-circle"></i> Disqualified <span class="text-danger" style="margin-left:0.5rem;">@Model.DisqualifiedSkills.Count</span>
                </button>

                <!-- Obsoleted next -->
                <button class="tab-btn" data-tab="obsoleted">
                    <i class="bi bi-arrow-repeat"></i> Obsoleted <span class="text-warning" style="margin-left:0.5rem;">@Model.ObsoletedSkills.Count</span>
                </button>

                <!-- Timeline moved before Promoted/Resigned -->
                <button class="tab-btn" data-tab="timeline">
                    <i class="bi bi-clock-history"></i> Timeline <span class="text-secondary" style="margin-left:0.5rem;">@((Model.CurrentSkills?.Count ?? 0) + (Model.DisqualifiedSkills?.Count ?? 0) + (Model.ObsoletedSkills?.Count ?? 0) + (Model.PromotedSkills?.Count ?? 0) + (Model.ResignedSkills?.Count ?? 0))</span>
                </button>

                @if (Model.PromotedSkills != null && Model.PromotedSkills.Count > 0)
                {
                    <button class="tab-btn" data-tab="promoted">
                        <i class="bi bi-arrow-up-circle"></i> Promoted <span class="text-success" style="margin-left:0.5rem; font-weight:600;">@Model.PromotedSkills.Count</span>
                    </button>
                }

                @if (Model.ResignedSkills != null && Model.ResignedSkills.Count > 0)
                {
                    <button class="tab-btn" data-tab="resigned">
                        <i class="bi bi-person-x-fill"></i> Resigned <span class="text-danger" style="margin-left:0.5rem; font-weight:600;">@Model.ResignedSkills.Count</span>
                    </button>
                }
            </div>                                         

            <!-- Current Skill Tab -->
            <div class="tab-content active" id="current-skill">
                @if (Model.CurrentSkills != null && Model.CurrentSkills.Count > 0)
                {
                    <form method="post" asp-page-handler="BulkDisqualify" asp-antiforgery="true" id="bulkDisqualifyForm">
                        <input type="hidden" name="empCode" value="@Model.Employee?.EmpCode" />
                        <div class="table-container" style="overflow-x:auto; overflow-y:hidden; -webkit-overflow-scrolling:touch; padding-bottom:8px;">
                            <table class="table" id="currentSkillTable">
                                <thead>
                                    <tr>
                                        <th style="width: 40px;"><input type="checkbox" id="selectAllSkills" class="form-checkbox" /></th>
                                        <th>Process</th>
                                        <th>Classification</th>
                                        <th>Theory</th>
                                        <th>OJT</th>
                                        <th>Result</th>
                                        <th>K</th>
                                        <th>S</th>
                                        <th>Judgment</th>
                                        <th>Certified Date</th>
                                        <th>Expiry Date</th>
                                        <th>Verifier</th>
                                        <th>Remark</th>
                                        <th>Download</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var skill in Model.CurrentSkills)
                                    {
                                        var daysUntilExpiry = skill.ExpiryDate.HasValue ? (skill.ExpiryDate.Value.Date - DateTime.Now.Date).TotalDays : double.NaN;
                                        var highlight10 = !double.IsNaN(daysUntilExpiry) && daysUntilExpiry >= 0 && daysUntilExpiry <= 10;
                                        var highlight30 = !double.IsNaN(daysUntilExpiry) && daysUntilExpiry > 10 && daysUntilExpiry <= 30;
                                        <tr class="@(highlight10 ? "table-expiry-10" : (highlight30 ? "table-expiry-30" : ""))">
                                            <td><input type="checkbox" name="SelectedProcesses" value="@skill.Process" class="skillCheckbox form-checkbox" /></td>
                                            <td><strong>@skill.Process</strong></td>
                                            <td title="@skill.CertifyClassification"><div class="col-cls">@skill.CertifyClassification</div></td>
                                            <td>@(skill.Theory?.ToString("dd MMM yyyy") ?? "-")</td>
                                            <td>@(skill.OJT?.ToString("dd MMM yyyy") ?? "-")</td>
                                            <td>@(string.IsNullOrWhiteSpace(skill.TestResult) ? (string.IsNullOrWhiteSpace(skill.ActualScore) ? "-" : skill.ActualScore) : skill.TestResult)</td>
                                            <td>@skill.K</td>
                                            <td>@skill.S</td>
                                            <td>
                                                @if (skill.Judgment == "Pass")
                                                {
                                                    <span class="jbadge jbadge-pass"><i class="bi bi-check-lg"></i>Pass</span>
                                                }
                                                else if (skill.Judgment == "Fail" || skill.Judgment == "Failed")
                                                {
                                                    <span class="jbadge jbadge-fail"><i class="bi bi-x-lg"></i>@skill.Judgment</span>
                                                }
                                                else
                                                {
                                                    <span class="jbadge jbadge-other">@skill.Judgment</span>
                                                }
                                            </td>
                                            <td>@(skill.CertifiedDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                            <td>@(skill.ExpiryDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                            <td>@(skill.VerifierName ?? skill.Verifier)</td>
                                            <td>@skill.Remark</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(skill.DownloadPath))
                                                {
                                                    var previewUrl = Model.ResolvePublicDownloadUrl(skill.DownloadPath, Model.Employee?.EmpCode ?? "");
                                                    <div class="download-actions" style="display:flex; gap:0.5rem; align-items:center;">
                                                        @if (AdminService.IsAdmin(HttpContext.Session.GetString("UserCode")))
                                                        {
                                                            <a href="@previewUrl" class="btn btn-sm btn-outline-primary" title="Download PDF Certificate" style="padding: 0.25rem 0.5rem; font-size: 0.875rem;" target="_blank" rel="noopener noreferrer" download>
                                                                <i class="bi bi-file-earmark-pdf"></i> PDF
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm btn-outline-primary" disabled title="Admin only" style="padding: 0.25rem 0.5rem; font-size: 0.875rem; opacity:.6; cursor:not-allowed;">
                                                                <i class="bi bi-file-earmark-pdf"></i> PDF
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted" style="font-size: 0.875rem;">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </form>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-clipboard-x empty-state-icon"></i>
                        <h3 class="empty-state-title">No Current Skills</h3>
                        <p class="empty-state-text">This employee has no current skill certifications.</p>
                    </div>
                }
            </div>

<!-- Resigned tab moved below Timeline -->

<!-- Promoted tab moved below Timeline -->

            <!-- Disqualified Tab -->
            <div class="tab-content" id="disqualified">
                @if (Model.DisqualifiedSkills != null && Model.DisqualifiedSkills.Count > 0)
                {
                    <div class="table-container" style="overflow-x:auto; overflow-y:hidden; -webkit-overflow-scrolling:touch; padding-bottom:8px;">
                        <table class="table" id="disqualifiedTable" style="table-layout:fixed; width:100%; min-width:820px;">
                            <colgroup>
                                <col style="width:170px"><!-- Process -->
                                <col style="width:90px"> <!-- Certified Date -->
                                <col style="width:36px"> <!-- K -->
                                <col style="width:36px"> <!-- S -->
                                <col style="width:100px"><!-- Verifier -->
                                <col style="width:100px"><!-- Disqualified Date -->
                                <col style="width:100px"><!-- Disqualified By -->
                                <col style="width:140px"><!-- Reason -->
                                <col>                    <!-- Remark -->
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Process</th>
                                    <th>Certified Date</th>
                                    <th>K</th>
                                    <th>S</th>
                                    <th>Verifier</th>
                                    <th>Disqualified Date</th>
                                    <th>Disqualified By</th>
                                    <th>Reason</th>
                                    <th>Remark</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dq in Model.DisqualifiedSkills)
                                {
                                    <tr style="color: var(--danger);">
                                        <td class="col-proc-td"><strong>@dq.Process</strong></td>
                                        <td>@(dq.CertifiedDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                        <td>@dq.K</td>
                                        <td>@dq.S</td>
                                        <td class="col-cls-td" title="@(dq.VerifierName ?? dq.Verifier)">@(dq.VerifierName ?? dq.Verifier)</td>
                                        <td>@(dq.DisqualifiedDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                        <td class="col-cls-td" title="@dq.DisqualifiedBy">@dq.DisqualifiedBy</td>
                                        <td class="col-cls-td" title="@dq.TheReason">@dq.TheReason</td>
                                        <td>@dq.Remark</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-shield-check empty-state-icon" style="color: var(--success);"></i>
                        <h3 class="empty-state-title">No Disqualified Records</h3>
                        <p class="empty-state-text">This employee has no disqualified skill records.</p>
                    </div>
                }
            </div>

            <!-- Obsoleted Tab -->
            <div class="tab-content" id="obsoleted">
                @if (Model.ObsoletedSkills != null && Model.ObsoletedSkills.Count > 0)
                {
                    <div class="table-container" style="overflow-x:auto; overflow-y:hidden; -webkit-overflow-scrolling:touch; padding-bottom:8px;">
                        <table class="table" id="obsoletedTable" style="table-layout:fixed; width:100%; min-width:920px;">
                            <colgroup>
                                <col style="width:160px"><!-- Process -->
                                <col style="width:140px"><!-- Classification -->
                                <col style="width:88px"> <!-- Theory -->
                                <col style="width:88px"> <!-- OJT -->
                                <col style="width:52px"> <!-- Result -->
                                <col style="width:88px"> <!-- Certified Date -->
                                <col style="width:36px"> <!-- K -->
                                <col style="width:36px"> <!-- S -->
                                <col style="width:72px"> <!-- Judgment -->
                                <col style="width:88px"> <!-- Expiry Date -->
                                <col style="width:80px"> <!-- Verifier -->
                                <col>                    <!-- Remark -->
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Process</th>
                                    <th>Classification</th>
                                    <th>Theory</th>
                                    <th>OJT</th>
                                    <th>Result</th>
                                    <th>Certified Date</th>
                                    <th>K</th>
                                    <th>S</th>
                                    <th>Judgment</th>
                                    <th>Expiry Date</th>
                                    <th>Verifier</th>
                                    <th>Remark</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var obs in Model.ObsoletedSkills)
                                {
                                    var daysUntilExpiry = obs.ExpiryDate.HasValue ? (obs.ExpiryDate.Value.Date - DateTime.Now.Date).TotalDays : double.NaN;
                                    var isExpired = !double.IsNaN(daysUntilExpiry) && daysUntilExpiry < 0;
                                    var highlight10 = !double.IsNaN(daysUntilExpiry) && daysUntilExpiry >= 0 && daysUntilExpiry <= 10;
                                    var highlight30 = !double.IsNaN(daysUntilExpiry) && daysUntilExpiry > 10 && daysUntilExpiry <= 30;
                                    <tr class="table-obsoleted @(isExpired ? "expiry-row-expired" : (highlight10 ? "expiry-row-critical" : (highlight30 ? "expiry-row-soon" : "")))" style="opacity: 0.7;">
                                        <td class="col-proc-td">@obs.Process</td>
                                        <td class="col-cls-td" title="@obs.CertifyClassification">@obs.CertifyClassification</td>
                                        <td>@(obs.Theory?.ToString("dd MMM yyyy") ?? "-")</td>
                                        <td>@(obs.OJT?.ToString("dd MMM yyyy") ?? "-")</td>
                                        <td>@(string.IsNullOrWhiteSpace(obs.Result) ? "-" : obs.Result)</td>
                                        <td>@(obs.CertifiedDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                        <td>@obs.K</td>
                                        <td>@obs.S</td>
                                        <td>
                                            @if (obs.Judgment == "Pass")
                                            {
                                                <span class="jbadge jbadge-pass"><i class="bi bi-check-lg"></i>Pass</span>
                                            }
                                            else if (obs.Judgment == "Fail" || obs.Judgment == "Failed")
                                            {
                                                <span class="jbadge jbadge-fail"><i class="bi bi-x-lg"></i>@obs.Judgment</span>
                                            }
                                            else if (!string.IsNullOrEmpty(obs.Judgment) && obs.Judgment != "-")
                                            {
                                                <span class="jbadge jbadge-other">@obs.Judgment</span>
                                            }
                                            else { <span>-</span> }
                                        </td>
                                        <td>@(obs.ExpiryDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                        <td>@(obs.VerifierName ?? obs.Verifier)</td>
                                        <td>@obs.Remark</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-archive empty-state-icon"></i>
                        <h3 class="empty-state-title">No Obsoleted Records</h3>
                        <p class="empty-state-text">This employee has no obsoleted skill records.</p>
                    </div>
                }
            </div>

            <!-- Timeline Tab -->
            <div class="tab-content" id="timeline">
                @{
                    var timelineItems = new List<dynamic>();
                    
                    // Add current skills
                    foreach (var skill in Model.CurrentSkills ?? new List<EmployeeSkillRecord>())
                    {
                        timelineItems.Add(new {
                            Date = skill.CertifiedDate ?? DateTime.MinValue,
                            Status = "Current",
                            StatusClass = "timeline-current",
                            Icon = "bi-check-circle-fill",
                            Process = skill.Process,
                            Classification = skill.CertifyClassification,
                            Theory = skill.Theory,
                            OJT = skill.OJT,
                            K = skill.K,
                            S = skill.S,
                            Judgment = skill.Judgment,
                            CertifiedDate = skill.CertifiedDate,
                            ExpiryDate = skill.ExpiryDate,
                            Verifier = skill.VerifierName ?? skill.Verifier,
                            Remark = skill.Remark,
                            Type = "current"
                        });
                    }
                    
                    // Add promoted skills (from tblQualified marked with [PROMOTED])
                    foreach (var skill in Model.PromotedSkills ?? new List<EmployeeSkillRecord>())
                    {
                        timelineItems.Add(new {
                            Date = skill.CertifiedDate ?? DateTime.MinValue,
                            Status = "Promoted",
                            StatusClass = "timeline-promoted",
                            Icon = "bi-arrow-up-circle",
                            Process = skill.Process,
                            Classification = skill.CertifyClassification,
                            Theory = skill.Theory,
                            OJT = skill.OJT,
                            K = skill.K,
                            S = skill.S,
                            Judgment = skill.Judgment,
                            CertifiedDate = skill.CertifiedDate,
                            ExpiryDate = skill.ExpiryDate,
                            Verifier = skill.VerifierName ?? skill.Verifier,
                            Remark = skill.Remark,
                            Type = "promoted"
                        });
                    }
                    
                    // Add disqualified skills
                    foreach (var skill in Model.DisqualifiedSkills ?? new List<EmployeeDisqualifiedRecord>())
                    {
                        timelineItems.Add(new {
                            Date = skill.DisqualifiedDate ?? skill.CertifiedDate ?? DateTime.MinValue,
                            Status = "Disqualified",
                            StatusClass = "timeline-disqualified",
                            Icon = "bi-x-circle-fill",
                            Process = skill.Process,
                            Classification = "-",
                            Theory = (DateTime?)null,
                            OJT = (DateTime?)null,
                            K = skill.K,
                            S = skill.S,
                            Judgment = "-",
                            CertifiedDate = skill.CertifiedDate,
                            ExpiryDate = (DateTime?)null,
                            Verifier = skill.VerifierName ?? skill.Verifier,
                            Remark = skill.TheReason ?? skill.Remark,
                            Type = "disqualified",
                            DisqualifiedDate = skill.DisqualifiedDate,
                            DisqualifiedBy = skill.DisqualifiedBy
                        });
                    }
                    
                    // Add obsoleted skills
                    foreach (var skill in Model.TimelineObsoletedSkills ?? new List<EmployeeObsoletedRecord>())
                    {
                        timelineItems.Add(new {
                            Date = skill.ExpiryDate ?? skill.CertifiedDate ?? DateTime.MinValue,
                            Status = "Obsoleted",
                            StatusClass = "timeline-obsoleted",
                            Icon = "bi-arrow-repeat",
                            Process = skill.Process,
                            Classification = skill.CertifyClassification,
                            Theory = skill.Theory,
                            OJT = skill.OJT,
                            K = skill.K,
                            S = skill.S,
                            Judgment = skill.Judgment,
                            CertifiedDate = skill.CertifiedDate,
                            ExpiryDate = skill.ExpiryDate,
                            Verifier = skill.VerifierName ?? skill.Verifier,
                            Remark = skill.Remark,
                            Type = "obsoleted"
                        });
                    }
                    
                    // Sort by status priority (Current first), then by date descending
                    var sortedTimeline = timelineItems
                        .OrderBy(x => x.Status == "Current" ? 0 : x.Status == "Disqualified" ? 1 : 2)
                        .ThenByDescending(x => x.Date)
                        .ToList();
                }
                
                @if (sortedTimeline.Any())
                {
                    <div class="timeline-container" id="timelineContainer">
                        @{
                            var itemIndex = 0;
                        }
                        @foreach (var item in sortedTimeline)
                        {
                            var isLeft = itemIndex % 2 == 0;
                            var delay = itemIndex * 80;
                            <div class="timeline-item @(isLeft ? "timeline-left" : "timeline-right") @item.StatusClass" style="--tl-delay:@(delay)ms">
                                <div class="timeline-date-box">
                                    @if (item.Date != DateTime.MinValue)
                                    {
                                        <div class="date-month">@item.Date.ToString("MMM")</div>
                                        <div class="date-day">@item.Date.ToString("dd")</div>
                                        <div class="date-year">@item.Date.ToString("yyyy")</div>
                                    }
                                </div>
                                <div class="timeline-marker">
                                    <div class="timeline-dot"></div>
                                </div>
                                <div class="timeline-content">
                                    <div class="timeline-header">
                                        <h4 class="timeline-title">@item.Process</h4>
                                        <span class="timeline-badge @(item.Status == "Current" ? "badge-success" : item.Status == "Disqualified" ? "badge-danger" : "badge-secondary")">@item.Status</span>
                                    </div>
                                    <div class="timeline-body">
                                        <div class="timeline-grid">
                                            <div class="timeline-field">
                                                <label>Classification:</label>
                                                <span>@(item.Classification ?? "-")</span>
                                            </div>
                                            @if (item.Type != "disqualified")
                                            {
                                                <div class="timeline-field">
                                                    <label>Theory:</label>
                                                    <span>@(item.Theory?.ToString("dd MMM yyyy") ?? "-")</span>
                                                </div>
                                                <div class="timeline-field">
                                                    <label>OJT:</label>
                                                    <span>@(item.OJT?.ToString("dd MMM yyyy") ?? "-")</span>
                                                </div>
                                            }
                                            <div class="timeline-field">
                                                <label>K:</label>
                                                <span>@(item.K ?? "-")</span>
                                            </div>
                                            <div class="timeline-field">
                                                <label>S:</label>
                                                <span>@(item.S ?? "-")</span>
                                            </div>
                                            @if (item.Type != "disqualified")
                                            {
                                                <div class="timeline-field timeline-field-highlight">
                                                    <label>Judgment:</label>
                                                    <span>@(item.Judgment ?? "-")</span>
                                                </div>
                                            }
                                            @if (item.Type == "current" || item.Type == "obsoleted")
                                            {
                                                <div class="timeline-field">
                                                    <label>Certified Date:</label>
                                                    <span>@(item.CertifiedDate?.ToString("dd MMM yyyy") ?? "-")</span>
                                                </div>
                                                <div class="timeline-field">
                                                    <label>Expiry Date:</label>
                                                    <span>@(item.ExpiryDate?.ToString("dd MMM yyyy") ?? "-")</span>
                                                </div>
                                            }
                                            @if (item.Type == "disqualified")
                                            {
                                                <div class="timeline-field">
                                                    <label>Disqualified Date:</label>
                                                    <span>@(item.DisqualifiedDate?.ToString("dd MMM yyyy") ?? "-")</span>
                                                </div>
                                                <div class="timeline-field">
                                                    <label>Disqualified By:</label>
                                                    <span>@(item.DisqualifiedBy ?? "-")</span>
                                                </div>
                                            }
                                            <div class="timeline-field timeline-field-highlight">
                                                <label>Verifier:</label>
                                                <span>@(item.Verifier ?? "-")</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(item.Remark))
                                            {
                                                <div class="timeline-field timeline-field-full">
                                                    <label>Remark:</label>
                                                    <span>@item.Remark</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            itemIndex++;
