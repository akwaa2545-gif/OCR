                                e.preventDefault();
                                e.stopPropagation();
                                var c = lvl.querySelector('.modal-content');
                                if(c) c.classList.add('closing');
                                setTimeout(function(){
                                    var inst = bootstrap.Modal.getInstance(lvl);
                                    if(inst) inst.hide();
                                }, 240);
                            });
