        height: 1.1rem;
        cursor: pointer;
    }
    /* Make Disqualified table text clearly red; keep header black for readability */
    #disqualified .table th {
        color: #000 !important;
        font-weight: 400 !important;
    }
    #disqualified .table td,
    #disqualified .table {
        color: var(--danger) !important;
    }
    #disqualified .table tr { color: var(--danger) !important; }
</style>
}

@section Scripts {
<script>
    // ── Dynamic download button ──────────────────────────────────────
    const _empCode = '@Model.Employee?.EmpCode';
    const _tabDownloadMap = {
        'current-skill':  { label: 'Download Current Skills',  handler: 'DownloadCurrentSkills'  },
        'disqualified':   { label: 'Download Disqualified',     handler: 'DownloadDisqualifiedSkills' },
        'obsoleted':      { label: 'Download Obsoleted',        handler: 'DownloadObsoletedSkills' },
        'promoted':       { label: 'Download Promoted',         handler: 'DownloadPromotedSkills'  },
        'resigned':       { label: 'Download Resigned',         handler: 'DownloadResignedSkills'  },
    };
    function updateDownloadBtn(tabId) {
        const btn = document.getElementById('btnDownloadTab');
        const lbl = document.getElementById('lblDownloadTab');
        if (!btn || !lbl) return;
        const cfg = _tabDownloadMap[tabId];
        if (cfg) {
            btn.href = `?handler=${cfg.handler}&empCode=${_empCode}`;
            lbl.textContent = cfg.label;
            btn.style.display = '';
        } else {
            // Timeline tab — hide download button
            btn.style.display = 'none';
        }
        // Re-apply selection-based URL if checkboxes are already checked
        if (tabId !== 'current-skill') return;
        const checkboxes = document.querySelectorAll('.skillCheckbox');
        const checked = Array.from(checkboxes).filter(cb => cb.checked);
        if (checked.length > 0) {
            const params = checked.map(cb => 'process=' + encodeURIComponent(cb.value)).join('&');
            btn.href = '?handler=DownloadCurrentSkills&empCode=' + _empCode + '&' + params;
            lbl.textContent = 'Download Selected (' + checked.length + ')';
        }
    }
    // Init on load
    updateDownloadBtn('current-skill');

    // ── Toggle level criteria inline panel ────────────────────────────────
    function toggleLevelCriteria() {
        const panel = document.getElementById('levelCriteriaCollapse');
        const btn   = document.getElementById('btnToggleLevelCriteria');
        const lbl   = document.getElementById('lblToggleLevelCriteria');
        if (!panel) return;
        const isHidden = panel.style.maxHeight === '0px';
        if (isHidden) {
            panel.style.maxHeight = '800px';
            panel.style.opacity   = '1';
            if (btn) btn.classList.remove('collapsed');
            if (lbl) lbl.textContent = 'Hide Criteria';
        } else {
            panel.style.maxHeight = '0px';
            panel.style.opacity   = '0';
            if (btn) btn.classList.add('collapsed');
            if (lbl) lbl.textContent = 'Show Criteria';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Auto-collapse left sidebar for focused view pages
        try { document.querySelector('.app-container')?.classList.add('sidebar-collapsed'); } catch (e) { }
        // Tab switching
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabContents = document.querySelectorAll('.tab-content');

        tabBtns.forEach(btn => {
            btn.addEventListener('click', function () {
                const tabId = this.dataset.tab;
                tabBtns.forEach(b => b.classList.remove('active'));
                tabContents.forEach(c => c.classList.remove('active'));
                this.classList.add('active');
                updateDownloadBtn(tabId);
                const tabEl = document.getElementById(tabId);
                if (tabEl) {
                    tabEl.classList.add('active');
                } else {
                    console.warn('Missing tab-content for tab:', tabId);
                }
                // Timeline entrance animation — triggered after active class is applied
                if (tabId === 'timeline') {
                    requestAnimationFrame(function () {
                        document.querySelectorAll('#timeline .timeline-item').forEach(function (el) {
                            el.classList.remove('tl-animate');
                            void el.offsetWidth;
                            el.classList.add('tl-animate');
                        });
                    });
                }
            });
        });

        // Fit-mode toggle: compress skill tab tables to fit viewport without scrolling
        (function(){
            const fitBtn = document.getElementById('skillFitBtn');
            if (!fitBtn) return;
            let fitOn = false;
            fitBtn.addEventListener('click', function(){
                fitOn = !fitOn;
                document.querySelectorAll('#current-skill .table-container, #disqualified .table-container, #obsoleted .table-container')
                    .forEach(function(tc){ tc.classList.toggle('skill-table-fit', fitOn); });
                fitBtn.classList.toggle('fit-active', fitOn);
                const icon = fitBtn.querySelector('i');
                const label = fitBtn.querySelector('span');
                if (fitOn) {
                    if (icon) { icon.className = 'bi bi-arrows-angle-expand'; icon.style.fontSize = '1rem'; }
                    if (label) label.textContent = 'Unfit';
                    fitBtn.title = 'Restore scrollable table view';
                } else {
                    if (icon) { icon.className = 'bi bi-arrows-angle-contract'; icon.style.fontSize = '1rem'; }
                    if (label) label.textContent = 'Fit';
                    fitBtn.title = 'Fit all columns to screen without scrolling';
                }
            });
        })();

        // Checkbox handling
        const selectAll = document.getElementById('selectAllSkills');
        const checkboxes = document.querySelectorAll('.skillCheckbox');
        const disBtn = document.getElementById('disqualifySelectedBtn');
        const updateBtn = document.getElementById('updateSkillBtn');
        const isAdmin = @((isAdmin) ? "true" : "false");

        function updateDownloadForSelection() {
            const btn = document.getElementById('btnDownloadTab');
            const lbl = document.getElementById('lblDownloadTab');
            if (!btn || !lbl) return;
            const checked = Array.from(checkboxes).filter(cb => cb.checked);
            if (checked.length > 0) {
                const params = checked.map(cb => 'process=' + encodeURIComponent(cb.value)).join('&');
                btn.href = '?handler=DownloadCurrentSkills&empCode=' + _empCode + '&' + params;
                lbl.textContent = 'Download Selected (' + checked.length + ')';
            } else {
                btn.href = '?handler=DownloadCurrentSkills&empCode=' + _empCode;
                lbl.textContent = 'Download Current Skills';
            }
        }

        function updateButtonStates() {
            const checked = Array.from(checkboxes).filter(cb => cb.checked);
            const anyChecked = checked.length > 0;
            const exactlyOne = checked.length === 1;
            if (disBtn) disBtn.disabled = !(anyChecked && isAdmin);
            if (updateBtn) updateBtn.disabled = !(exactlyOne && isAdmin);
            updateDownloadForSelection();
        }

        if (selectAll) {
            selectAll.addEventListener('change', function () {
                checkboxes.forEach(cb => cb.checked = selectAll.checked);
                updateButtonStates();
            });
        }

        checkboxes.forEach(cb => cb.addEventListener('change', updateButtonStates));

        // Update Skill button
        if (updateBtn) {
            updateBtn.addEventListener('click', function () {
                const checked = Array.from(checkboxes).filter(cb => cb.checked);
                if (checked.length === 1) {
                    const processName = encodeURIComponent(checked[0].value);
                    const empCode = '@Model.Employee?.EmpCode';
                    window.location.href = `/UpdateSkill?empCode=${empCode}&processName=${processName}`;
                }
            });
        }

        // Disqualify Selected button: open modal only when clicked (and at least one checkbox selected)
        if (disBtn) {
            disBtn.addEventListener('click', function () {
                const checked = Array.from(checkboxes).filter(cb => cb.checked);
                if (checked.length === 0) {
                    if (window.Toast && typeof Toast.info === 'function') {
                        Toast.info('Please select at least one skill to disqualify.');
                    } else {
                        alert('Please select at least one skill to disqualify.');
                    }
                    return;
                }
                const modalEl = document.getElementById('bulkDisqualifyModal');
                if (!modalEl) return;

                // If Bootstrap's JS is available, use its Modal API. Otherwise fallback to a simple show/hide.
                try {
                    if (window.bootstrap && typeof bootstrap.Modal === 'function') {
                        const modal = new bootstrap.Modal(modalEl);
                        modal.show();
                        return;
                    }
                } catch (e) {
                    // ignore and fallback
                }

                // Fallback: toggle .show and create a backdrop
                modalEl.classList.add('show');
                modalEl.style.display = 'flex';
                // ensure fallback modal is positioned above the backdrop and is interactive
                modalEl.style.position = 'fixed';
                modalEl.style.inset = '0';
                modalEl.style.justifyContent = 'center';
                modalEl.style.alignItems = 'center';
                modalEl.style.zIndex = '1071';
                modalEl.style.pointerEvents = 'auto';

                let backdrop = document.querySelector('.modal-backdrop.custom-backdrop');
                if (!backdrop) {
                    backdrop = document.createElement('div');
                    backdrop.className = 'modal-backdrop custom-backdrop show';
                    document.body.appendChild(backdrop);
                } else {
                    backdrop.classList.add('show');
                }

                // Close handlers for fallback
                function closeFallback() {
                    modalEl.classList.remove('show');
                    modalEl.style.display = 'none';
                    if (backdrop && backdrop.parentNode) backdrop.parentNode.removeChild(backdrop);
                }

                // wire close buttons inside modal
                modalEl.querySelectorAll('[data-bs-dismiss], .btn-close').forEach(btn => {
                    btn.addEventListener('click', closeFallback, { once: true });
                });

                // clicking backdrop should also close
                backdrop.addEventListener('click', closeFallback, { once: true });
            });
        }

        // Show/hide leave sub-reasons when option 2 is selected
        const leaveDetails = document.getElementById('leaveDetails');
        const bulkReasonRadios = document.querySelectorAll('input[name="BulkReason"]');
        function updateLeaveDetails() {
            const current = document.querySelector('input[name="BulkReason"]:checked');
            if (!current) return;
            if (current.id === 'bulkReason2') {
                if (leaveDetails) leaveDetails.style.display = 'block';
            } else {
                if (leaveDetails) leaveDetails.style.display = 'none';
            }
        }
        bulkReasonRadios.forEach(r => r.addEventListener('change', updateLeaveDetails));
        // initial state
        updateLeaveDetails();

        // Bulk disqualify confirm
        const confirmBtn = document.getElementById('confirmBulkDisqualify');
        if (confirmBtn) {
            confirmBtn.addEventListener('click', function () {
                const form = document.getElementById('bulkDisqualifyForm');
                if (!form) return;

                // remove any previously cloned inputs
                form.querySelectorAll('input[name="SelectedProcesses"][data-cloned]').forEach(el => el.remove());

                const selected = Array.from(checkboxes).filter(cb => cb.checked).map(cb => (cb.value || '').trim()).filter(v => v !== '');
                if (selected.length === 0) return;

                // append selected process hidden inputs
                selected.forEach(proc => {
                    const inp = document.createElement('input');
                    inp.type = 'hidden';
                    inp.name = 'SelectedProcesses';
                    inp.value = proc;
                    inp.setAttribute('data-cloned', '1');
                    form.appendChild(inp);
                });

                // append reason
                const reason = (document.querySelector('input[name="BulkReason"]:checked')?.value || '').trim();
                form.querySelectorAll('input[name="BulkReason"][data-cloned]').forEach(el => el.remove());
                const rInp = document.createElement('input');
                rInp.type = 'hidden';
                rInp.name = 'BulkReason';
                rInp.value = reason;
                rInp.setAttribute('data-cloned', '1');
                form.appendChild(rInp);

                // append sub-reason if present and visible
                const sub = (document.querySelector('input[name="BulkSubReason"]:checked')?.value || '').trim();
                form.querySelectorAll('input[name="BulkSubReason"][data-cloned]').forEach(el => el.remove());
                if (sub !== '') {
                    const sInp = document.createElement('input');
                    sInp.type = 'hidden';
                    sInp.name = 'BulkSubReason';
                    sInp.value = sub;
                    sInp.setAttribute('data-cloned', '1');
                    form.appendChild(sInp);
                }

                // disable button to prevent double submit and show toast
                confirmBtn.disabled = true;
                if (window.Toast && typeof Toast.info === 'function') Toast.info('Disqualify', 'Submitting disqualification...');

                // close modal politely if Bootstrap present
                try {
                    const modalEl = document.getElementById('bulkDisqualifyModal');
                    if (window.bootstrap && typeof bootstrap.Modal === 'function' && modalEl) {
                        const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                        modal.hide();
                    }
                } catch (e) { }

                // submit
                form.submit();
            });
        }

        // Image preview modal (with Bootstrap + JS fallback)
        const empPhoto = document.getElementById('employeePhoto');
        const previewImg = document.getElementById('imagePreviewSrc');
        const imageModalEl = document.getElementById('imagePreviewModal');
        if (empPhoto && previewImg && imageModalEl) {
            function showImagePreview(src) {
                previewImg.src = src;
                try {
                    if (window.bootstrap && typeof bootstrap.Modal === 'function') {
                        const modal = new bootstrap.Modal(imageModalEl);
                        modal.show();
                        return;
                    }
                } catch (e) { /* fall through to fallback */ }

                // Fallback: show modal manually and add backdrop
                imageModalEl.classList.add('show');
                // lock body scroll while modal open
                try { document.body.style.overflow = 'hidden'; } catch (e) {}
                // Use flex centering for modal container so dialog centers properly
                imageModalEl.style.display = 'flex';
                imageModalEl.style.position = 'fixed';
                imageModalEl.style.inset = '0';
                imageModalEl.style.justifyContent = 'center';
                imageModalEl.style.alignItems = 'center';
                imageModalEl.style.zIndex = '1060';

                let backdrop = document.querySelector('.modal-backdrop.custom-backdrop');
                if (!backdrop) {
                    backdrop = document.createElement('div');
                    backdrop.className = 'modal-backdrop custom-backdrop show';
                    // ensure backdrop covers viewport
                    backdrop.style.position = 'fixed';
                    backdrop.style.inset = '0';
                    backdrop.style.background = 'rgba(0,0,0,0.6)';
                    backdrop.style.zIndex = '1050';
                    document.body.appendChild(backdrop);
                } else {
                    backdrop.classList.add('show');
                }

                // constrain preview image to viewport to avoid internal scrollbars
                if (previewImg) {
                    previewImg.style.maxHeight = '90vh';
                    previewImg.style.maxWidth = '90vw';
                    previewImg.style.objectFit = 'contain';
                    previewImg.style.display = 'inline-block';
                }

                function closeFallback() {
                    imageModalEl.classList.remove('show');
                    imageModalEl.style.display = 'none';
                    imageModalEl.style.position = '';
                    imageModalEl.style.inset = '';
                    imageModalEl.style.justifyContent = '';
                    imageModalEl.style.alignItems = '';
                    imageModalEl.style.zIndex = '';
                    try { document.body.style.overflow = ''; } catch (e) {}
                    if (backdrop && backdrop.parentNode) backdrop.parentNode.removeChild(backdrop);
                }

                // wire close buttons inside modal
                imageModalEl.querySelectorAll('[data-bs-dismiss], .btn-close, .btn-secondary').forEach(btn => {
                    btn.addEventListener('click', closeFallback, { once: true });
                });

                // clicking backdrop should also close
                backdrop.addEventListener('click', closeFallback, { once: true });

                // ESC to close
                function escHandler(e) { if (e.key === 'Escape') { closeFallback(); document.removeEventListener('keydown', escHandler); } }
                document.addEventListener('keydown', escHandler);
            }

            empPhoto.addEventListener('click', function () {
                const src = empPhoto.getAttribute('src') || empPhoto.dataset.src;
                if (!src) return;
                showImagePreview(src);
            });

            // allow keyboard activation (Enter / Space)
            empPhoto.addEventListener('keydown', function (ev) {
                const key = ev.key || ev.code || ev.which;
                if (key === 'Enter' || key === ' ' || key === 'Spacebar') {
                    ev.preventDefault();
                    empPhoto.click();
                }
            });
        }

        // --- PDF Preview handlers ---
        // Create references to modal elements (modal markup is in page below)
        const pdfModalEl = document.getElementById('pdfPreviewModal');
        const pdfIframe = document.getElementById('pdfPreviewIframe');
        const pdfSpinner = document.getElementById('pdfPreviewSpinner');
        const pdfDownloadLink = document.getElementById('pdfDownloadLink');

        function showPdfPreview(src) {
            if (!pdfModalEl || !pdfIframe) return;
            if (pdfSpinner) pdfSpinner.style.display = 'flex';
            pdfIframe.src = src;
            if (pdfDownloadLink) {
                pdfDownloadLink.href = src;
                pdfDownloadLink.style.display = '';
            }

            try {
                if (window.bootstrap && typeof bootstrap.Modal === 'function') {
                    const modal = new bootstrap.Modal(pdfModalEl);
                    modal.show();
                    pdfIframe.onload = function () { if (pdfSpinner) pdfSpinner.style.display = 'none'; };
                    return;
                }
            } catch (e) { /* fallback */ }

            pdfModalEl.classList.add('show');
            try { document.body.style.overflow = 'hidden'; } catch (e) {}
            pdfModalEl.style.display = 'flex';
            pdfModalEl.style.position = 'fixed';
            pdfModalEl.style.inset = '0';
            pdfModalEl.style.justifyContent = 'center';
            pdfModalEl.style.alignItems = 'center';
            pdfModalEl.style.zIndex = '1060';
            pdfModalEl.style.pointerEvents = 'auto';
            pdfModalEl.focus();
      

            let backdrop = document.querySelector('.modal-backdrop.custom-backdrop');
            if (!backdrop) {
                backdrop = document.createElement('div');
                backdrop.className = 'modal-backdrop custom-backdrop show';
                backdrop.style.position = 'fixed';
                backdrop.style.inset = '0';
                backdrop.style.background = 'rgba(0,0,0,0.6)';
                backdrop.style.zIndex = '1050';
                document.body.appendChild(backdrop);
            } else {
                backdrop.classList.add('show');
            }

            function closePdfFallback() {
                pdfModalEl.classList.remove('show');
                pdfModalEl.style.display = 'none';
                pdfModalEl.style.position = '';
                pdfModalEl.style.inset = '';
                pdfModalEl.style.justifyContent = '';
                pdfModalEl.style.alignItems = '';
                pdfModalEl.style.zIndex = '';
                try { document.body.style.overflow = ''; } catch (e) {}
                if (backdrop && backdrop.parentNode) backdrop.parentNode.removeChild(backdrop);
                if (pdfIframe) pdfIframe.src = '';
                if (pdfSpinner) pdfSpinner.style.display = 'none';
            }

            pdfModalEl.querySelectorAll('[data-bs-dismiss], .btn-close, .btn-secondary').forEach(btn => {
                btn.addEventListener('click', closePdfFallback, { once: true });
            });

            backdrop.addEventListener('click', closePdfFallback, { once: true });

            pdfIframe.onload = function () { if (pdfSpinner) pdfSpinner.style.display = 'none'; };
        }

        // ── Show server-side message as Toast (disqualify result, AddSkill/UpdateSkill redirect) ──
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <text>
        (function () {
            var msg = '@Html.Raw(Model.Message.Replace("'", "\\'"))';
            var type = '@Model.MessageType';
            if (msg && window.Toast) {
                if (type === 'success') window.Toast.success('Success', msg);
                else window.Toast.error('Error', msg);
            }
        })();
            </text>
        }

        // ── Resizable column headers for all skill-tab tables ──
        (function () {
            // Selector: all tables inside the 5 skill tab containers
            const SKILL_TABS = ['#current-skill', '#disqualified', '#obsoleted', '#promoted', '#resigned'];
            const tables = document.querySelectorAll(
                SKILL_TABS.map(s => s + ' table.table').join(', ')
            );

            tables.forEach(function (table) {
                // Switch to fixed layout so explicit widths are honoured
                table.style.tableLayout = 'fixed';

                const ths = table.querySelectorAll('thead tr:first-child th');
                ths.forEach(function (th) {
                    // Freeze current rendered width as inline style
                    th.style.width = th.offsetWidth + 'px';
                    th.style.overflow = 'hidden';
                    th.style.textOverflow = 'ellipsis';

                    // Native tooltip so full text is always accessible on hover
                    if (!th.title) th.title = th.textContent.trim();

                    // Append drag handle
                    const resizer = document.createElement('span');
                    resizer.className = 'col-resizer';
                    th.appendChild(resizer);

                    // ── drag state ──
                    let startX = 0;
                    let startW = 0;

                    resizer.addEventListener('mousedown', function (e) {
                        e.preventDefault();
                        startX = e.clientX;
                        startW = th.offsetWidth;
                        resizer.classList.add('resizing');
                        document.body.classList.add('col-resizing');

                        function onMove(ev) {
                            const newW = Math.max(40, startW + (ev.clientX - startX));
                            th.style.width = newW + 'px';
                        }

                        function onUp() {
                            resizer.classList.remove('resizing');
                            document.body.classList.remove('col-resizing');
                            document.removeEventListener('mousemove', onMove);
                            document.removeEventListener('mouseup', onUp);
                        }

                        document.addEventListener('mousemove', onMove);
                        document.addEventListener('mouseup', onUp);
                    });

                    // Double-click: auto-fit column to widest cell content
                    resizer.addEventListener('dblclick', function (e) {
                        e.stopPropagation();
                        const colIndex = Array.from(th.parentElement.children).indexOf(th);
                        let maxW = 0;
                        // measure header text
                        const tmpCanvas = document.createElement('canvas');
                        const ctx = tmpCanvas.getContext('2d');
                        if (ctx) {
                            const cs = window.getComputedStyle(th);
                            ctx.font = cs.fontWeight + ' ' + cs.fontSize + ' ' + cs.fontFamily;
                            // header (minus resizer span text)
                            const headerText = Array.from(th.childNodes)
                                .filter(n => n.nodeType === Node.TEXT_NODE)
                                .map(n => n.textContent).join('').trim() ||
                                th.textContent.replace(th.querySelector('.col-resizer')?.textContent || '', '').trim();
                            maxW = Math.max(maxW, ctx.measureText(headerText).width + 24);
                            // all body cells in this column
                            const rows = table.querySelectorAll('tbody tr');
                            rows.forEach(function (row) {
                                const cell = row.cells[colIndex];
                                if (cell) {
                                    const text = cell.textContent.trim();
                                    const w = ctx.measureText(text).width + 20;
                                    if (w > maxW) maxW = w;
                                }
                            });
                        }
                        if (maxW > 0) th.style.width = Math.min(maxW, 400) + 'px';
                    });
                });
            });
        })();

    });
</script>
}
