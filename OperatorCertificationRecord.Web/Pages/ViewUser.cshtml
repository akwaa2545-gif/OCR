                    {
                        <a id="pdfDownloadLink" class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer" style="display:inline-block;"><i class="bi bi-file-earmark-pdf"></i> Open in New Tab</a>
                    }
                    <button type="button" class="btn btn-secondary btn-lg" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}
else
{
