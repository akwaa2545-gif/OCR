@page
@model OperatorCertificationRecord.Web.Pages.Reports.AnalyzerModel
@{
    ViewData["Title"] = "Report Analyzer";
    ViewData["ActivePage"] = "Analyzer";
}

<!-- Hero Banner -->
<div class="anlz-hero">
    <div class="anlz-hero-info">
        <div class="anlz-hero-badge"><i class="bi bi-bar-chart-fill"></i> Report Analyzer</div>
        <h1 class="anlz-hero-title">Advanced Report Analyzer</h1>
        <p class="anlz-hero-sub">Interactive data analysis with multiple chart types, trends, and real-time insights</p>
    </div>
    <div class="anlz-hero-actions">
        <a class="anlz-back-btn" href="/Dashboard"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="anlz-kpi-row" id="kpiSummary">
    <div class="anlz-kpi-card anlz-kpi-primary">
        <div class="anlz-kpi-icon"><i class="bi bi-people-fill"></i></div>
        <div class="anlz-kpi-content">
            <div class="anlz-kpi-value" id="kpiTotalEmployees">--</div>
            <div class="anlz-kpi-label">Total Employees</div>
        </div>
        <div class="kpi-trend kpi-trend-up" id="kpiTrendEmployees" style="display:none">
            <i class="bi bi-arrow-up"></i> <span>0%</span>
        </div>
    </div>
    <div class="anlz-kpi-card anlz-kpi-success">
        <div class="anlz-kpi-icon"><i class="bi bi-award-fill"></i></div>
        <div class="anlz-kpi-content">
            <div class="anlz-kpi-value" id="kpiCertified">--</div>
            <div class="anlz-kpi-label">Certified Records</div>
        </div>
        <div class="kpi-trend kpi-trend-up" id="kpiTrendCertified" style="display:none">
            <i class="bi bi-arrow-up"></i> <span>0%</span>
        </div>
    </div>
    <div class="anlz-kpi-card anlz-kpi-warning">
        <div class="anlz-kpi-icon"><i class="bi bi-clock-fill"></i></div>
        <div class="anlz-kpi-content">
            <div class="anlz-kpi-value" id="kpiExpiring">--</div>
            <div class="anlz-kpi-label">Expiring (30 days)</div>
        </div>
        <div class="kpi-badge">Attention</div>
    </div>
    <div class="anlz-kpi-card anlz-kpi-danger">
        <div class="anlz-kpi-icon"><i class="bi bi-x-circle-fill"></i></div>
        <div class="anlz-kpi-content">
            <div class="anlz-kpi-value" id="kpiDisqualified">--</div>
            <div class="anlz-kpi-label">Disqualified</div>
        </div>
        <div class="kpi-trend kpi-trend-down" id="kpiTrendDisqualified" style="display:none">
            <i class="bi bi-arrow-down"></i> <span>0%</span>
        </div>
    </div>
</div>

<div class="anlz-layout" style="display:flex !important;flex-direction:row !important;flex-wrap:nowrap !important;gap:1.25rem;align-items:flex-start;width:100%;">
    <!-- LEFT: Config Panel -->
    <div class="anlz-panel anlz-panel-left" style="flex:1 1 0 !important;min-width:0 !important;">
        @if(TempData["Message"] != null){
            <div class="alert alert-@(TempData["MessageType"] ?? "info") mb-3" role="alert">@TempData["Message"]</div>
        }
        @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "analyzerForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="anlz-section-label"><i class="bi bi-sliders"></i> Analysis Configuration</div>

            <div class="anlz-field-grid" style="grid-template-columns:1fr 1fr;">
                        <div>
                            <label class="form-label">Group By (multi)</label>
                            <div class="multi-dropdown" data-target="groupby">
                                <div class="multi-dropdown-header" role="button" tabindex="0">
                                    <span class="label">Select grouping</span>
                                    <span class="summary">Month</span>
                                    <span class="caret">▾</span>
                                </div>
                                <div class="multi-dropdown-panel" style="display:none;">
                                    <div style="padding:0.25rem 0.5rem;border-bottom:1px solid #eef2f7;display:flex;gap:0.5rem;align-items:center;">
                                        <button type="button" class="btn btn-sm btn-link select-all">Select all</button>
                                        <button type="button" class="btn btn-sm btn-link clear-all">Clear</button>
                                    </div>
                                    <div class="multiselect-list" style="padding:0.5rem;max-height:240px;overflow:auto;">
                                        <div class="category"><strong>Time Period</strong></div>
                                        <label class="list-item"><input type="checkbox" name="GroupBy" value="Month" @Html.Raw(Model.GroupBy?.Contains("Month") == true ? "checked" : "") /> <span>Month</span></label>
                                        <label class="list-item"><input type="checkbox" name="GroupBy" value="Week" @Html.Raw(Model.GroupBy?.Contains("Week") == true ? "checked" : "") /> <span>Week</span></label>
                                        <label class="list-item"><input type="checkbox" name="GroupBy" value="Day" @Html.Raw(Model.GroupBy?.Contains("Day") == true ? "checked" : "") /> <span>Day</span></label>
                                        <label class="list-item"><input type="checkbox" name="GroupBy" value="Quarter" @Html.Raw(Model.GroupBy?.Contains("Quarter") == true ? "checked" : "") /> <span>Quarter</span></label>
                                        <label class="list-item"><input type="checkbox" name="GroupBy" value="Year" @Html.Raw(Model.GroupBy?.Contains("Year") == true ? "checked" : "") /> <span>Year</span></label>
                                        <div class="category"><strong>Organization</strong></div>
                                        <label class="list-item"><input type="checkbox" name="GroupBy" value="Department" @Html.Raw(Model.GroupBy?.Contains("Department") == true ? "checked" : "") /> <span>Department</span></label>
                                        <label class="list-item"><input type="checkbox" name="GroupBy" value="Section" @Html.Raw(Model.GroupBy?.Contains("Section") == true ? "checked" : "") /> <span>Section</span></label>
                                        <label class="list-item"><input type="checkbox" name="GroupBy" value="Workshop" @Html.Raw(Model.GroupBy?.Contains("Workshop") == true ? "checked" : "") /> <span>Workshop</span></label>
                                        <div class="category"><strong>Employee</strong></div>
                                        <label class="list-item"><input type="checkbox" name="GroupBy" value="JobGrade" @Html.Raw(Model.GroupBy?.Contains("JobGrade") == true ? "checked" : "") /> <span>Job Grade</span></label>
                                        <label class="list-item"><input type="checkbox" name="GroupBy" value="Shift" @Html.Raw(Model.GroupBy?.Contains("Shift") == true ? "checked" : "") /> <span>Shift</span></label>
                                        <label class="list-item"><input type="checkbox" name="GroupBy" value="Process" @Html.Raw(Model.GroupBy?.Contains("Process") == true ? "checked" : "") /> <span>Process</span></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div>
                            <label class="anlz-field-label">Metric</label>
                            <select class="anlz-input" name="Metric" id="selMetric">
                                <optgroup label="Basic">
                                    <option value="Count" selected>Total Count</option>
                                    <option value="DistinctEmployees">Distinct Employees</option>
                                </optgroup>
                                <optgroup label="Certification">
                                    <option value="CertifiedCount">Certified Count</option>
                                    <option value="CertifiedRatio">Certified Ratio (%)</option>
                                </optgroup>
                                <optgroup label="Disqualification">
                                    <option value="DisqualifiedCount">Disqualified Count</option>
                                    <option value="DisqualifiedRatio">Disqualified Ratio (%)</option>
                                </optgroup>
                                <optgroup label="Expiry">
                                    <option value="ExpiringCount">Expiring Soon (30 days)</option>
                                </optgroup>
                            </select>
                        </div>
                    </div>

            <div class="anlz-field-grid" style="grid-template-columns:1fr 1fr 1fr;margin-top:0.85rem;">
                        <div>
                            <label class="anlz-field-label" id="lblStartDate">Start Date</label>
                            <input type="date" class="anlz-input" name="StartDate" id="txtStartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div>
                            <label class="anlz-field-label" id="lblEndDate">End Date</label>
                            <input type="date" class="anlz-input" name="EndDate" id="txtEndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div>
                            <label class="anlz-field-label">Date Field</label>
                            <select class="anlz-input" name="DateField" id="selDateField">
                                <option value="CertifiedDate">Certified date</option>
                                <option value="DisqualifiedDate">Disqualified date</option>
                                <option value="ExpiryDate">Expiry date</option>
                            </select>
                        </div>
                    </div>

            <div class="anlz-section-label" style="margin-top:1.25rem"><i class="bi bi-funnel-fill"></i> Filters</div>
            <div class="anlz-field-grid" style="grid-template-columns:1fr 1fr;">
                        <div>
                            <label class="anlz-field-label">Departments</label>
                            <div class="multi-dropdown" data-target="departments">
                                <div class="multi-dropdown-header" role="button" tabindex="0">
                                    <span class="label">Select departments</span>
                                    <span class="summary">-- Any --</span>
                                    <span class="caret">▾</span>
                                </div>
                                <div class="multi-dropdown-panel" style="display:none;">
                                    <div style="padding:0.25rem 0.5rem;border-bottom:1px solid #eef2f7;display:flex;gap:0.5rem;align-items:center;">
                                        <button type="button" class="btn btn-sm btn-link select-all">Select all</button>
                                        <button type="button" class="btn btn-sm btn-link clear-all">Clear</button>
                                    </div>
                                    <div class="multiselect-list" style="padding:0.5rem;max-height:200px;overflow:auto;">
                                        @foreach(var d in Model.Departments)
                                        {
                                            var id = "dept_" + d?.GetHashCode();
                                            <label class="list-item">
                                                <input type="checkbox" name="SelectedDepartments" value="@d" id="@id" @Html.Raw(Model.SelectedDepartments?.Contains(d) == true ? "checked" : "") />
                                                <span>@d</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div>
                            <label class="anlz-field-label">Sections</label>
                            <div class="multi-dropdown" data-target="sections">
                                <div class="multi-dropdown-header" role="button" tabindex="0">
                                    <span class="label">Select sections</span>
                                    <span class="summary">-- Any --</span>
                                    <span class="caret">▾</span>
                                </div>
                                <div class="multi-dropdown-panel" style="display:none;">
                                    <div style="padding:0.25rem 0.5rem;border-bottom:1px solid #eef2f7;display:flex;gap:0.5rem;align-items:center;">
                                        <button type="button" class="btn btn-sm btn-link select-all">Select all</button>
                                        <button type="button" class="btn btn-sm btn-link clear-all">Clear</button>
                                    </div>
                                    <div class="multiselect-list" style="padding:0.5rem;max-height:200px;overflow:auto;">
                                        @foreach(var s in Model.Sections)
                                        {
                                            var id = "sect_" + s?.GetHashCode();
                                            <label class="list-item">
                                                <input type="checkbox" name="SelectedSections" value="@s" id="@id" @Html.Raw(Model.SelectedSections?.Contains(s) == true ? "checked" : "") />
                                                <span>@s</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>


            </div>

            <div class="anlz-field-grid" style="grid-template-columns:1fr 1fr;margin-top:0.85rem;">
                        <div>
                            <label class="anlz-field-label">Top N Results</label>
                            <input type="number" class="anlz-input" name="TopN" id="txtTopN" value="20" min="5" max="100" />
                        </div>
                        <div>
                            <label class="anlz-field-label">Chart Type</label>
                            <select class="anlz-input" name="ChartType" id="selChartType">
                                <optgroup label="Standard Charts">
                                    <option value="bar" selected>📊 Bar Chart</option>
                                    <option value="line">📈 Line Chart</option>
                                    <option value="stackedBar">📊 Stacked Bar</option>
                                    <option value="horizontalBar">📊 Horizontal Bar</option>
                                </optgroup>
                                <optgroup label="Circular Charts">
                                    <option value="pie">🥧 Pie Chart</option>
                                    <option value="doughnut">🍩 Doughnut Chart</option>
                                    <option value="polarArea">🎯 Polar Area</option>
                                </optgroup>
                                <optgroup label="Advanced Charts">
                                    <option value="radar">🕸️ Radar Chart</option>
                                    <option value="scatter">⚫ Scatter Plot</option>
                                    <option value="bubble">🫧 Bubble Chart</option>
                                    <option value="area">📈 Area Chart</option>
                                    <option value="mixedBarLine">📊📈 Mixed Bar-Line</option>
                                </optgroup>
                                <optgroup label="Engineering Charts">
                                    <option value="pareto">📉 Pareto Chart</option>
                                    <option value="waterfall">🌊 Waterfall Chart</option>
                                    <option value="boxplot">📦 Box Plot (Simulated)</option>
                                    <option value="control">📊 Control Chart</option>
                                </optgroup>
                            </select>
                            <div style="margin-top:0.5rem;display:flex;flex-direction:column;gap:0.4rem;">
                                <label class="anlz-check-row"><input type="checkbox" id="chkSeparateCharts" style="width:15px;height:15px;margin:0;accent-color:#ea580c;" /><span style="font-size:0.88rem;color:#475569;">Separate charts per series</span></label>
                                <label class="anlz-check-row"><input type="checkbox" id="chkShowDataLabels" checked style="width:15px;height:15px;margin:0;accent-color:#ea580c;" /><span style="font-size:0.88rem;color:#475569;">Show data labels</span></label>
                                <label class="anlz-check-row"><input type="checkbox" id="chkEnableAnimation" checked style="width:15px;height:15px;margin:0;accent-color:#ea580c;" /><span style="font-size:0.88rem;color:#475569;">Enable animations</span></label>
                            </div>
                        </div>
                    </div>

            <div class="anlz-section-label" style="margin-top:1.25rem"><i class="bi bi-gear-fill"></i> Advanced Display Options</div>
            <div class="anlz-field-grid" style="grid-template-columns:1fr 1fr;">
                        <div>
                            <label class="anlz-field-label">Color Scheme</label>
                            <select class="anlz-input" id="selColorScheme">
                                <option value="default">🎨 Default</option>
                                <option value="ocean">🌊 Ocean Blue</option>
                                <option value="forest">🌲 Forest Green</option>
                                <option value="sunset">🌅 Sunset Orange</option>
                                <option value="royal">👑 Royal Purple</option>
                                <option value="rainbow">🌈 Rainbow</option>
                                <option value="pastel">🎀 Pastel</option>
                                <option value="neon">💡 Neon</option>
                            </select>
                        </div>
                        <div>
                            <label class="anlz-field-label">Legend Position</label>
                            <select class="anlz-input" id="selLegendPosition">
                                <option value="top">Top</option>
                                <option value="bottom">Bottom</option>
                                <option value="left">Left</option>
                                <option value="right">Right</option>
                                <option value="none">Hidden</option>
                            </select>
                        </div>
            </div>
            <div class="anlz-field-grid" style="grid-template-columns:1fr 1fr;margin-top:0.75rem;">
                        <div>
                            <label class="anlz-field-label">Comparison Mode</label>
                            <select class="anlz-input" id="selComparisonMode">
                                <option value="none">No Comparison</option>
                                <option value="previous_period">Previous Period</option>
                                <option value="year_over_year">Year over Year</option>
                                <option value="benchmark">Against Benchmark</option>
                            </select>
                        </div>
                        <div>
                            <label class="anlz-field-label">Trend Line</label>
                            <select class="anlz-input" id="selTrendLine">
                                <option value="none">No Trend Line</option>
                                <option value="linear">Linear</option>
                                <option value="movingAvg">Moving Average (3)</option>
                                <option value="movingAvg5">Moving Average (5)</option>
                            </select>
                        </div>
                    </div>

            <div class="anlz-section-label" style="margin-top:1.25rem"><i class="bi bi-table"></i> Table View</div>
            <div style="display:grid;grid-template-columns:1fr;gap:0.5rem;margin-bottom:0.75rem;">
                        <label class="anlz-field-label">Columns</label>
                        <div class="multi-dropdown" data-target="columns">
                            <div class="multi-dropdown-header" role="button" tabindex="0">
                                <span class="label">Select columns</span>
                                <span class="summary">Dept, Sect, Process, CertifiedDate</span>
                                <span class="caret">▾</span>
                            </div>
                            <div class="multi-dropdown-panel" style="display:none;">
                                <div style="padding:0.25rem 0.5rem;border-bottom:1px solid #eef2f7;display:flex;gap:0.5rem;align-items:center;">
                                    <button type="button" class="btn btn-sm btn-link select-all">Select all</button>
                                    <button type="button" class="btn btn-sm btn-link clear-all">Clear</button>
                                </div>
                                <div class="multiselect-list" style="padding:0.5rem;max-height:240px;overflow:auto;">
                                    <label class="list-item"><input type="checkbox" name="SelectedColumns" value="DeptName" @Html.Raw(Model.SelectedColumns?.Contains("DeptName") == true ? "checked" : "") /> <span>DeptName</span></label>
                                    <label class="list-item"><input type="checkbox" name="SelectedColumns" value="SectName" @Html.Raw(Model.SelectedColumns?.Contains("SectName") == true ? "checked" : "") /> <span>SectName</span></label>
                                    <label class="list-item"><input type="checkbox" name="SelectedColumns" value="WorkshopName" @Html.Raw(Model.SelectedColumns?.Contains("WorkshopName") == true ? "checked" : "") /> <span>WorkshopName</span></label>
                                    <label class="list-item"><input type="checkbox" name="SelectedColumns" value="Shift" @Html.Raw(Model.SelectedColumns?.Contains("Shift") == true ? "checked" : "") /> <span>Shift</span></label>
                                    <label class="list-item"><input type="checkbox" name="SelectedColumns" value="ProcessName" @Html.Raw(Model.SelectedColumns?.Contains("ProcessName") == true ? "checked" : "") /> <span>ProcessName</span></label>
                                    <label class="list-item"><input type="checkbox" name="SelectedColumns" value="OperatorTraining" @Html.Raw(Model.SelectedColumns?.Contains("OperatorTraining") == true ? "checked" : "") /> <span>OperatorTraining</span></label>
                                    <label class="list-item"><input type="checkbox" name="SelectedColumns" value="CertifiedDate" @Html.Raw(Model.SelectedColumns?.Contains("CertifiedDate") == true ? "checked" : "") /> <span>CertifiedDate</span></label>
                                    <label class="list-item"><input type="checkbox" name="SelectedColumns" value="ExpiryDate" @Html.Raw(Model.SelectedColumns?.Contains("ExpiryDate") == true ? "checked" : "") /> <span>ExpiryDate</span></label>
                                    <label class="list-item"><input type="checkbox" name="SelectedColumns" value="Verifier" @Html.Raw(Model.SelectedColumns?.Contains("Verifier") == true ? "checked" : "") /> <span>Verifier</span></label>
                                    <label class="list-item"><input type="checkbox" name="SelectedColumns" value="DisQualifiedDate" @Html.Raw(Model.SelectedColumns?.Contains("DisQualifiedDate") == true ? "checked" : "") /> <span>DisQualifiedDate</span></label>
                                    <label class="list-item"><input type="checkbox" name="SelectedColumns" value="DisQualifiedBy" @Html.Raw(Model.SelectedColumns?.Contains("DisQualifiedBy") == true ? "checked" : "") /> <span>DisQualifiedBy</span></label>
                                </div>
                            </div>
                        </div>

                        <label class="anlz-check-row" style="margin-top:0.4rem;"><input type="checkbox" name="OnlyDisqualified" id="chkOnlyDisqualified" @Html.Raw(Model.OnlyDisqualified ? "checked" : "") style="width:15px;height:15px;margin:0;accent-color:#ea580c;" /><span style="font-size:0.88rem;color:#475569;">Only Disqualified</span></label>
                    </div>
        }

    </div><!-- /LEFT panel -->

    <!-- RIGHT: Actions Panel -->
    <div class="anlz-panel anlz-panel-right" style="flex:0 0 290px !important;width:290px !important;min-width:290px !important;max-width:290px !important;box-sizing:border-box;position:relative !important;">
        <div class="anlz-section-label"><i class="bi bi-play-circle-fill"></i> Actions</div>
        <div class="anlz-actions">
            <button type="button" id="btnAnalyze" class="anlz-btn anlz-btn-primary"><i class="bi bi-bar-chart-fill"></i> Run Analysis</button>
            <button type="button" id="btnExport" class="anlz-btn anlz-btn-success"><i class="bi bi-download"></i> Export CSV</button>
            <button type="button" id="btnShowTable" class="anlz-btn anlz-btn-outline"><i class="bi bi-table"></i> Show Table</button>
            <button type="button" id="btnExportTable" class="anlz-btn anlz-btn-ghost"><i class="bi bi-file-earmark-text"></i> Export Table CSV</button>
        </div>

        <div style="margin-top:0.75rem;">
            <label class="anlz-field-label">Template Name</label>
            <input type="text" class="anlz-input" name="TemplateName" id="txtTemplateName" placeholder="Save as template (optional)" />
        </div>
        <div style="margin-top:0.5rem;">
            <button type="button" id="btnSaveTemplate" class="anlz-btn anlz-btn-outline" style="width:100%;"><i class="bi bi-bookmark-fill"></i> Save Template</button>
        </div>

        <div class="anlz-section-label" style="margin-top:1.4rem"><i class="bi bi-bookmark-star"></i> Saved Templates</div>
        <div class="anlz-templates-list">
            @if(Model.Templates == null || !Model.Templates.Any()){
                <div class="anlz-empty"><i class="bi bi-inbox"></i> No saved templates</div>
            } else {
                @for(int i=0;i<Model.Templates.Count;i++){
                    var t = Model.Templates[i];
                    <div class="anlz-template-row">
                        <div class="anlz-template-info">
                            <span class="anlz-template-name">@t.Name</span>
                            <span class="anlz-template-meta">@string.Join(", ", t.GroupBy)</span>
                        </div>
                        <div class="anlz-template-btns">
                            <button type="button" data-template-idx="@i" class="anlz-btn anlz-btn-xs anlz-btn-outline load-template">Load</button>
                            <form method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" formaction="?handler=DeleteTemplate" name="templateIndex" value="@i" class="anlz-btn anlz-btn-xs anlz-btn-danger">Del</button>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>
    </div><!-- /RIGHT panel -->
</div><!-- /anlz-layout -->

<!-- Results area (full width below layout) -->
<div id="resultsArea" style="margin-top:1.25rem;display:none;">
    <div class="anlz-panel" style="margin-bottom:1.25rem;">
    <div class="anlz-results-header">
        <div class="anlz-section-label" style="margin-bottom:0;border-bottom:none;padding-bottom:0;"><i class="bi bi-graph-up"></i> Analysis Results</div>
                <div class="chart-toolbar">
                    <button type="button" class="anlz-btn anlz-btn-xs anlz-btn-ghost" id="btnZoomIn" title="Zoom In"><i class="bi bi-zoom-in"></i></button>
                    <button type="button" class="anlz-btn anlz-btn-xs anlz-btn-ghost" id="btnZoomOut" title="Zoom Out"><i class="bi bi-zoom-out"></i></button>
                    <button type="button" class="anlz-btn anlz-btn-xs anlz-btn-ghost" id="btnResetZoom" title="Reset"><i class="bi bi-arrows-angle-expand"></i></button>
                    <button type="button" class="anlz-btn anlz-btn-xs anlz-btn-ghost" id="btnFullscreen" title="Fullscreen"><i class="bi bi-fullscreen"></i></button>
                    <button type="button" class="anlz-btn anlz-btn-xs anlz-btn-outline" id="btnDownloadChart" title="Download PNG"><i class="bi bi-download"></i></button>
                </div>
    </div>
            
    <!-- Statistics Summary -->
    <div class="anlz-stats-summary" id="statsSummary" style="display:none;">
    <div class="anlz-stat-item">
                    <span class="anlz-stat-label">Total</span>
                    <span class="anlz-stat-value" id="statTotal">--</span>
                </div>
                <div class="anlz-stat-item">
