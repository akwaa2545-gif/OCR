    function exportAnalysisCSV(json){
        let csv = '';
        if(json.multi){
            const labels = json.labels || [];
            const series = json.series || [];
            const header = ['Category'].concat(series.map(s => s.label));
            csv += header.map(h => '"' + h.replace(/"/g, '""') + '"').join(',') + '\n';
            for(let i=0;i<labels.length;i++){
                const row = [ labels[i] ];
                series.forEach(s => row.push((s.data && s.data[i]) ? s.data[i] : 0));
                csv += row.map(v => '"' + (v === null || v === undefined ? '' : String(v).replace(/"/g, '""')) + '"').join(',') + '\n';
            }
        } else {
            csv += '"Category","Value"\n';
            const labels = json.labels || [];
            const values = json.values || [];
            for(let i=0;i<labels.length;i++){
                csv += '"' + (labels[i] || '') + '","' + (values[i] ?? 0) + '"\n';
            }
        }

        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        const url = URL.createObjectURL(blob);
        const now = new Date().toISOString().slice(0,19).replace(/[:T]/g,'');
        link.href = url;
        link.download = 'analysis_export_' + now + '.csv';
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);
    }
    function getRandomColor(alpha){
        const r = Math.floor(Math.random()*150)+50;
        const g = Math.floor(Math.random()*150)+50;
        const b = Math.floor(Math.random()*150)+50;
        return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }

    function renderChart(labels, values){
        const ctx = document.getElementById('analysisChart').getContext('2d');
        const chartType = document.getElementById('selChartType').value;
        const metric = document.getElementById('selMetric').value;
        const trendType = document.getElementById('selTrendLine').value;
        const legendPos = getLegendPosition();

        if(analysisChart) analysisChart.destroy();

        // Update statistics display
        updateStatsDisplay(values);

        const stacked = chartType === 'stackedBar';
        const colors = labels.map((_, i) => getColor(i));
        const borderColors = labels.map((_, i) => getColor(i, 1));

        // Determine Chart.js chart type and configuration
        let chartConfig = { type: 'bar', data: {}, options: {} };
        const datasets = [];

        // Main dataset
        const mainDataset = {
            label: metric,
            data: values,
            backgroundColor: chartType === 'line' || chartType === 'area' ? getColor(0, 0.2) : colors,
            borderColor: chartType === 'line' || chartType === 'area' ? getColor(0, 1) : borderColors,
            borderWidth: 2,
            fill: chartType === 'area',
            tension: 0.3
        };

        // Configure based on chart type
        switch(chartType) {
            case 'line':
            case 'area':
                chartConfig.type = 'line';
                mainDataset.fill = chartType === 'area';
                mainDataset.pointRadius = 4;
                mainDataset.pointHoverRadius = 6;
                break;
            case 'horizontalBar':
                chartConfig.type = 'bar';
                chartConfig.options.indexAxis = 'y';
                break;
            case 'pie':
                chartConfig.type = 'pie';
                break;
            case 'doughnut':
                chartConfig.type = 'doughnut';
                chartConfig.options.cutout = '50%';
                break;
            case 'polarArea':
                chartConfig.type = 'polarArea';
                break;
            case 'radar':
                chartConfig.type = 'radar';
                mainDataset.fill = true;
                mainDataset.backgroundColor = getColor(0, 0.3);
                break;
            case 'scatter':
                chartConfig.type = 'scatter';
                mainDataset.data = labels.map((_, i) => ({ x: i, y: values[i] }));
                mainDataset.pointRadius = 6;
                mainDataset.pointHoverRadius = 8;
                break;
            case 'bubble':
                chartConfig.type = 'bubble';
                const maxVal = Math.max(...values);
                mainDataset.data = labels.map((_, i) => ({ 
                    x: i, 
                    y: values[i], 
                    r: Math.max(5, (values[i] / maxVal) * 25)
                }));
                break;
            case 'mixedBarLine':
                chartConfig.type = 'bar';
                mainDataset.type = 'bar';
                datasets.push(mainDataset);
                // Add line overlay
                datasets.push({
                    label: metric + ' (Trend)',
                    data: values,
                    type: 'line',
                    borderColor: getColor(1, 1),
                    backgroundColor: 'transparent',
                    borderWidth: 2,
                    pointRadius: 3,
                    tension: 0.3,
                    yAxisID: 'y'
                });
                break;
            case 'pareto':
                chartConfig.type = 'bar';
                // Sort data descending
                const paretoData = labels.map((l, i) => ({ label: l, value: values[i] })).sort((a, b) => b.value - a.value);
                const sortedLabels = paretoData.map(d => d.label);
                const sortedValues = paretoData.map(d => d.value);
                
                const total = sortedValues.reduce((a, b) => a + b, 0);
                let cumulative = 0;
                const cumulativePercentages = sortedValues.map(v => {
                    cumulative += v;
                    return (cumulative / total) * 100;
                });

                labels.splice(0, labels.length, ...sortedLabels); // Update labels array in place
                mainDataset.data = sortedValues;
                mainDataset.type = 'bar';
                mainDataset.yAxisID = 'y';
                datasets.push(mainDataset);
                
                datasets.push({
                    label: 'Cumulative %',
                    data: cumulativePercentages,
                    type: 'line',
                    borderColor: 'rgba(239, 68, 68, 1)',
                    backgroundColor: 'transparent',
                    borderWidth: 2,
                    pointRadius: 3,
                    tension: 0.1,
                    yAxisID: 'y1'
                });
                
                chartConfig.options.scales = {
                    x: { grid: { display: false } },
                    y: { type: 'linear', display: true, position: 'left', beginAtZero: true },
                    y1: { type: 'linear', display: true, position: 'right', beginAtZero: true, max: 100, grid: { drawOnChartArea: false } }
                };
                break;
            case 'waterfall':
                chartConfig.type = 'bar';
                let current = 0;
                const waterfallData = values.map(v => {
                    const start = current;
                    current += v;
                    return [start, current];
                });
                mainDataset.data = waterfallData;
                mainDataset.backgroundColor = values.map(v => v >= 0 ? 'rgba(34, 197, 94, 0.7)' : 'rgba(239, 68, 68, 0.7)');
                mainDataset.borderColor = values.map(v => v >= 0 ? 'rgba(34, 197, 94, 1)' : 'rgba(239, 68, 68, 1)');
                datasets.push(mainDataset);
                break;
            case 'boxplot': {
                chartConfig.type = 'bar';
                // Color bars by quartile position; overlay Q1/Median/Q3 reference lines
                const bpStats = computeBoxStats(values);
                if (bpStats) {
                    mainDataset.data = values;
                    mainDataset.backgroundColor = values.map(v => {
                        if (v <= bpStats.q1)     return 'rgba(148, 163, 184, 0.65)';
                        if (v <= bpStats.median) return 'rgba(59, 130, 246, 0.55)';
                        if (v <= bpStats.q3)     return 'rgba(59, 130, 246, 0.85)';
                        return 'rgba(37, 99, 235, 1.0)';
                    });
                    mainDataset.borderColor = 'rgba(59, 130, 246, 1)';
                    mainDataset.borderWidth = 1;
                    datasets.push(mainDataset);
                    datasets.push({ label: 'Q1',     data: Array(values.length).fill(bpStats.q1),     type: 'line', borderColor: 'rgba(234, 179, 8, 0.9)',  borderWidth: 2, borderDash: [4, 4], pointRadius: 0, fill: false });
                    datasets.push({ label: 'Median', data: Array(values.length).fill(bpStats.median), type: 'line', borderColor: 'rgba(34, 197, 94, 1)',    borderWidth: 2, borderDash: [6, 3], pointRadius: 0, fill: false });
                    datasets.push({ label: 'Q3',     data: Array(values.length).fill(bpStats.q3),     type: 'line', borderColor: 'rgba(234, 179, 8, 0.9)',  borderWidth: 2, borderDash: [4, 4], pointRadius: 0, fill: false });
                } else {
                    mainDataset.data = values;
                    datasets.push(mainDataset);
                }
                break;
            }
            case 'control':
                chartConfig.type = 'line';
                mainDataset.type = 'line';
                mainDataset.pointRadius = 4;
                datasets.push(mainDataset);
                
                const stats = calculateStats(values);
                if (stats) {
                    const meanData = Array(values.length).fill(stats.average);
                    const uclData = Array(values.length).fill(stats.average + 3 * stats.stdDev);
                    const lclData = Array(values.length).fill(Math.max(0, stats.average - 3 * stats.stdDev));
                    
                    datasets.push({
                        label: 'Mean', data: meanData, type: 'line', borderColor: 'rgba(34, 197, 94, 1)', borderWidth: 2, borderDash: [5, 5], pointRadius: 0, fill: false
                    });
                    datasets.push({
                        label: 'UCL (+3σ)', data: uclData, type: 'line', borderColor: 'rgba(239, 68, 68, 1)', borderWidth: 1, borderDash: [2, 2], pointRadius: 0, fill: false
                    });
                    datasets.push({
                        label: 'LCL (-3σ)', data: lclData, type: 'line', borderColor: 'rgba(239, 68, 68, 1)', borderWidth: 1, borderDash: [2, 2], pointRadius: 0, fill: false
                    });
                }
                break;
            case 'stackedBar':
            case 'bar':
            default:
                chartConfig.type = 'bar';
                break;
        }

        if (!['mixedBarLine', 'pareto', 'waterfall', 'boxplot', 'control'].includes(chartType)) {
            datasets.push(mainDataset);
        }

        // Add trend line if requested
        if (trendType !== 'none' && ['bar', 'line', 'area', 'stackedBar', 'horizontalBar'].includes(chartType)) {
            const trendData = calculateTrendLine(values, trendType);
            if (trendData) {
                datasets.push({
                    label: trendType === 'linear' ? 'Trend (Linear)' : 'Moving Average',
                    data: trendData,
                    type: 'line',
                    borderColor: 'rgba(255, 99, 132, 0.8)',
                    backgroundColor: 'transparent',
                    borderWidth: 2,
                    borderDash: [5, 5],
                    pointRadius: 0,
                    tension: 0.3
                });
            }
        }

        chartConfig.data = { labels: labels, datasets: datasets };

        // Common options
        chartConfig.options = {
            ...chartConfig.options,
            responsive: true,
            maintainAspectRatio: false,
            animation: { duration: getAnimationDuration() },
            plugins: {
                legend: legendPos ? { display: true, position: legendPos } : { display: false },
                datalabels: {
                    display: showDataLabels() && !['scatter', 'bubble'].includes(chartType),
                    color: '#333',
                    font: { weight: 'bold', size: 11 },
                    formatter: (value) => {
                        if (typeof value === 'object') return value.y?.toLocaleString() || '';
                        return value?.toLocaleString() || '';
                    },
                    anchor: ['pie', 'doughnut', 'polarArea'].includes(chartType) ? 'center' : 'end',
                    align: ['pie', 'doughnut', 'polarArea'].includes(chartType) ? 'center' : 'top'
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const label = context.dataset.label || '';
                            const value = context.parsed?.y ?? context.parsed ?? context.raw?.y ?? context.raw;
                            return `${label}: ${typeof value === 'number' ? value.toLocaleString() : value}`;
                        }
                    }
                }
            }
        };

        // Add scales for appropriate chart types
        if (!['pie', 'doughnut', 'polarArea', 'radar'].includes(chartType)) {
            chartConfig.options.scales = {
                x: { 
                    stacked: stacked,
                    grid: { display: chartType !== 'scatter' && chartType !== 'bubble' }
                },
                y: { 
                    stacked: stacked, 
                    beginAtZero: true,
                    grid: { color: 'rgba(0,0,0,0.05)' }
                }
            };
        }

        analysisChart = new Chart(ctx, chartConfig);
    }

    function renderTable(labels, values){
        const container = document.getElementById('dataTable');
        let html = '<table class="table table-sm table-striped"><thead><tr><th>Category</th><th>Value</th></tr></thead><tbody>';
        for(let i=0; i<labels.length; i++){
            html += `<tr><td>${labels[i]}</td><td>${values[i]}</td></tr>`;
        }
        html += '</tbody></table>';
        container.innerHTML = html;
    }

    // Export CSV
    document.getElementById('btnExport').addEventListener('click', function(){
        const form = document.getElementById('analyzerForm');
        form.action = '?handler=Export';
        form.submit();
        form.action = '';
    });

    // Save Template
    document.getElementById('btnSaveTemplate').addEventListener('click', async function(){
        const name = document.getElementById('txtTemplateName').value;
        if(!name || !name.trim()){ alert('Please enter a template name'); return; }

        const form = document.getElementById('analyzerForm');
        const formData = new FormData();
        const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
        if(token) formData.append('__RequestVerificationToken', token);

        formData.append('TemplateName', name);
        document.querySelectorAll('input[name="GroupBy"]:checked').forEach(ch => formData.append('GroupBy', ch.value));
        document.querySelectorAll('input[name="SelectedColumns"]:checked').forEach(ch => formData.append('SelectedColumns', ch.value));
        formData.append('OnlyDisqualified', document.getElementById('chkOnlyDisqualified').checked ? 'true' : 'false');
        formData.append('Metric', document.getElementById('selMetric').value);
        formData.append('TopN', document.getElementById('txtTopN').value);
        formData.append('ChartType', document.getElementById('selChartType').value);
        if(document.getElementById('txtStartDate').value) formData.append('StartDate', document.getElementById('txtStartDate').value);
        if(document.getElementById('txtEndDate').value) formData.append('EndDate', document.getElementById('txtEndDate').value);
        // persist which date field
        formData.append('DateField', document.getElementById('selDateField').value);

        document.querySelectorAll('input[name="SelectedDepartments"]:checked').forEach(ch => formData.append('SelectedDepartments', ch.value));
        document.querySelectorAll('input[name="SelectedSections"]:checked').forEach(ch => formData.append('SelectedSections', ch.value));

        try{
            const resp = await fetch(window.location.pathname + '?handler=SaveTemplate', { method: 'POST', credentials: 'same-origin', body: formData });
            const json = await resp.json();
            if(json && json.success){
                alert('Template saved successfully');
                location.reload();
            } else {
                alert('Failed to save template: ' + (json.message || 'Unknown error'));
            }
        } catch(err){
            alert('Failed to save template: ' + err.message);
        }
    });

    // Load Template
    document.querySelectorAll('.load-template').forEach(btn => {
        btn.addEventListener('click', async function(){
            const idx = this.getAttribute('data-template-idx');
            const form = document.getElementById('analyzerForm');
            const formData = new FormData();
            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            if(token) formData.append('__RequestVerificationToken', token);
            formData.append('templateIndex', idx);

            try{
                const resp = await fetch(window.location.pathname + '?handler=LoadTemplate', { method: 'POST', credentials: 'same-origin', body: formData });
                const json = await resp.json();
                if(json && json.success && json.template){
                    const t = json.template;
                    // restore GroupBy checkboxes
                    document.querySelectorAll('input[name="GroupBy"]').forEach(ch => ch.checked = false);
                    if(t.GroupBy && Array.isArray(t.GroupBy)){
                        t.GroupBy.forEach(g => {
                            const el = document.querySelector(`input[name="GroupBy"][value="${g}"]`);
                            if(el) el.checked = true;
                        });
                    }

                    // restore SelectedColumns and OnlyDisqualified
                    document.querySelectorAll('input[name="SelectedColumns"]').forEach(ch => ch.checked = false);
                    if(t.SelectedColumns && Array.isArray(t.SelectedColumns)){
                        t.SelectedColumns.forEach(c => {
                            const el = document.querySelector(`input[name="SelectedColumns"][value="${c}"]`);
                            if(el) el.checked = true;
                        });
                    }



                    document.getElementById('chkOnlyDisqualified').checked = !!t.OnlyDisqualified;

                    document.getElementById('selMetric').value = t.Metric || 'Count';
                    document.getElementById('txtTopN').value = t.TopN || 20;
                    document.getElementById('selChartType').value = t.ChartType || 'bar';
                            if(t.StartDate) document.getElementById('txtStartDate').value = t.StartDate.substring(0, 10);
                    if(t.EndDate) document.getElementById('txtEndDate').value = t.EndDate.substring(0, 10);
                    // restore Date field
                    if(t.DateField){
                        document.getElementById('selDateField').value = t.DateField;
                        // trigger change so labels and months refresh
                        document.getElementById('selDateField').dispatchEvent(new Event('change'));
                    }
                    // TODO: restore checkboxes for departments/sections
                    // update summaries for multi-dropdowns by triggering change events (existing handlers will refresh headers)
                    document.querySelectorAll('.multi-dropdown').forEach(d => { const evt = new Event('change'); d.querySelectorAll('input[type="checkbox"]').forEach(ch => ch.dispatchEvent(evt)); });
                    alert('Template loaded');
                } else {
                    alert('Failed to load template');
                }
            } catch(err){
                alert('Failed to load template: ' + err.message);
            }
        });
    });

    // Show Table (use raw DB columns selected in SelectedColumns)
    document.getElementById('btnShowTable').addEventListener('click', async function(){
        const btn = this; btn.disabled = true; btn.textContent = 'Loading...';
        try{
            const form = document.getElementById('analyzerForm');
            const formData = new FormData();
            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            if(token) formData.append('__RequestVerificationToken', token);

            // include SelectedColumns and other filters (including DateField)
            document.querySelectorAll('input[name="SelectedColumns"]:checked').forEach(ch => formData.append('SelectedColumns', ch.value));
            formData.append('OnlyDisqualified', document.getElementById('chkOnlyDisqualified').checked ? 'true' : 'false');
            if(document.getElementById('txtStartDate').value) formData.append('StartDate', document.getElementById('txtStartDate').value);
            if(document.getElementById('txtEndDate').value) formData.append('EndDate', document.getElementById('txtEndDate').value);
            // ensure DateField is sent so server-side date filters use the selected field
            formData.append('DateField', document.getElementById('selDateField').value);
            document.querySelectorAll('input[name="SelectedDepartments"]:checked').forEach(ch => formData.append('SelectedDepartments', ch.value));
            document.querySelectorAll('input[name="SelectedSections"]:checked').forEach(ch => formData.append('SelectedSections', ch.value));

            formData.append('TopN', document.getElementById('txtTopN').value);

            const resp = await fetch(window.location.pathname + '?handler=Table', { method: 'POST', credentials: 'same-origin', body: formData });
            const json = await resp.json();
            if(json && json.success){
                const cols = json.columns;
                const rows = json.rows;
                let html = '<table class="table table-sm table-striped table-condensed"><thead><tr>';
                cols.forEach(c => { html += `<th>${c}</th>`; });
                html += '</tr></thead><tbody>';
                rows.forEach(r => { html += '<tr>'; r.forEach(v => { html += `<td>${v}</td>`; }); html += '</tr>'; });
                html += '</tbody></table>';
                document.getElementById('tableContainer').innerHTML = html;
                document.getElementById('tableArea').style.display = 'block';
            } else {
                alert('Failed to load table: ' + (json.message || 'Unknown error'));
            }
        } catch(err){
            alert('Failed to load table: ' + err.message);
        } finally { btn.disabled = false; btn.textContent = '📋 Show Table'; }
    });

    // Export Table CSV (use raw DB columns selected in SelectedColumns)
    document.getElementById('btnExportTable').addEventListener('click', function(){
        const form = document.getElementById('analyzerForm');
        // ensure SelectedColumns are present on form
        document.querySelectorAll('input[name="SelectedColumns"]').forEach(ch => { if(ch.checked){ const input = document.createElement('input'); input.type='hidden'; input.name='SelectedColumns'; input.value = ch.value; form.appendChild(input); } });

        const only = document.getElementById('chkOnlyDisqualified').checked ? 'true' : 'false';
        const hidden = document.createElement('input'); hidden.type='hidden'; hidden.name='OnlyDisqualified'; hidden.value = only; form.appendChild(hidden);
        // include DateField
        const df = document.createElement('input'); df.type='hidden'; df.name='DateField'; df.value = document.getElementById('selDateField').value; form.appendChild(df);
        form.action = '?handler=TableExport';
        form.submit();
        form.action = '';
    });

    // When DateField changes, update Start/End labels and reload AvailableMonths
    document.getElementById('selDateField').addEventListener('change', function(){
        const sel = this;
        const labelText = sel.options[sel.selectedIndex] ? sel.options[sel.selectedIndex].text : sel.value;
        const lblStart = document.getElementById('lblStartDate');
        const lblEnd = document.getElementById('lblEndDate');
        if(lblStart) lblStart.textContent = 'Start ' + labelText;
        if(lblEnd) lblEnd.textContent = 'End ' + labelText;
    });

    // restore server-side selected DateField on load and trigger change to update labels/months
    document.addEventListener('DOMContentLoaded', function(){
        try{
            var sel = document.getElementById('selDateField');
            if(sel){ sel.value = '@(Model.DateField ?? "CertifiedDate")'; sel.dispatchEvent(new Event('change')); }
        } catch(e){ console.error(e); }
    });

    // Chart Toolbar Functions
    document.getElementById('btnZoomIn').addEventListener('click', function() {
        const wrapper = document.getElementById('chartWrapper');
        currentZoom = Math.min(currentZoom + 0.25, 2);
        const canvas = document.getElementById('analysisChart');
        if (canvas) {
            canvas.style.transform = `scale(${currentZoom})`;
            canvas.style.transformOrigin = 'top left';
        }
    });

    document.getElementById('btnZoomOut').addEventListener('click', function() {
        currentZoom = Math.max(currentZoom - 0.25, 0.5);
        const canvas = document.getElementById('analysisChart');
        if (canvas) {
            canvas.style.transform = `scale(${currentZoom})`;
            canvas.style.transformOrigin = 'top left';
        }
    });

    document.getElementById('btnResetZoom').addEventListener('click', function() {
        currentZoom = 1;
        const canvas = document.getElementById('analysisChart');
        if (canvas) {
            canvas.style.transform = 'scale(1)';
        }
    });

    document.getElementById('btnFullscreen').addEventListener('click', function() {
        const wrapper = document.getElementById('chartWrapper');
        wrapper.classList.toggle('fullscreen');
        const icon = this.querySelector('i');
        if (wrapper.classList.contains('fullscreen')) {
            icon.className = 'bi bi-fullscreen-exit';
            // Resize chart for fullscreen
            if (analysisChart) {
                analysisChart.resize();
            }
        } else {
            icon.className = 'bi bi-fullscreen';
            if (analysisChart) {
                analysisChart.resize();
            }
        }
    });

    // Close fullscreen on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const wrapper = document.getElementById('chartWrapper');
            if (wrapper.classList.contains('fullscreen')) {
                wrapper.classList.remove('fullscreen');
                document.querySelector('#btnFullscreen i').className = 'bi bi-fullscreen';
                if (analysisChart) analysisChart.resize();
            }
        }
    });

    document.getElementById('btnDownloadChart').addEventListener('click', function() {
        const canvas = document.getElementById('analysisChart');
        if (canvas && analysisChart) {
            const link = document.createElement('a');
            link.download = 'analysis_chart_' + new Date().toISOString().slice(0,19).replace(/[:T]/g,'') + '.png';
            link.href = canvas.toDataURL('image/png', 1.0);
            link.click();
        }
    });

