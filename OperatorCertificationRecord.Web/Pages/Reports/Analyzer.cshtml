<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
<script>
    // Register the datalabels plugin
    Chart.register(ChartDataLabels);

    let analysisChart = null;
    let comparisonChart = null;
    let currentZoom = 1;
    // stores the last returned analysis JSON so Show Table / Export can use it
    window.lastAnalysisResult = null;

    // Color schemes
    const colorSchemes = {
        default: ['rgba(59, 130, 246, 0.7)', 'rgba(34, 197, 94, 0.7)', 'rgba(234, 179, 8, 0.7)', 'rgba(239, 68, 68, 0.7)', 'rgba(139, 92, 246, 0.7)', 'rgba(236, 72, 153, 0.7)', 'rgba(6, 182, 212, 0.7)', 'rgba(249, 115, 22, 0.7)'],
        ocean: ['rgba(0, 119, 182, 0.7)', 'rgba(0, 150, 199, 0.7)', 'rgba(0, 180, 216, 0.7)', 'rgba(72, 202, 228, 0.7)', 'rgba(144, 224, 239, 0.7)', 'rgba(173, 232, 244, 0.7)', 'rgba(202, 240, 248, 0.7)'],
        forest: ['rgba(27, 67, 50, 0.7)', 'rgba(45, 106, 79, 0.7)', 'rgba(64, 145, 108, 0.7)', 'rgba(82, 183, 136, 0.7)', 'rgba(116, 198, 157, 0.7)', 'rgba(149, 213, 178, 0.7)', 'rgba(183, 228, 199, 0.7)'],
        sunset: ['rgba(249, 65, 68, 0.7)', 'rgba(243, 114, 44, 0.7)', 'rgba(248, 150, 30, 0.7)', 'rgba(249, 199, 79, 0.7)', 'rgba(144, 190, 109, 0.7)', 'rgba(67, 170, 139, 0.7)', 'rgba(87, 117, 144, 0.7)'],
        royal: ['rgba(88, 24, 69, 0.7)', 'rgba(144, 12, 63, 0.7)', 'rgba(199, 0, 57, 0.7)', 'rgba(255, 87, 51, 0.7)', 'rgba(255, 195, 0, 0.7)', 'rgba(88, 24, 69, 0.7)'],
        rainbow: ['rgba(255, 0, 0, 0.7)', 'rgba(255, 127, 0, 0.7)', 'rgba(255, 255, 0, 0.7)', 'rgba(0, 255, 0, 0.7)', 'rgba(0, 0, 255, 0.7)', 'rgba(75, 0, 130, 0.7)', 'rgba(148, 0, 211, 0.7)'],
        pastel: ['rgba(255, 173, 173, 0.7)', 'rgba(255, 214, 165, 0.7)', 'rgba(253, 255, 182, 0.7)', 'rgba(202, 255, 191, 0.7)', 'rgba(155, 246, 255, 0.7)', 'rgba(160, 196, 255, 0.7)', 'rgba(189, 178, 255, 0.7)'],
        neon: ['rgba(57, 255, 20, 0.7)', 'rgba(255, 20, 147, 0.7)', 'rgba(0, 255, 255, 0.7)', 'rgba(255, 255, 0, 0.7)', 'rgba(255, 0, 255, 0.7)', 'rgba(0, 255, 127, 0.7)', 'rgba(255, 105, 180, 0.7)']
    };

    function getColorScheme() {
        const scheme = document.getElementById('selColorScheme').value;
        return colorSchemes[scheme] || colorSchemes.default;
    }

    function getColor(index, alpha = 0.7) {
        const colors = getColorScheme();
        const baseColor = colors[index % colors.length];
        return baseColor.replace(/[\d.]+\)$/, alpha + ')');
    }

    function getLegendPosition() {
        const pos = document.getElementById('selLegendPosition').value;
        return pos === 'none' ? false : pos;
    }

    function getAnimationDuration() {
        return document.getElementById('chkEnableAnimation').checked ? 750 : 0;
    }

    function showDataLabels() {
        return document.getElementById('chkShowDataLabels').checked;
    }

    // Calculate statistics
    function calculateStats(values) {
        if (!values || values.length === 0) return null;
        const nums = values.map(v => Number(v) || 0);
        const sum = nums.reduce((a, b) => a + b, 0);
        const avg = sum / nums.length;
        const sorted = [...nums].sort((a, b) => a - b);
        const median = nums.length % 2 === 0 
            ? (sorted[nums.length/2 - 1] + sorted[nums.length/2]) / 2 
            : sorted[Math.floor(nums.length/2)];
        const variance = nums.reduce((acc, val) => acc + Math.pow(val - avg, 2), 0) / nums.length;
        const stdDev = Math.sqrt(variance);
        return {
            total: sum,
            average: avg,
            max: Math.max(...nums),
            min: Math.min(...nums),
            median: median,
            stdDev: stdDev
        };
    }

    function computeBoxStats(vals) {
        const nums = vals.map(v => Number(v)).filter(v => !isNaN(v));
        if (nums.length === 0) return null;
        const sorted = [...nums].sort((a, b) => a - b);
        const n = sorted.length;
        const interp = p => {
            const idx = p * (n - 1);
            const lo = Math.floor(idx), hi = Math.ceil(idx);
            return sorted[lo] + (sorted[hi] - sorted[lo]) * (idx - lo);
        };
        return { min: sorted[0], q1: interp(0.25), median: interp(0.5), q3: interp(0.75), max: sorted[n - 1] };
    }

    function updateStatsDisplay(values) {
        const stats = calculateStats(values);
        if (!stats) {
            document.getElementById('statsSummary').style.display = 'none';
            return;
        }
        document.getElementById('statsSummary').style.display = 'flex';
        document.getElementById('statTotal').textContent = stats.total.toLocaleString();
        document.getElementById('statAverage').textContent = stats.average.toFixed(1);
        document.getElementById('statMax').textContent = stats.max.toLocaleString();
        document.getElementById('statMin').textContent = stats.min.toLocaleString();
        document.getElementById('statMedian').textContent = stats.median.toFixed(1);
        document.getElementById('statStdDev').textContent = stats.stdDev.toFixed(2);
    }

    // Trend line calculation  
    function calculateTrendLine(data, type = 'linear') {
        if (!data || data.length < 2) return null;
        
        if (type === 'movingAvg' || type === 'movingAvg5') {
            const window = type === 'movingAvg5' ? 5 : 3;
            const result = [];
            for (let i = 0; i < data.length; i++) {
                const start = Math.max(0, i - Math.floor(window/2));
                const end = Math.min(data.length, i + Math.ceil(window/2));
                const slice = data.slice(start, end);
                result.push(slice.reduce((a, b) => a + b, 0) / slice.length);
            }
            return result;
        }
        
        // Linear regression
        const n = data.length;
        let sumX = 0, sumY = 0, sumXY = 0, sumXX = 0;
        for (let i = 0; i < n; i++) {
            sumX += i;
            sumY += data[i];
            sumXY += i * data[i];
            sumXX += i * i;
        }
        const slope = (n * sumXY - sumX * sumY) / (n * sumXX - sumX * sumX);
        const intercept = (sumY - slope * sumX) / n;
        return data.map((_, i) => slope * i + intercept);
    }

