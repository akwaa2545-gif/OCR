    // Multi-dropdown behavior
    (function(){
        function updateSummary(container){
            const checked = Array.from(container.querySelectorAll('input[type="checkbox"]:checked')).map(x => x.nextElementSibling?.textContent || x.value);
            const header = container.querySelector('.multi-dropdown-header .summary');
            if(!header) return;
            if(checked.length === 0) header.textContent = '-- Any --';
            else if(checked.length === 1) header.textContent = checked[0];
            else header.textContent = checked[0] + ' (+ ' + (checked.length - 1) + ')';
        }

        document.querySelectorAll('.multi-dropdown').forEach(function(drop){
            const header = drop.querySelector('.multi-dropdown-header');
            const panel = drop.querySelector('.multi-dropdown-panel');
            const list = drop.querySelector('.multiselect-list');

            header.addEventListener('click', function(e){
                e.stopPropagation();
                document.querySelectorAll('.multi-dropdown-panel').forEach(p => { if(p !== panel) p.style.display = 'none'; p.classList.remove('up'); });
                const isOpen = panel.style.display === 'block';
                panel.style.display = isOpen ? 'none' : 'block';
                if(!isOpen){
                    const rect = panel.getBoundingClientRect();
                    const headerRect = header.getBoundingClientRect();
                    const spaceBelow = window.innerHeight - headerRect.bottom;
                    const spaceAbove = headerRect.top;
                    let panelHeight = panel.offsetHeight;
                    if(!panelHeight){
                        panel.style.visibility = 'hidden'; panel.style.display = 'block'; panelHeight = panel.offsetHeight; panel.style.display = 'none'; panel.style.visibility = '';
                    }
                    if(panelHeight > spaceBelow && spaceAbove > spaceBelow){
                        panel.classList.add('up');
                    } else {
                        panel.classList.remove('up');
                    }
                    const panelRectAfter = panel.getBoundingClientRect();
                    if(panelRectAfter.right > window.innerWidth){
                        panel.style.left = 'auto'; panel.style.right = '0px';
                    } else { panel.style.left = '0px'; panel.style.right = 'auto'; }
                }
            });

            header.addEventListener('keydown', function(e){ if(e.key === 'Escape') panel.style.display = 'none'; if(e.key === 'Enter' || e.key === ' ') { e.preventDefault(); header.click(); } });
            document.addEventListener('click', function(e){ if(!drop.contains(e.target)) panel.style.display = 'none'; });
            window.addEventListener('resize', function(){ panel.style.display = 'none'; });
            window.addEventListener('scroll', function(e){ if(drop.contains(e.target)) return; panel.style.display = 'none'; }, true);

            drop.querySelectorAll('.select-all').forEach(btn => btn.addEventListener('click', function(){ list.querySelectorAll('input[type="checkbox"]').forEach(ch=>ch.checked = true); updateSummary(drop); }));
            drop.querySelectorAll('.clear-all').forEach(btn => btn.addEventListener('click', function(){ list.querySelectorAll('input[type="checkbox"]').forEach(ch=>ch.checked = false); updateSummary(drop); }));

            list.querySelectorAll('input[type="checkbox"]').forEach(ch => ch.addEventListener('change', function(){ updateSummary(drop); }));

            updateSummary(drop);
        });
    })();

    // Run Analysis
    document.getElementById('btnAnalyze').addEventListener('click', async function(){
        const btn = this;
        btn.disabled = true; btn.textContent = 'Analyzing...';

        const form = document.getElementById('analyzerForm');
        const formData = new FormData();
        const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
        if(token) formData.append('__RequestVerificationToken', token);

        // GroupBy multi
        document.querySelectorAll('input[name="GroupBy"]:checked').forEach(ch => formData.append('GroupBy', ch.value));
        formData.append('Metric', document.getElementById('selMetric').value);
        formData.append('TopN', document.getElementById('txtTopN').value);
        formData.append('ChartType', document.getElementById('selChartType').value);
        if(document.getElementById('txtStartDate').value) formData.append('StartDate', document.getElementById('txtStartDate').value);
        if(document.getElementById('txtEndDate').value) formData.append('EndDate', document.getElementById('txtEndDate').value);
        // date field used for grouping/filters
        formData.append('DateField', document.getElementById('selDateField').value);

        document.querySelectorAll('input[name="SelectedDepartments"]:checked').forEach(ch => formData.append('SelectedDepartments', ch.value));
        document.querySelectorAll('input[name="SelectedSections"]:checked').forEach(ch => formData.append('SelectedSections', ch.value));


        try{
            const resp = await fetch(window.location.pathname + '?handler=Analyze', { method: 'POST', credentials: 'same-origin', body: formData });
            const json = await resp.json();

            if(json && json.success){
                // store for table/export use
                window.lastAnalysisResult = json;

                if(json.multi){
                    // render separate charts per series if user checked the option
                    const useSeparate = document.getElementById('chkSeparateCharts') && document.getElementById('chkSeparateCharts').checked;
                    if(useSeparate){
                        renderSeparateCharts(json.labels, json.series);
                    } else {
                        renderMultiChart(json.labels, json.series);
                    }
                    renderMultiTable(json.labels, json.series);
                } else {
                    // single-series chart should also ensure separate charts removed
                    destroySeparateCharts();
                    renderChart(json.labels, json.values);
                    renderTable(json.labels, json.values);
                }
                document.getElementById('resultsArea').style.display = 'block';
            } else {
                alert('Analysis failed: ' + (json.message || 'Unknown error'));
            }
        } catch(err){
            alert('Analysis failed: ' + err.message);
        } finally {
            btn.disabled = false; btn.textContent = '🔍 Run Analysis';
        }
    });

    // Multi-group rendering
    function renderMultiChart(labels, series){
        // ensure separate charts are removed and show main canvas
        destroySeparateCharts();
        const grid = document.getElementById('analysisChartsGrid'); if(grid) grid.style.display = 'none';
        const canvas = document.getElementById('analysisChart'); if(canvas) canvas.style.display = '';
        const ctx = document.getElementById('analysisChart').getContext('2d');
        const chartType = document.getElementById('selChartType').value;
        const trendType = document.getElementById('selTrendLine').value;
        const legendPos = getLegendPosition();

        if(analysisChart) analysisChart.destroy();

        // Collect all values for stats
        const allValues = series.flatMap(s => s.data);
        updateStatsDisplay(allValues);

        const datasets = series.map((s, idx) => {
            const color = getColor(idx);
            const borderColor = getColor(idx, 1);
            
            const dataset = {
                label: s.label,
                data: s.data,
                backgroundColor: ['line', 'area', 'control'].includes(chartType) ? getColor(idx, 0.2) : color,
                borderColor: borderColor,
                borderWidth: chartType === 'radar' ? 2 : 1,
                fill: chartType === 'area' || chartType === 'radar',
                tension: 0.3
            };
            
            if (chartType === 'bubble') {
                const maxVal = Math.max(...s.data);
                dataset.data = s.data.map((v, i) => ({ x: i, y: v, r: Math.max(3, (v / maxVal) * 15) }));
            } else if (chartType === 'waterfall') {
                let current = 0;
                dataset.data = s.data.map(v => {
                    const start = current;
                    current += v;
                    return [start, current];
                });
                dataset.backgroundColor = s.data.map(v => v >= 0 ? getColor(idx, 0.7) : 'rgba(239, 68, 68, 0.7)');
                dataset.borderColor = s.data.map(v => v >= 0 ? getColor(idx, 1) : 'rgba(239, 68, 68, 1)');
            } else if (chartType === 'boxplot') {
                // raw data kept; will be rebuilt into a 3-layer box plot after the switch
                dataset.data = s.data;
            }
            
            return dataset;
        });

        const useStack = chartType === 'stackedBar';

        // Determine chart configuration
        let chartTypeForJs = 'bar';
        let indexAxis = undefined;
        let cutout = undefined;
        
        switch(chartType) {
            case 'line':
            case 'area':
            case 'control':
                chartTypeForJs = 'line';
                break;
            case 'horizontalBar':
                chartTypeForJs = 'bar';
                indexAxis = 'y';
                break;
            case 'pie':
                chartTypeForJs = 'pie';
                break;
            case 'doughnut':
                chartTypeForJs = 'doughnut';
                cutout = '50%';
                break;
            case 'polarArea':
                chartTypeForJs = 'polarArea';
                break;
            case 'radar':
                chartTypeForJs = 'radar';
                break;
            case 'scatter':
                chartTypeForJs = 'scatter';
                break;
            case 'bubble':
                chartTypeForJs = 'bubble';
                break;
            case 'mixedBarLine':
            case 'pareto':
                chartTypeForJs = 'bar';
                // Add line versions of each dataset
                const lineDatasets = series.map((s, idx) => ({
                    label: s.label + ' (Line)',
                    data: s.data,
                    type: 'line',
                    borderColor: getColor(idx + series.length, 1),
                    backgroundColor: 'transparent',
                    borderWidth: 2,
                    pointRadius: 2,
                    tension: 0.3
                }));
                datasets.push(...lineDatasets);
                break;
        }

        if (chartType === 'boxplot') {
            // Rebuild datasets as a proper 3-layer statistical box plot
            const boxStatsList = labels.map((_, i) => {
                const vals = series.map(s => s.data[i]).filter(v => v != null && !isNaN(Number(v))).map(Number);
                return computeBoxStats(vals);
            });
            datasets.splice(0, datasets.length,
                {
                    type: 'bar',
                    label: 'Range (Min – Max)',
                    data: boxStatsList.map(s => s ? [s.min, s.max] : null),
                    backgroundColor: 'rgba(148, 163, 184, 0.22)',
                    borderColor: 'rgba(100, 116, 139, 0.55)',
                    borderWidth: 1,
                    barPercentage: 0.32,
                    categoryPercentage: 0.9,
                    borderSkipped: false,
                    order: 3
                },
                {
                    type: 'bar',
                    label: 'IQR (Q1 – Q3)',
                    data: boxStatsList.map(s => s ? [s.q1, s.q3] : null),
                    backgroundColor: 'rgba(59, 130, 246, 0.55)',
                    borderColor: 'rgba(59, 130, 246, 1)',
                    borderWidth: 2,
                    barPercentage: 0.62,
                    categoryPercentage: 0.9,
                    borderSkipped: false,
                    order: 2
                },
                {
                    type: 'line',
                    label: 'Median',
                    data: boxStatsList.map(s => s ? s.median : null),
                    borderColor: 'rgba(15, 23, 42, 0.85)',
                    backgroundColor: 'transparent',
                    borderWidth: 3,
                    pointRadius: 7,
                    pointStyle: 'crossRot',
                    pointBorderWidth: 2.5,
                    fill: false,
                    tension: 0,
                    order: 1
                }
            );
            chartTypeForJs = 'bar';
        }

        if (chartType === 'control') {
            series.forEach((s, idx) => {
                const stats = calculateStats(s.data);
                if (stats) {
                    datasets.push({
                        label: s.label + ' Mean', data: Array(s.data.length).fill(stats.average), type: 'line', borderColor: getColor(idx, 1), borderWidth: 2, borderDash: [5, 5], pointRadius: 0, fill: false
                    });
                    datasets.push({
                        label: s.label + ' UCL', data: Array(s.data.length).fill(stats.average + 3 * stats.stdDev), type: 'line', borderColor: 'rgba(239, 68, 68, 0.5)', borderWidth: 1, borderDash: [2, 2], pointRadius: 0, fill: false
                    });
                    datasets.push({
                        label: s.label + ' LCL', data: Array(s.data.length).fill(Math.max(0, stats.average - 3 * stats.stdDev)), type: 'line', borderColor: 'rgba(239, 68, 68, 0.5)', borderWidth: 1, borderDash: [2, 2], pointRadius: 0, fill: false
                    });
                }
            });
        }

        // Add trend lines if requested
        if (trendType !== 'none' && ['bar', 'line', 'area', 'stackedBar'].includes(chartType)) {
            series.forEach((s, idx) => {
                const trendData = calculateTrendLine(s.data, trendType);
                if (trendData) {
                    datasets.push({
                        label: s.label + ' Trend',
                        data: trendData,
                        type: 'line',
                        borderColor: getColor(idx, 0.5),
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        borderDash: [5, 5],
                        pointRadius: 0,
                        tension: 0.3
                    });
                }
            });
        }

        const chartConfig = {
            type: chartTypeForJs,
            data: { labels: labels, datasets: datasets },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: indexAxis,
                cutout: cutout,
                animation: { duration: getAnimationDuration() },
                scales: !['pie', 'doughnut', 'polarArea', 'radar'].includes(chartType) ? {
                    x: { stacked: useStack },
                    y: { stacked: useStack, beginAtZero: true }
                } : undefined,
                plugins: { 
                    legend: legendPos ? { display: true, position: legendPos } : { display: false },
                    datalabels: {
                        display: showDataLabels() && !['scatter', 'bubble', 'radar'].includes(chartType),
                        color: '#333',
                        font: { weight: 'bold', size: 10 },
                        formatter: (value) => {
                            if (typeof value === 'object') return value.y?.toLocaleString() || '';
                            return value?.toLocaleString() || '';
                        }
                    }
                }
            }
        };

        analysisChart = new Chart(ctx, chartConfig);
    }

