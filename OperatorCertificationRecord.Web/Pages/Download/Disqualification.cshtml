@page
@model OperatorCertificationRecord.Web.Pages.DownloadDisqualificationModel
@{
    ViewData["Title"] = "Download Disqualification";
    ViewData["ActivePage"] = "DownloadDisqualification";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Download Disqualification Data</h1>
        <p class="page-subtitle">Export disqualification records</p>
    </div>
</div>

<div class="card" style="border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
    <div class="card-body p-6">
        <style>
            .dq-section-title { font-size: 0.9rem; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 1rem; }
            .dq-section { margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid #e5e7eb; }
            .dq-section:last-child { border-bottom: none; padding-bottom: 0; margin-bottom: 0; }
            .dq-date-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.25rem; }
            .dq-input-group { display: flex; flex-direction: column; gap: 0.5rem; }
            .dq-input-group label { font-weight: 600; color: #374151; font-size: 0.95rem; }
            .dq-input-group input, .dq-input-group select { padding: 0.75rem 0.875rem; border: 1.5px solid #d1d5db; border-radius: 8px; font-size: 0.95rem; transition: all 200ms ease; }
            .dq-input-group input:focus, .dq-input-group select:focus { border-color: var(--primary); outline: none; box-shadow: 0 0 0 3px rgba(249,115,22,0.1); }
            .dq-preset-btns { display: flex; gap: 0.75rem; flex-wrap: wrap; }
            .dq-preset-btns button { padding: 0.55rem 1rem; border: 1.5px solid #d1d5db; border-radius: 8px; background: #fff; color: #374151; font-weight: 500; font-size: 0.9rem; cursor: pointer; transition: all 0.2s; }
            .dq-preset-btns button:hover { border-color: var(--primary); color: var(--primary); background: var(--primary-light); }
            .dq-preset-btns button.active { background: var(--primary); color: #fff; border-color: var(--primary); }
            .dq-format-box { display: grid; grid-template-columns: 200px 1fr; gap: 1.5rem; align-items: flex-start; }
            .dq-preview-section { display: flex; flex-direction: column; gap: 1rem; padding: 1.5rem; background: #f9fafb; border-radius: 10px; border: 1px solid #e5e7eb; }
            .dq-count-display { display: flex; align-items: center; gap: 0.75rem; }
            .dq-count-badge { font-weight: 700; padding: 0.6rem 0.9rem; border-radius: 8px; font-size: 1rem; min-width: 120px; text-align: center; }
            .dq-action-btns { display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem; }
            .dq-action-btns button, .dq-action-btns a { padding: 0.75rem 1.75rem; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; transition: all 0.2s; }
            .dq-download-btn { background: var(--primary); color: white; }
            .dq-download-btn[disabled] { opacity: 0.6; cursor: not-allowed; transform: none; box-shadow: none; }
            .dq-download-btn:hover { background: var(--primary-hover); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(249,115,22,0.20); }
            .dq-back-btn { background: #e5e7eb; color: #374151; }
            .dq-back-btn:hover { background: #d1d5db; }
            @@media (max-width: 768px) {
                .dq-date-row { grid-template-columns: 1fr; }
                .dq-format-box { grid-template-columns: 1fr; }
                .dq-action-btns { flex-direction: column-reverse; }
            }
        </style>

        <div>
            <!-- Date Range Section -->
            <div class="dq-section">
                <div class="dq-section-title">📅 Date Range</div>
                <div class="dq-date-row">
                    <div class="dq-input-group">
                        <label>Start Date</label>
                        <input type="date" id="dqStart" />
                    </div>
                    <div class="dq-input-group">
                        <label>End Date</label>
                        <input type="date" id="dqEnd" />
                    </div>
                </div>
                <div style="margin-top: 1rem;">
                    <p style="font-size: 0.9rem; color: #6b7280; margin-bottom: 0.75rem; font-weight: 500;">Quick Presets:</p>
                    <div class="dq-preset-btns" role="tablist" aria-label="Date presets">
                        <button data-days="7" onclick="setPreset(7)">Last 7 days</button>
                        <button data-days="30" onclick="setPreset(30)">Last 30 days</button>
                        <button data-days="365" onclick="setPreset(365)">Last Year</button>
                        <button data-days="0" onclick="setPreset(0)">All Time</button>
                    </div>
                </div>
            </div>
                    
            <!-- Format & Actions Section -->
            <div class="dq-section">
                <div class="dq-section-title">⚙️ Format & Export</div>
                <div class="dq-format-box">
                    <div class="dq-input-group">
                        <label>Format</label>
                        <select id="dqFormat">
                            <option value="xlsx">Excel (.xlsx)</option>
                            <option value="csv">CSV (.csv)</option>
                        </select>
                    </div>
                    <div style="display: flex; align-items: flex-end;">
                        <button id="previewCount" class="btn btn-outline" style="padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: 600;">🔍 Preview Count</button>
                    </div>
                </div>
            </div>

            <!-- Preview & Download Section -->
            <div class="dq-section" style="border-bottom: none; padding-bottom: 0; margin-bottom: 0;">
                <div class="dq-section-title">📊 Summary</div>
                <div class="dq-preview-section">
                    <div class="dq-count-display">
                        <span style="color: #6b7280; font-weight: 500;">Records to Export:</span>
                        <span id="dqCountBadge" class="dq-count-badge badge bg-secondary">—</span>
                        <span id="dqLoading" style="display:none; color: #6b7280; font-size: 0.9rem;">Checking…</span>
                    </div>
                    <p style="font-size: 0.9rem; color: #6b7280; margin: 0;">Click Preview to count records before downloading.</p>
                </div>

                <div class="dq-action-btns">
                    <a href="/DownloadSection" class="btn dq-back-btn">← Back</a>
                    <button id="downloadBtn" class="btn dq-download-btn">⬇️ Download File</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function(){
        const startEl = document.getElementById('dqStart');
        const endEl = document.getElementById('dqEnd');
        const formatEl = document.getElementById('dqFormat');
        const previewBtn = document.getElementById('previewCount');
        const downloadBtn = document.getElementById('downloadBtn');
        const dqCountBadge = document.getElementById('dqCountBadge');
        const dqLoading = document.getElementById('dqLoading');

        const today = new Date();
        const prior = new Date(); prior.setDate(today.getDate() - 30);
        function toInputDate(d){ return d.toISOString().slice(0,10); }
        startEl.value = toInputDate(prior);
        endEl.value = toInputDate(today);

        const deptEl = document.getElementById('dqDept');
        const sectEl = document.getElementById('dqSect');

        let previewDone = false;
        let lastCount = null;
        let previewTimer = null;

        function setActivePreset(days){
            document.querySelectorAll('.dq-preset-btns button').forEach(b => {
                b.classList.toggle('active', b.getAttribute('data-days') == String(days));
            });
        }

        // when department/section change, re-run preview (debounced)
        if(deptEl) deptEl.addEventListener('change', scheduleAutoPreview);
        if(sectEl) sectEl.addEventListener('change', scheduleAutoPreview);

        function buildExtraParams(){
            const parts = [];
            if(deptEl && deptEl.value) parts.push('dept=' + encodeURIComponent(deptEl.value));
            if(sectEl && sectEl.value) parts.push('sect=' + encodeURIComponent(sectEl.value));
            return parts.length ? '&' + parts.join('&') : '';
        }

        function validateDates(){
            if(!startEl.value || !endEl.value) { if(window.Toast) window.Toast.warning('Missing dates','Please select start and end dates'); return false; }
            if(new Date(startEl.value) > new Date(endEl.value)){ if(window.Toast) window.Toast.warning('Invalid range','Start date must be before end date'); return false; }
            return true;
        }

        function download(){
            if(!validateDates()) return;
            const s = encodeURIComponent(startEl.value);
            const e = encodeURIComponent(endEl.value);
            const fmt = encodeURIComponent(formatEl.value || 'xlsx');
            const extras = buildExtraParams();
            const url = `/api/download/disqualified?start=${s}&end=${e}&format=${fmt}${extras}`;
            if (window.Toast) window.Toast.info('Preparing download','Redirecting to file stream...');
            // ensure user previewed
            if (!previewDone) {
                if (window.Toast) window.Toast.warning('Preview required','Please click Preview Count first or wait for the automatic preview to run.');
                return;
            }
            window.location.href = url;
        }

        async function previewCount(){
            if(!validateDates()) return;
            dqCountBadge.textContent = '…'; dqLoading.style.display = 'inline';
            const s = encodeURIComponent(startEl.value);
            const e = encodeURIComponent(endEl.value);
            const extras = buildExtraParams();
            try{
                const res = await fetch(`/api/download/disqualified/count?start=${s}&end=${e}${extras}`);
                if(!res.ok) throw new Error('Server returned ' + res.status);
                const ct = (res.headers.get('content-type') || '').toLowerCase();
                if (!ct.includes('application/json')) {
                    const txt = await res.text();
                    console.error('[Download.Disqualification.preview] expected JSON but got', ct, txt.slice(0,200));
                    throw new Error('Invalid server response (not JSON)');
                }
                let j;
                try { j = await res.json(); } catch(parseErr) { console.error('Failed to parse JSON from /api/download/disqualified/count', parseErr); setDqBadge(dqCountBadge, null); previewDone = false; downloadBtn.disabled = true; return; }
                setDqBadge(dqCountBadge, j.count ?? 0);
                previewDone = true;
                lastCount = j.count ?? 0;
                downloadBtn.disabled = false;
                if(window.Toast) window.Toast.info('Preview complete', 'Found ' + (j.count ?? 0) + ' records');
            }catch(err){
                console.error('Preview error', err);
                setDqBadge(dqCountBadge, null);
                previewDone = false;
                lastCount = null;
                downloadBtn.disabled = true;
                if(window.Toast) window.Toast.error('Preview failed', err.message || 'Check console');
            }finally{ dqLoading.style.display='none'; }
        }

        window.setPreset = function(days){
            const e = new Date();
            if (days === 0) {
                const s = new Date(2000, 0, 1);
                startEl.value = toInputDate(s);
                endEl.value = toInputDate(new Date(2099, 11, 31));
            } else {
                const s = new Date(); s.setDate(e.getDate() - (days-1));
                startEl.value = toInputDate(s);
                endEl.value = toInputDate(e);
            }
            setActivePreset(days);
            scheduleAutoPreview();
        };

        // initialize active preset
        setActivePreset(30);



        function setDqBadge(el, count){
            // remove badge-* classes first (project uses both bootstrap and custom badges)
            el.classList.remove('bg-success','bg-warning','bg-danger','bg-secondary');
            el.classList.remove('badge-success','badge-warning','badge-danger');
            if (count === null) { el.classList.add('dq-count-badge'); el.style.background = '#ef4444'; el.style.color = '#fff'; el.textContent = 'Error'; return; }
            if (count <= 0) { el.classList.add('dq-count-badge'); el.style.background = '#ef4444'; el.style.color = '#fff'; el.textContent = '0'; }
            else if (count <= 10) { el.classList.add('dq-count-badge'); el.style.background = '#f59e0b'; el.style.color = '#111827'; el.textContent = String(count); }
            else { el.classList.add('dq-count-badge'); el.style.background = '#10b981'; el.style.color = '#fff'; el.textContent = String(count); }
        }

        // auto-preview (debounced) when dates change
        function scheduleAutoPreview(){
            if (previewTimer) clearTimeout(previewTimer);
            previewTimer = setTimeout(() => { previewCount(); }, 700);
        }

        startEl.addEventListener('input', scheduleAutoPreview);
        endEl.addEventListener('input', scheduleAutoPreview);

        // disable download until preview is done
        downloadBtn.disabled = true;

        previewBtn.addEventListener('click', function(e){ e.preventDefault(); previewCount(); });
        downloadBtn.addEventListener('click', function(e){ e.preventDefault(); download(); });
    })();
</script>
