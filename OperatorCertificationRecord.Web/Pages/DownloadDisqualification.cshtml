@page
@model OperatorCertificationRecord.Web.Pages.DownloadDisqualificationModel
@{
    ViewData["Title"] = "Download Disqualification";
    ViewData["ActivePage"] = "DownloadDisqualification";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Download Disqualification Data</h1>
        <p class="page-subtitle">Export disqualification records</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div>
            <div style="max-width:560px; margin:0 auto;">
                <div class="mb-3">
                    <label class="form-label">Start date</label>
                    <input type="date" id="dqStart" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">End date</label>
                    <input type="date" id="dqEnd" class="form-control" />
                </div>

                <div class="d-flex gap-2">
                    <button id="downloadXlsx" class="btn btn-primary">Download XLSX</button>
                    <button id="downloadCsv" class="btn btn-outline">Download CSV</button>
                    <a href="/Dashboard" class="btn btn-secondary ms-auto">Back to Dashboard</a>
                </div>
                <p class="form-text mt-3">Select a start and end date (inclusive) and click a format to download disqualification records.</p>
            </div>
        </div>
    </div>
</div>

<script>
    (function(){
        const startEl = document.getElementById('dqStart');
        const endEl = document.getElementById('dqEnd');
        const today = new Date();
        const prior = new Date(); prior.setDate(today.getDate() - 30);
        function toInputDate(d){ return d.toISOString().slice(0,10); }
        startEl.value = toInputDate(prior);
        endEl.value = toInputDate(today);

        function download(format){
            const s = startEl.value;
            const e = endEl.value;
            if(!s || !e){
                if (window.Toast) window.Toast.warning('Missing dates','Please select start and end dates');
                return;
            }
            const url = `/api/download/disqualified?start=${encodeURIComponent(s)}&end=${encodeURIComponent(e)}&format=${encodeURIComponent(format)}`;
            if (window.Toast) window.Toast.info('Preparing download','Redirecting to file stream...');
            // Navigate to the API endpoint so the browser handles the download
            window.location.href = url;
        }

        document.getElementById('downloadXlsx').addEventListener('click', function(e){ e.preventDefault(); download('xlsx'); });
        document.getElementById('downloadCsv').addEventListener('click', function(e){ e.preventDefault(); download('csv'); });
    })();
</script>
