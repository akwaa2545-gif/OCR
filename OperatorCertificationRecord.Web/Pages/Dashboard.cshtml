@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
    /* ===== Skill Level Bar Chart ===== */
    (function(){
        var rawChartData = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(System.Text.Json.JsonSerializer.Serialize(Model.SkillLevelTrend ?? new System.Collections.Generic.List<OperatorCertificationRecord.Web.Models.SkillLevelMonthData>())))';
        var trendData = [];
        try { trendData = JSON.parse(rawChartData); } catch(e) { console.warn('[SkillChart] parse failed', e); }

        // Collect unique month keys sorted
        var monthMap = {};
        trendData.forEach(function(d){ var k = d.Year+'-'+String(d.Month).padStart(2,'0'); monthMap[k]={y:d.Year,m:d.Month}; });
        var sortedKeys = Object.keys(monthMap).sort();

        // Build labels (e.g. "Jan 24")
        var monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        var labels = sortedKeys.map(function(k){ var p=monthMap[k]; return monthNames[p.m-1]+' '+String(p.y).slice(2); });

        var levels = ['X','I','L','U','O'];
        var levelColors = { 'X':'#ef4444','I':'#86efac','L':'#16a34a','U':'#facc15','O':'#f97316' };

        var datasets = levels.map(function(lv){
            return {
                label: lv,
                data: sortedKeys.map(function(k){
                    var p=monthMap[k];
                    var row=trendData.find(function(d){return d.Year===p.y&&d.Month===p.m&&d.SkillLevel===lv;});
                    return row?row.Count:0;
                }),
                backgroundColor: levelColors[lv],
                stack: 'stack1',
                order: 1
            };
        });

        // TTL as line on secondary axis
        datasets.push({
            label:'TTL',
            type:'line',
            data: sortedKeys.map(function(k){
                var p=monthMap[k];
                return trendData.filter(function(d){return d.Year===p.y&&d.Month===p.m;}).reduce(function(s,d){return s+d.Count;},0);
            }),
            borderColor:'#0f172a',
            backgroundColor:'rgba(15,23,42,0.08)',
            borderWidth:2,
            pointRadius:4,
            fill:false,
            yAxisID:'ttl',
            order:0
        });

        var ctx = document.getElementById('skillLevelChart');
        if(!ctx||typeof Chart==='undefined') return;
        new Chart(ctx, {
            type:'bar',
            data:{ labels:labels, datasets:datasets },
            options:{
                responsive:true,
                maintainAspectRatio:false,
                plugins:{ legend:{ position:'bottom' }, tooltip:{ mode:'index' } },
                scales:{
                    x:{ stacked:true, grid:{ color:'rgba(0,0,0,.05)' } },
                    y:{ stacked:true, beginAtZero:true, grid:{ color:'rgba(0,0,0,.05)' } },
                    ttl:{ position:'right', beginAtZero:true, grid:{ drawOnChartArea:false }, ticks:{ color:'#64748b' } }
                }
            }
        });
    })();
    </script>
    <script>
    /* ===== AJAX Quick Search ===== */
    (function(){
        var input    = document.getElementById('qs-input');
        var clearBtn = document.getElementById('qs-clear-btn');
        var spinner  = document.getElementById('qs-spinner');
        var results  = document.getElementById('qs-results-area');
        var hint     = document.querySelector('.qs-hint');
        var lastQ    = '';
        var debTimer = null;
        var controller = null;

        /* hint pills – auto-populate from URL params or defaults */
        var hints = [];
        if (hints.length === 0) hints = ['E001', 'E002', 'John'];
        hints.forEach(function(h){
            var pill = document.createElement('span');
            pill.className = 'qs-hint-pill';
            pill.textContent = h;
            pill.addEventListener('click', function(){ input.value = h; doSearch(h); });
            hint.appendChild(pill);
        });

        function initials(first, last){
            return ((first||'').charAt(0) + (last||'').charAt(0)).toUpperCase() || '?';
        }

        function esc(s){ return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }

        function renderEmpty(q){
            results.innerHTML =
                '<div class="qs-empty">' +
                '<div class="qs-empty-icon"><i class="bi bi-person-x"></i></div>' +
                '<div class="qs-empty-title">No employees found</div>' +
                '<div class="qs-empty-sub">No match for <strong>' + esc(q) + '</strong>. Try a different ID or name.</div>' +
                '</div>';
        }

        function renderResults(data, q){
            if (!data || data.length === 0){ renderEmpty(q); return; }
            var countBar =
                '<div class="qs-count-bar">' +
                '<div style="display:flex;align-items:center;gap:0.5rem;">' +
                '<span class="qs-count-badge">' + data.length + '</span>' +
                '<span class="qs-count-text">result' + (data.length!==1?'s':'') + ' for</span>' +
                '<span class="qs-query-pill">' + esc(q) + '</span>' +
                '</div></div>';
            var grid = '<div class="qs-results-grid">';
            data.forEach(function(e){
                var exact = e.isExact;
                var ini = initials(e.firstName, e.lastName);
                var avatarHtml = e.photoPath
                    ? '<img src="/api/photo/' + encodeURIComponent(e.photoPath) + '" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" onerror="this.onerror=null;var p=this.parentNode;p.innerHTML=p.getAttribute(\'data-ini\');">'
                    : esc(ini);
                var fullName = esc((e.prefixEng||'') + ' ' + (e.firstName||'') + ' ' + (e.lastName||'')).trim();
                grid +=
                    '<div class="qs-emp-card ' + (exact?'qs-exact':'') + (e.isResigned?' qs-resigned':'') + '">' +
                    '<div class="qs-emp-top">' +
                    '<div class="qs-emp-avatar" data-ini="' + esc(ini) + '">' + avatarHtml + '</div>' +
                    '<div style="min-width:0">' +
                    '<div class="qs-emp-name">' + fullName + '</div>' +
                    '<div class="qs-emp-code"><i class="bi bi-hash"></i> ' + esc(e.empCode) + '</div>' +
                    '</div>' +
                    (exact?'<span class="qs-exact-tag">Exact</span>':'') +
                    (e.isResigned?'<span class="qs-resigned-tag"><i class="bi bi-person-x"></i> Resigned</span>':'') +
                    '</div>' +
                    '<div class="qs-emp-meta">' +
                    (e.department?'<span class="qs-meta-chip"><i class="bi bi-building"></i> ' + esc(e.department) + '</span>':'') +
                    (e.shift?'<span class="qs-meta-chip"><i class="bi bi-clock"></i> ' + esc(e.shift) + '</span>':'') +
                    (e.jobGrade?'<span class="qs-grade-chip">' + esc(e.jobGrade) + '</span>':'') +
                    '</div>' +
                    '<div class="qs-emp-actions">' +
                    '<a href="/ViewUser?empCode=' + encodeURIComponent(e.empCode) + '" class="qs-btn-view"><i class="bi bi-eye"></i> View</a>' +
                    '<a href="/UpdateUser?empCode=' + encodeURIComponent(e.empCode) + '" class="qs-btn-edit"><i class="bi bi-pencil"></i> Edit</a>' +
                    '</div>' +
                    '</div>';
            });
            grid += '</div>';
            results.innerHTML = countBar + grid;
        }

        function setLoading(on){
            spinner.style.display = on ? 'block' : 'none';
        }

        function doSearch(q){
            q = (q||'').trim();
            if (q === lastQ) return;
            lastQ = q;
            clearTimeout(debTimer);

            if (q.length < 2){
                results.innerHTML = '';
                setLoading(false);
                return;
            }

            if (controller) controller.abort();
            controller = new AbortController();
            setLoading(true);

            fetch('/Dashboard?handler=Search&q=' + encodeURIComponent(q), {
                signal: controller.signal,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(r){ return r.json(); })
            .then(function(data){
                setLoading(false);
                renderResults(data, q);
            })
            .catch(function(err){
                if (err && err.name === 'AbortError') return;
                setLoading(false);
                results.innerHTML = '<div class="qs-empty"><div class="qs-empty-icon"><i class="bi bi-wifi-off"></i></div><div class="qs-empty-title">Search failed</div><div class="qs-empty-sub">Could not reach the server. Please try again.</div></div>';
            });
        }

        input.addEventListener('input', function(){
            var q = input.value.trim();
            clearBtn.style.display = q ? 'inline-flex' : 'none';
            clearTimeout(debTimer);
            debTimer = setTimeout(function(){ doSearch(q); }, 320);
        });

        input.addEventListener('keydown', function(e){
            if (e.key === 'Enter'){ clearTimeout(debTimer); doSearch(input.value.trim()); }
        });

        clearBtn.addEventListener('click', function(){
            input.value = '';
            clearBtn.style.display = 'none';
            results.innerHTML = '';
            lastQ = '';
            if (controller) controller.abort();
            setLoading(false);
            input.focus();
        });

        document.getElementById('qs-search-btn').addEventListener('click', function(){
            clearTimeout(debTimer);
            doSearch(input.value.trim());
        });
    })();
    </script>
    <script>
        // embed the server-side expiring list for client-side filtering (exposed on window for all scripts)
        window.expiringItems = window.expiringItems || [];
        var expiringItems = window.expiringItems;
        try {
            // Serialize on server but emit as a JS string so any embedded '<' or '<\/script>' fragments won't break page parsing.
            var _raw = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(System.Text.Json.JsonSerializer.Serialize(Model.ExpiringSoonList ?? new System.Collections.Generic.List<OperatorCertificationRecord.Web.Models.ExpiringSkill>())))';
            try {
                window.expiringItems = expiringItems = JSON.parse(_raw);
                console.debug('[Expiring] embedded expiringItems count:', (window.expiringItems || []).length);
            } catch(e) {
                console.warn('[Expiring] JSON parse failed, falling back to empty array', e);
                window.expiringItems = expiringItems = [];
            }
        } catch(e) {
            console.warn('[Expiring] failed to embed expiringItems', e);
            window.expiringItems = expiringItems = [];
        }
    </script>
    <script>
        function updateDateTime() {
            const now = new Date();
            const dateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            const dateEl = document.getElementById('currentDate');
            const timeEl = document.getElementById('currentTime');
            
            if (dateEl) dateEl.textContent = now.toLocaleDateString('en-US', dateOptions);
            if (timeEl) timeEl.textContent = now.toLocaleTimeString('en-GB', { hour12: false });
        }
        
        updateDateTime();
        setInterval(updateDateTime, 1000);
    </script>
    <script>
        function openExpiringModal() {
            const el = document.getElementById('expiringModal');
            if (!el) return;
            // move modal to body so no ancestor transforms interfere with Bootstrap centering
            if (el.parentElement !== document.body) {
                el._originalParent = el.parentElement;
                document.body.appendChild(el);
            }

            const m = new bootstrap.Modal(el);

            // restore original parent on hide
            el.addEventListener('hidden.bs.modal', function handler() {
                el.removeEventListener('hidden.bs.modal', handler);
                if (el._originalParent) {
                    el._originalParent.appendChild(el);
                    delete el._originalParent;
                }
            });

            // Defensive: ensure expiry highlighting runs immediately after the modal is shown
            // (covers cases where global handlers may not have been bound yet).
            el.addEventListener('shown.bs.modal', function once(){
                try { if (typeof highlightExpiryDatesInModal === 'function') highlightExpiryDatesInModal(); } catch(e) { /* ignore */ }
                el.removeEventListener('shown.bs.modal', once);
            });

            m.show();
        }
    </script>
    <script>
        function openEmployeeExpiries(empCode){
            if(!empCode) return;
            // find items for this employee
            const items = (expiringItems || []).filter(i => i.EmpCode === empCode);
            const modal = document.getElementById('employeeExpiriesModal');
            if(!modal) return;

            // ensure modal is a direct child of body so it stacks above other modals
            if(modal.parentElement !== document.body){
                modal._originalParent = modal.parentElement;
                document.body.appendChild(modal);
            }

            const title = modal.querySelector('.modal-title');
            const body = modal.querySelector('.modal-body');
            title.textContent = `Expiring items for ${empCode} (${items.length})`;
            const profileLink = modal.querySelector('#employeeProfileLink');
            if(profileLink) profileLink.href = '/ViewUser?empCode=' + encodeURIComponent(empCode);

            if(items.length === 0){
                body.innerHTML = '<p class="text-muted">No expiring items found for this employee.</p>';
            } else {
                let html = '<div class="table-responsive"><table class="table table-sm"><thead><tr><th>Process</th><th class="expiry-col">Expiry Date</th></tr></thead><tbody>';
                for(const it of items){
                    const d = it.expiryDate || it.ExpiryDate || null;
                    let dateStr = '';
                    if(d){
                        // Try to format ISO-like date strings
                        const dt = new Date(d);
                        if(!isNaN(dt)) dateStr = dt.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });
                        else dateStr = d;
                    }
                    html += `<tr><td>${it.Process || ''}</td><td class="expiry-cell"><span class="expiry-date" data-expiry="${(it.ExpiryDate||it.expiryDate)?(new Date(it.ExpiryDate||it.expiryDate)).toISOString().slice(0,10):''}">${dateStr}</span></td></tr>`;
                }
                html += '</tbody></table></div>';
                body.innerHTML = html;
            }

            try{
                const m = new bootstrap.Modal(modal);

                modal.addEventListener('show.bs.modal', function onShow(){
                    // add an "opening" class so CSS animation runs from the start
                    modal.classList.add('is-opening');
                });

                modal.addEventListener('shown.bs.modal', function onShown(){
                    // ensure this modal and its backdrop sit above any open modals
                    modal.style.zIndex = 2150;
                    const backdrops = document.querySelectorAll('.modal-backdrop.show');
                    const lastBackdrop = backdrops[backdrops.length - 1];
                    if(lastBackdrop){
                        lastBackdrop.classList.add('employee-modal-backdrop');
                        lastBackdrop.style.zIndex = 2140;
                    }

                    // run expiry highlighting inside this modal
                    const today = new Date();
                    for(const el of modal.querySelectorAll('.expiry-date')){
                        if(el.dataset._processed === '1') continue;
                        const raw = el.getAttribute('data-expiry');
                        const d = raw ? new Date(raw) : null;
                        if(!d || isNaN(d)) continue;
                        const diff = Math.floor((d - today) / (24*60*60*1000));
                        if(diff < 0){ el.classList.add('expiry-expired'); const badge = document.createElement('span'); badge.className='expiry-badge'; badge.textContent='Expired'; el.appendChild(badge); }
                        else if(diff <= 10){ el.classList.add('expiry-critical'); const badge = document.createElement('span'); badge.className='expiry-badge'; badge.textContent = diff===0 ? 'Today' : `in ${diff}d`; el.appendChild(badge); }
                        else if(diff <= 10){ el.classList.add('expiry-soon'); const badge = document.createElement('span'); badge.className='expiry-badge'; badge.textContent = `in ${diff}d`; el.appendChild(badge); }
                        el.dataset._processed = '1';
                    }

                    // remove opening flag after animation ends
                    modal.classList.remove('is-opening');
                    modal.removeEventListener('shown.bs.modal', onShown);
                });

                modal.addEventListener('hidden.bs.modal', function onHidden(){
                    // cleanup backdrop z-index & restore original parent
                    const backdrops = document.querySelectorAll('.modal-backdrop.employee-modal-backdrop');
                    backdrops.forEach(b=>{ b.classList.remove('employee-modal-backdrop'); b.style.zIndex = ''; });
                    modal.style.zIndex = '';
                    if(modal._originalParent){ modal._originalParent.appendChild(modal); delete modal._originalParent; }
                    modal.removeEventListener('hidden.bs.modal', onHidden);
                });

                m.show();
            }catch(e){ modal.style.display='block'; }
        }

        // client-side "Load more" for Expiring preview
        (function(){
            const pageSize = 20;
            function formatDate(d){
                if(!d) return '';
                const dt = new Date(d);
                if(isNaN(dt)) return d;
                return dt.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'});
            }
            function appendRows(startIndex){
                const tbody = document.getElementById('expiringPreviewBody');
                const items = (window.expiringItems || typeof expiringItems !== 'undefined' && expiringItems) || [];
                if(!tbody || !items || items.length === 0) return;
                const end = Math.min(startIndex + pageSize, items.length);
                const frag = document.createDocumentFragment();
                for(let i = startIndex; i < end; i++){
                    const it = items[i];
                    const tr = document.createElement('tr');
                    tr.style.cursor = 'pointer';
                    tr.setAttribute('data-empcode', it.EmpCode);
                    tr.onclick = function(){ openEmployeeExpiries(it.EmpCode); };
                    const name = (it.FirstNameEng && it.LastNameEng) ? (it.FirstNameEng + ' ' + it.LastNameEng) : it.EmpCode;
                    const expDate = formatDate(it.ExpiryDate || it.expiryDate);
                    tr.innerHTML = `<td>${it.EmpCode}</td><td>${name}</td><td>${it.Process || ''}</td><td class="expiry-cell"><span class="expiry-date" data-expiry="${(it.ExpiryDate || it.expiryDate) ? (new Date(it.ExpiryDate || it.expiryDate)).toISOString().slice(0,10) : ''}">${expDate}</span></td><td style="text-align:right"><a class="btn btn-sm btn-expiring" onclick="event.stopPropagation()" href="/ViewUser?empCode=${encodeURIComponent(it.EmpCode)}"><i class="bi bi-eye"></i> View</a></td>`;
                    frag.appendChild(tr);
                }
                tbody.appendChild(frag);
                // after appending new rows, re-run expiry highlighting
                highlightExpiryDatesInModal();
            }
            function updatePreviewInfo(){
                const total = (window.expiringItems || []).length;
                const current = document.getElementById('expiringPreviewBody')?.children.length || 0;
                const info = document.getElementById('expiringPreviewInfo');
                const footer = document.getElementById('expiringPreviewFooterInfo');
                if(info) info.textContent = (total > current) ? `Showing first ${current} of ${total} results.` : `Showing ${current} of ${total} results.`;
                if(footer) footer.textContent = (total > current) ? `Showing first ${current} of ${total}` : `Showing ${current} of ${total}`;
                const wrap = document.getElementById('expiringLoadMoreWrap');
                if(wrap) wrap.style.display = (current < total) ? 'flex' : 'none'; 
                // update Load more button state and remaining count (body + footer)
                const remaining = Math.max(0, total - current);
                const btnCountEl = document.getElementById('expiringLoadMoreCount');
                const loadBtn = document.getElementById('expiringLoadMoreBtn');
                if(btnCountEl) btnCountEl.textContent = remaining > 0 ? `(${remaining} more)` : '';
                if(loadBtn) loadBtn.disabled = remaining <= 0;
                if(footer) footer.textContent = remaining > 0 ? `Showing first ${current} of ${total}` : `Showing ${current} of ${total}`;
                const footerCountEl = document.getElementById('expiringLoadMoreFooterCount');
                const footerBtn = document.getElementById('expiringLoadMoreFooterBtn');
                if(footerCountEl) footerCountEl.textContent = remaining > 0 ? `(${remaining} more)` : '';
                if(footerBtn) footerBtn.disabled = remaining <= 0;
            }

            // highlight expiry dates inside the Expiring modal (expired, critical, soon)
            function highlightExpiryDatesInModal(){
                const modal = document.getElementById('expiringModal');
                if(!modal) return;
                const today = new Date();
                for(const el of modal.querySelectorAll('.expiry-date')){
                    // skip already-processed
                    if(el.dataset._processed === '1') continue;
                    const raw = el.getAttribute('data-expiry');
                    if(!raw) continue;
                    const d = new Date(raw);
                    if(isNaN(d)) continue;
                    const diff = Math.floor((d - today) / (24*60*60*1000));
                    if(diff < 0){
                        el.classList.add('expiry-expired');
                        const badge = document.createElement('span');
                        badge.className = 'expiry-badge';
                        badge.textContent = 'Expired';
                        el.appendChild(badge);
                    } else if(diff <= 10){
                        el.classList.add('expiry-critical');
                        const badge = document.createElement('span');
                        badge.className = 'expiry-badge';
                        badge.textContent = diff === 0 ? 'Today' : `in ${diff}d`;
                        el.appendChild(badge);
                    } else if(diff <= 20){
                        el.classList.add('expiry-soon');
                        const badge = document.createElement('span');
                        badge.className = 'expiry-badge';
                        badge.textContent = `in ${diff}d`;
                        el.appendChild(badge);
                    }
                    el.dataset._processed = '1';
                }
            }

            async function handleLoadMore(){
                console.debug('[Expiring] handleLoadMore called');
                const btn = document.getElementById('expiringLoadMoreBtn');
                const footerBtn = document.getElementById('expiringLoadMoreFooterBtn');
                const spinner = document.getElementById('expiringLoadMoreSpinner');
                const footerSpinner = document.getElementById('expiringLoadMoreFooterSpinner');
                try{
                    if(btn){ btn.disabled = true; btn.setAttribute('aria-busy','true'); }
                    if(footerBtn){ footerBtn.disabled = true; footerBtn.setAttribute('aria-busy','true'); }
                    if(spinner) spinner.style.display = 'inline-block';
                    if(footerSpinner) footerSpinner.style.display = 'inline-block';

                    // if embedded list is empty (e.g. parsing failed), fetch preview JSON from server as a fallback
                    if(!((window.expiringItems || []).length > 0)){
                        console.debug('[Expiring] embedded list empty — fetching preview from server');
                        try{
                            const resp = await fetch('/api/download/expiry/preview?days=30&top=1000');
                            if(!resp.ok){
                                console.warn('[Expiring] preview fetch failed status=', resp.status);
                            } else {
                                const ct = (resp.headers.get('content-type') || '').toLowerCase();
                                if(!ct.includes('application/json')){
                                    const txt = await resp.text();
                                    console.warn('[Expiring] preview returned non-JSON (possible login/html). snippet=', txt.slice(0,200));
                                    // If the server returned HTML (login page), redirect so user can re-authenticate
                                    if(txt.trim().startsWith('<')){
                                        if(window.Toast) window.Toast.error('Session', 'Your session may have expired — please sign in again');
                                        // stop further client parsing to avoid "Unexpected token '<'"
                                        return;
                                    }
                                } else {
                                    const json = await resp.json();
                                    window.expiringItems = json || [];
                                }
                            }
                        }catch(fetchErr){
                            console.warn('[Expiring] preview fetch error', fetchErr);
                        }
                    }

                    const current = document.getElementById('expiringPreviewBody')?.children.length || 0;
                    console.debug('[Expiring] appending rows from', current);
                    // client-side append (uses embedded expiringItems)
                    appendRows(current);
                    updatePreviewInfo();
                }finally{
                    if(spinner) spinner.style.display = 'none';
                    if(footerSpinner) footerSpinner.style.display = 'none';
                    if(btn){ btn.disabled = false; btn.removeAttribute('aria-busy'); }
                    if(footerBtn){ footerBtn.disabled = false; footerBtn.removeAttribute('aria-busy'); }
                }
            }

            // Attach handlers immediately and add a delegated fallback so buttons work even
            // if the DOMContentLoaded event already fired or elements are replaced dynamically.
            function delegatedExpiringClick(ev){
                const t = ev.target && (ev.target.closest ? ev.target.closest('#expiringLoadMoreBtn, #expiringLoadMoreFooterBtn') : null);
                if(t){
                    ev.preventDefault();
                    handleLoadMore();
                }
            }

            function bindExpiringHandlers(){
                console.debug('[Expiring] bindExpiringHandlers running; readyState=', document.readyState);
                // immediate binding for both body and footer buttons
                const btn = document.getElementById('expiringLoadMoreBtn');
                const fbtn = document.getElementById('expiringLoadMoreFooterBtn');
                if(btn){ btn.removeEventListener('click', handleLoadMore); btn.addEventListener('click', handleLoadMore); }
                if(fbtn){ fbtn.removeEventListener('click', handleLoadMore); fbtn.addEventListener('click', handleLoadMore); }

                // expose a debug helper so you can force-append rows from the console if needed
                try{ window.expiringDebugAppendMore = async function(){ console.debug('[Expiring] debug append invoked'); await handleLoadMore(); }; }catch(e){ /* ignore */ }

                // ensure initial UI counts are correct even before modal is shown
                try{ updatePreviewInfo(); }catch(e){ /* ignore */ }

                // delegated fallback so clicks are handled even if elements are swapped/re-rendered
                document.removeEventListener('click', delegatedExpiringClick);
                document.addEventListener('click', delegatedExpiringClick);

                const modal = document.getElementById('expiringModal');
                if(!modal) return;
                // refresh preview state when modal opens
                modal.addEventListener('shown.bs.modal', function(){
                    updatePreviewInfo();
                    highlightExpiryDatesInModal();
                });
            }

            if(document.readyState === 'loading'){
                document.addEventListener('DOMContentLoaded', bindExpiringHandlers);
            } else {
                bindExpiringHandlers();
            }
        })();

    </script>

    <script>
        // KPI Department Filter
        window.filterKpiByDept = function(dept, button) {
            const allBtn = document.querySelector('.kpi-dept-btn.all-data');
            const clickedBtn = button || event?.target;
            const isActive = clickedBtn && clickedBtn.classList.contains('active');
            if (dept !== 'all' && isActive) {
                dept = 'all';
            }

            // Update button states
            document.querySelectorAll('.kpi-dept-btn').forEach(btn => btn.classList.remove('active'));
            if (dept === 'all') {
                allBtn?.classList.add('active');
            } else {
                clickedBtn?.classList.add('active');
            }

            // Get all KPI elements
            const operator = document.getElementById('kpiOperator');
            const process = document.getElementById('kpiProcess');
            const skill = document.getElementById('kpiSkill');
            const handicap = document.getElementById('kpiHandicap');
            const oneSkill = document.getElementById('kpiOneSkill');
            const noSkill = document.getElementById('kpiNoSkill');
            
            // Simulated department data (in real app, this would come from API/backend)
            const deptData = {
                'all': {
                    operator: operator?.getAttribute('data-all') || 0,
                    process: process?.getAttribute('data-all') || 0,
                    skill: skill?.getAttribute('data-all') || 0,
                    handicap: handicap?.getAttribute('data-all') || 0,
                    oneSkill: oneSkill?.getAttribute('data-all') || 0,
                    noSkill: noSkill?.getAttribute('data-all') || 0
                },
                'ta': { operator: 245, process: 12, skill: 1250, handicap: 8, oneSkill: 45, noSkill: 12 },
                'qa': { operator: 189, process: 8, skill: 956, handicap: 5, oneSkill: 32, noSkill: 8 },
                'sc': { operator: 156, process: 10, skill: 812, handicap: 4, oneSkill: 28, noSkill: 6 },
                'planning': { operator: 142, process: 6, skill: 723, handicap: 3, oneSkill: 22, noSkill: 4 }
            };
            
            const data = deptData[dept] || deptData['all'];
            
            // Animate value updates
            if (operator) animateValue(operator, parseInt(operator.textContent), parseInt(data.operator));
            if (process) animateValue(process, parseInt(process.textContent), parseInt(data.process));
            if (skill) animateValue(skill, parseInt(skill.textContent), parseInt(data.skill));
            if (handicap) animateValue(handicap, parseInt(handicap.textContent), parseInt(data.handicap));
            if (oneSkill) animateValue(oneSkill, parseInt(oneSkill.textContent), parseInt(data.oneSkill));
            if (noSkill) animateValue(noSkill, parseInt(noSkill.textContent), parseInt(data.noSkill));
        };
        
        function animateValue(element, start, end) {
            const duration = 600;
            const startTime = Date.now();
            
            const animate = () => {
                const elapsed = Date.now() - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const current = Math.floor(start + (end - start) * progress);
                element.textContent = current.toLocaleString();
                
                if (progress < 1) {
                    requestAnimationFrame(animate);
                }
            };
            
            animate();
        }
    </script>

    <script>
        window.openObsoletedModal = function(){
            const el = document.getElementById('obsoletedModal');
            if(!el) return;
            try{ const m = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el); m.show(); }catch(e){ el.style.display='block'; }
        };
        window.openSkillInventoryModal = function(){
            const el = document.getElementById('skillInventoryModal');
            if(!el) return;
            try{ const m = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el); m.show(); }catch(e){ el.style.display='block'; }
        };
        window.openSectionDlModal = function(){
            const el = document.getElementById('sectionDlModal');
            if(!el) return;
            try{ const m = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el); m.show(); }catch(e){ el.style.display='block'; }
        };
        
        window.handleProcessClick = function(processName){
            const deptMap = {
                'Ta Manufacturing': 'ta',
                'SC Manufacturing': 'sc',
                'QA': 'qa',
                'Production & Material Planning': 'planning'
            };
            const cardMap = {
                'Ta Manufacturing': 'pcTa',
                'SC Manufacturing': 'pcSc',
                'QA': 'pcQa',
                'Production & Material Planning': 'pcPlanning'
            };
            
            const activeCard = document.getElementById(cardMap[processName]);
            const isCurrentlyActive = activeCard?.classList.contains('active-dept');
            document.querySelectorAll('.otr-process-card').forEach(c => c.classList.remove('active-dept'));

            const deptCode = deptMap[processName];
            if (isCurrentlyActive || !deptCode) {
                filterKpiByDept('all', document.querySelector('.kpi-dept-btn.all-data'));
                return;
            }

            if (activeCard) activeCard.classList.add('active-dept');
            const deptBtn = document.querySelector(`.kpi-dept-btn[onclick="filterKpiByDept('${deptCode}', this)"]`);
            if (deptBtn) {
                filterKpiByDept(deptCode, deptBtn);
            } else {
                filterKpiByDept(deptCode);
            }
        };
        
        // Clear process card active state when All Data clicked
        const allDataBtn = document.querySelector('.kpi-dept-btn.all-data');
        if (allDataBtn) {
            allDataBtn.addEventListener('click', () => {
                document.querySelectorAll('.otr-process-card').forEach(c => c.classList.remove('active-dept'));
            });
        }

        // ── Count-up on page load for OTR KPI values ──
        (function() {
            function countUp(el, to, duration) {
                const start = Date.now();
                const tick = () => {
                    const p = Math.min((Date.now() - start) / duration, 1);
                    const ease = 1 - Math.pow(1 - p, 3);
                    el.textContent = Math.floor(to * ease).toLocaleString();
                    if (p < 1) requestAnimationFrame(tick);
                };
                requestAnimationFrame(tick);
            }
            document.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('.otr-kpi-value').forEach((el, i) => {
                    const target = parseInt(el.getAttribute('data-all') || el.textContent) || 0;
                    if (!target) return;
                    el.textContent = '0';
                    setTimeout(() => countUp(el, target, 900), 300 + i * 90);
                });
            });
        })();

        // ═══ FORCE Modal Centering Override ═══
        document.addEventListener('DOMContentLoaded', function() {
            const modals = document.querySelectorAll('.modal');
            
            modals.forEach(modal => {
                modal.addEventListener('show.bs.modal', function(e) {
                    this.style.display = 'flex';
                    this.style.alignItems = 'center';
                    this.style.justifyContent = 'center';
                    this.style.position = 'fixed';
                    this.style.top = '0';
                    this.style.left = '0';
                    this.style.width = '100%';
                    this.style.height = '100%';
                    this.style.zIndex = '1050';
                    this.style.padding = '1rem';
                    this.style.boxSizing = 'border-box';
                });
                
                modal.addEventListener('shown.bs.modal', function(e) {
                    this.style.display = 'flex';
                    this.style.alignItems = 'center';
                    this.style.justifyContent = 'center';
                    
                    const dialog = this.querySelector('.modal-dialog');
                    if (dialog) {
                        dialog.style.position = 'relative';
                        dialog.style.margin = '0 auto';
                        dialog.style.width = 'auto';
                    }
                });
            });
        });
    </script>


}
