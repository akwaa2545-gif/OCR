            <!-- Expiring Soon Modal -->
              <div class="modal fade" id="expiringModal" tabindex="-1" aria-labelledby="expiringModalLabel" aria-hidden="true">
                  <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="expiringModalLabel"><i class="bi bi-clock-history me-2"></i>Expiring Soon — next 30 days (@Model.ExpiringCount)</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            @if (Model.ExpiringSoonList != null && Model.ExpiringSoonList.Count > 0)
                            {
                                    var previewLimit = 20;
                                    var previewList = Model.ExpiringSoonList.Take(previewLimit).ToList();
                                    var previewCount = previewList.Count;
                                    var totalCount = Model.ExpiringSoonList.Count;
                                    <div class="table-responsive">
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>EmpCode</th>
                                                    <th>Name</th>
                                                    <th>Process</th>
                                                    <th class="expiry-col">Expiry Date</th>
                                                    <th style="width:120px; text-align:right">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="expiringPreviewBody">
                                                @foreach (var it in previewList)
                                                {
                                                    var daysUntilExpiry = it.ExpiryDate.HasValue ? (it.ExpiryDate.Value.Date - DateTime.Now.Date).TotalDays : double.NaN;
                                                    var badgeText = string.Empty;
                                                    var badgeClass = string.Empty;
                                                    if (!double.IsNaN(daysUntilExpiry))
                                                    {
                                                        if (daysUntilExpiry < 0) { badgeText = "Expired"; badgeClass = "expiry-expired"; }
                                                        else if (daysUntilExpiry <= 10) { badgeText = (daysUntilExpiry == 0) ? "Today" : ($"in {(int)daysUntilExpiry}d"); badgeClass = "expiry-critical"; }
                                                        else if (daysUntilExpiry <= 30) { badgeText = ($"in {(int)daysUntilExpiry}d"); badgeClass = "expiry-soon"; }
                                                    }
                                                    <tr style="cursor:pointer" data-empcode="@it.EmpCode" onclick="openEmployeeExpiries('@it.EmpCode')">
                                                        <td>@it.EmpCode</td>
                                                        <td>@(string.IsNullOrWhiteSpace(it.FirstNameEng) ? it.EmpCode : it.FirstNameEng + " " + it.LastNameEng)</td>
                                                        <td>@it.Process</td>
                                                        <td class="expiry-cell">
                                                            <span class="expiry-date @(badgeClass)" data-expiry="@it.ExpiryDate?.ToString("yyyy-MM-dd")">@it.ExpiryDate?.ToString("dd MMM yyyy")
                                                                @if (!string.IsNullOrEmpty(badgeText)) { <span class="expiry-badge">@badgeText</span> }
                                                            </span>
                                                        </td>
                                                        <td style="text-align:right"><a class="btn btn-sm btn-expiring" onclick="event.stopPropagation()" href="/ViewUser?empCode=@it.EmpCode"><i class="bi bi-eye"></i> View</a></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    @if (totalCount > previewCount)
                                    {
                                        <div id="expiringLoadMoreWrap" class="d-flex align-items-center justify-content-between mt-2">
                                            <div id="expiringPreviewInfo" class="text-muted small">Showing first @previewCount of @totalCount results.</div>
                                            <div>
                                                <button id="expiringLoadMoreBtn" type="button" class="btn btn-outline-primary btn-sm" aria-controls="expiringPreviewBody" aria-label="Load more expiring items">
                                                    <span id="expiringLoadMoreLabel">Load more</span>
                                                    <span id="expiringLoadMoreCount" class="ms-2 text-muted small"></span>
                                                    <span id="expiringLoadMoreSpinner" class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true" style="display:none"></span>
                                                </button>
                                            </div>
                                        </div>
                                    }
                            }
                            else
                            {
                                    <p class="text-muted">No upcoming expirations in the next 30 days.</p>
                            }
                        </div>
                        <div class="modal-footer expiring-modal-footer">
                            @if (Model.ExpiringSoonList != null && Model.ExpiringSoonList.Count > 0) {
                                var previewLimit = 20;
                                var previewCount = Math.Min(previewLimit, Model.ExpiringSoonList.Count);
                                var totalCount = Model.ExpiringSoonList.Count;
                                <div id="expiringPreviewFooterInfo" class="me-auto text-muted small">Showing first @previewCount of @totalCount</div>
                            }
                            <button id="expiringLoadMoreFooterBtn" type="button" class="btn btn-outline-secondary btn-lg me-2" aria-controls="expiringPreviewBody" aria-label="Load more expiring items">
                                <span id="expiringLoadMoreFooterLabel">Load more</span>
                                <span id="expiringLoadMoreFooterCount" class="ms-2 text-muted small"></span>
                                <span id="expiringLoadMoreFooterSpinner" class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true" style="display:none"></span>
                            </button>
                            <a href="/DownloadExpiryDate" class="btn btn-outline-primary btn-lg me-2 expiring-full-list">
                                <i class="bi bi-list-check me-1"></i> View full list
                            </a>
                            <button type="button" class="btn btn-primary btn-lg expiring-close" data-bs-dismiss="modal">
                                <i class="bi bi-x-lg me-1"></i> Close
                            </button>
                            <var validated="true" id="requiredLoadCount" data-count="@Model.ExpiringSoonList?.Count"></var>
                            <a id="employeeProfileLink" href="/Employee/Profile" class="d-none"></a>
                            <a id="employeeExpiriesLink" href="/Employee/Expiries" class="d-none"></a>
                            <a id="employeeExpiriesApi" href="/api/employee/expiries" class="d-none"></a>
                            
                        </div>
                    </div>
                </div>
