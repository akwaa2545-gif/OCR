<!-- ═══════════ Download Reports / Quick Actions / Search ═══════════ -->
<div class="db-main-layout">

    <!-- LEFT COLUMN: Download Reports + Search -->
    <div class="db-left-col">

        <!-- Download Reports -->
        <div class="otr-section">
            <div class="otr-header">
                <i class="bi bi-download me-2"></i>Download Reports
            </div>
            <div class="db-dl-grid">
                <button type="button" class="db-dl-card" onclick="openSkillInventoryModal()">
                    <span class="db-dl-card-strip" style="background:linear-gradient(90deg,#0ea5e9,#6366f1);"></span>
                    <span class="db-dl-card-icon" style="background:#e0f2fe;color:#0284c7;"><i class="bi bi-grid-3x3-gap-fill"></i></span>
                    <span class="db-dl-card-title">Skill Inventory</span>
                </button>
                <button type="button" class="db-dl-card" data-bs-toggle="modal" data-bs-target="#operatorNoSkillModal">
                    <span class="db-dl-card-strip" style="background:linear-gradient(90deg,#14b8a6,#06b6d4);"></span>
                    <span class="db-dl-card-icon" style="background:#f0fdfa;color:#0d9488;"><i class="bi bi-person-x-fill"></i></span>
                    <span class="db-dl-card-title">Operator No-skill</span>
                </button>
                <button type="button" class="db-dl-card" data-bs-toggle="modal" data-bs-target="#expiryModal">
                    <span class="db-dl-card-strip" style="background:linear-gradient(90deg,#f59e0b,#ef4444);"></span>
                    <span class="db-dl-card-icon" style="background:#fef3c7;color:#d97706;"><i class="bi bi-calendar-x-fill"></i></span>
                    <span class="db-dl-card-title">Expiry Date</span>
                </button>
                <button type="button" class="db-dl-card" data-bs-toggle="modal" data-bs-target="#disqualificationModal">
                    <span class="db-dl-card-strip" style="background:linear-gradient(90deg,#dc2626,#7c3aed);"></span>
                    <span class="db-dl-card-icon" style="background:#fee2e2;color:#dc2626;"><i class="bi bi-slash-circle-fill"></i></span>
                    <span class="db-dl-card-title">Disqualification</span>
                </button>
                <button type="button" class="db-dl-card" onclick="openObsoletedModal()">
                    <span class="db-dl-card-strip" style="background:linear-gradient(90deg,#92400e,#b45309);"></span>
                    <span class="db-dl-card-icon" style="background:#fef3c7;color:#b45309;"><i class="bi bi-archive-fill"></i></span>
                    <span class="db-dl-card-title">Obsoleted</span>
                </button>
                <button type="button" class="db-dl-card" data-bs-toggle="modal" data-bs-target="#resignModal">
                    <span class="db-dl-card-strip" style="background:linear-gradient(90deg,#1e3a8a,#334155);"></span>
                    <span class="db-dl-card-icon" style="background:#f1f5f9;color:#334155;"><i class="bi bi-box-arrow-right"></i></span>
                    <span class="db-dl-card-title">Resignation</span>
                </button>
            </div>
        </div>

        <!-- Individual Training Record Search -->
        <div class="db-col-search">
            <div class="dbc-search-header">
                <i class="bi bi-person-lines-fill me-2"></i>Individual Training Record:
            </div>
        <!-- Search card content -->
        @if (string.IsNullOrEmpty(Model.CurrentUserCode))
        {
        <!-- Guest: prompt to log in -->
        <div class="qs-card">
            <div class="qs-header">
                <i class="bi bi-lock-fill qs-header-icon"></i>
                <div class="qs-header-title">Login to Access Records</div>
            </div>
            <div class="qs-body" style="padding:1.75rem 1.25rem;">
                <div style="display:flex;flex-direction:column;align-items:center;gap:1rem;text-align:center;">
                    <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#1d4ed8,#3b82f6);display:flex;align-items:center;justify-content:center;">
                        <i class="bi bi-person-lock" style="font-size:2rem;color:#fff;"></i>
                    </div>
                    <div>
                        <div style="font-weight:700;font-size:1rem;color:#0f172a;">Employee Search Requires Login</div>
                        <div style="font-size:0.82rem;color:#6b7280;margin-top:0.3rem;">Sign in to view training records and employee profiles.</div>
                    </div>
                    <a href="/Login"
                       style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.6rem 1.8rem;
                              background:linear-gradient(135deg,#1d4ed8,#3b82f6);color:#fff;
                              border-radius:50px;font-weight:700;font-size:0.95rem;
                              text-decoration:none;transition:opacity 0.15s,transform 0.12s;"
                       onmouseover="this.style.opacity='0.88';this.style.transform='scale(1.03)'"
                       onmouseout="this.style.opacity='1';this.style.transform='scale(1)'">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                </div>
            </div>
        </div>
        }
        else if (Model.IsCurrentUserAdmin)
        {
        <div class="qs-card">
            <style>
                /* ── Quick Search Card ── */
                .qs-card {
                    background: #fff;
                    border-radius: 18px;
                box-shadow: 0 4px 24px rgba(249,115,22,0.10), 0 1px 4px rgba(0,0,0,0.04);
                overflow: hidden;
                border: 1px solid rgba(249,115,22,0.15);
            }
            .qs-header {
                background: linear-gradient(130deg, #7c2d12 0%, #c2410c 55%, #fb923c 100%);
                padding: 0.6rem 1.1rem;
                display: flex;
                align-items: center;
                gap: 0.6rem;
            }
            .qs-header-icon {
                font-size: 0.95rem; color: rgba(255,255,255,0.8);
                flex-shrink: 0;
            }
            .qs-header-title { color: #fff; font-weight: 600; font-size: 0.88rem; margin: 0; }
            .qs-header-sub   { display: none; }
            .qs-body { padding: 1rem 1.25rem; }

            /* Input row */
            .qs-input-wrap {
                display: flex;
                align-items: center;
                background: var(--gray-50);
                border: 2px solid #fed7aa;
                border-radius: 50px;
                padding: 0.38rem 0.5rem 0.38rem 1.1rem;
                gap: 0.5rem;
            transition: border-color 0.2s, box-shadow 0.2s;
            max-width: 680px;
        }
        .qs-input-wrap:focus-within {
            border-color: #f97316;
            box-shadow: 0 0 0 3px rgba(249,115,22,0.14);
            background: #fff;
        }
        .qs-input-icon { color: #f97316; font-size: 1rem; flex-shrink: 0; }
        #qs-input {
            flex: 1;
            border: none;
            background: transparent;
