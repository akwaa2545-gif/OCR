@page
@model OperatorCertificationRecord.Web.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
    ViewData["HasOperatorNoSkillModal"] = true;
}


<style>
    /* ══════════════════════════════════════
       Dashboard v2 — Clean & Modern
       ══════════════════════════════════════ */

    /* ── Hero Banner ── */
    .db-hero {
        background: linear-gradient(130deg, #7c2d12 0%, #c2410c 50%, #fb923c 100%);
        border-radius: 16px;
        padding: 1.5rem 1.75rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 6px 28px rgba(124,45,18,.18);
    }
    .db-hero::before {
        content: '';
        position: absolute;
        right: -40px; top: -60px;
        width: 220px; height: 220px;
        border-radius: 50%;
        background: rgba(255,255,255,.08);
        pointer-events: none;
    }
    .db-hero::after {
        content: '';
        position: absolute;
        right: 80px; bottom: -50px;
        width: 140px; height: 140px;
        border-radius: 50%;
        background: rgba(255,255,255,.05);
        pointer-events: none;
    }
    .db-hero-left { display: flex; align-items: center; gap: 1rem; position: relative; z-index: 1; }
    .db-hero-avatar {
        width: 64px; height: 64px;
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 24px; color: #fff;
        background: rgba(255,255,255,.18);
        border: 2px solid rgba(255,255,255,.25);
        flex-shrink: 0;
        overflow: hidden;
    }
    .db-hero-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .db-hero-name { font-size: 1.35rem; font-weight: 700; color: #fff; line-height: 1.2; }
    .db-hero-dept { font-size: .82rem; color: rgba(255,255,255,.72); margin-top: 2px; }

    /* ── KPI Row ── */
    .db-kpi-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1rem;
        margin-bottom: 1.75rem;
    }
    .db-kpi {
        background: #fff;
        border-radius: 14px;
        border: 1px solid var(--gray-200);
        padding: 1.15rem 1.25rem;
        display: flex;
        align-items: center;
        gap: .9rem;
        transition: all .2s ease;
        position: relative;
        overflow: hidden;
    }
    .db-kpi:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 32px rgba(0,0,0,.08);
        border-color: var(--gray-300);
    }
    .db-kpi-icon {
        width: 50px; height: 50px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem; color: #fff;
        flex-shrink: 0;
    }
    .db-kpi-icon.kpi-orange  { background: linear-gradient(135deg, #ea580c, #fb923c); }
    .db-kpi-icon.kpi-violet  { background: linear-gradient(135deg, #7c3aed, #a78bfa); }
    .db-kpi-icon.kpi-emerald { background: linear-gradient(135deg, #059669, #34d399); }
    .db-kpi-body { flex: 1; min-width: 0; }
    .db-kpi-label { font-size: .78rem; color: var(--gray-500); letter-spacing: .02em; }
    .db-kpi-value { font-size: 1.75rem; font-weight: 900; color: var(--gray-900); line-height: 1.15; }
    .db-kpi-sub { font-size: .72rem; color: var(--gray-400); margin-top: 2px; }
    .db-kpi-delta {
        display: inline-flex; align-items: center; gap: .2rem;
        font-size: .72rem; font-weight: 700;
        padding: 2px 7px; border-radius: 6px;
        margin-left: .5rem;
        vertical-align: middle;
    }
    .db-kpi-delta.up   { color: #dc2626; background: #fee2e2; }
    .db-kpi-delta.down { color: #059669; background: #d1fae5; }
    .db-kpi[role="button"] { cursor: pointer; }

    /* Sparkline */
    .db-kpi-spark { position: absolute; right: 16px; bottom: 12px; pointer-events: none; opacity: .5; }
    .db-kpi-spark svg { width: 72px; height: 20px; display: block; }

    /* ── Search wrapper override (match new theme) ── */
    .qs-card {
        border-radius: 16px !important;
        border: 1px solid var(--gray-200) !important;
        box-shadow: 0 2px 12px rgba(0,0,0,.06) !important;
    }

    /* ── Modals ── */
    #expiringModal .modal-dialog { max-width: 900px; margin: auto; }
    #expiringModal .modal-content { border-radius: 14px; box-shadow: 0 10px 40px rgba(12,38,64,0.12); }
    #expiringModal .modal-header { background: linear-gradient(130deg, #7c2d12, #c2410c); color: #fff; border-radius: 14px 14px 0 0; border-bottom: none; }
    #expiringModal .modal-title { font-weight: 800; font-size: 1.15rem; }
    #expiringModal .modal-header .btn-close { filter: brightness(0) invert(1); }
    #expiringModal .modal-body { max-height: calc(100vh - 220px); overflow-y: auto; padding: 1.25rem; }
    #expiringModal .table { width: 100%; margin-bottom: 0; }
    #expiringModal th, #expiringModal td { padding: 1rem 1.25rem; vertical-align: middle; }
    #expiringModal thead th { background: var(--gray-50); font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; color: var(--gray-600); }
    #expiringModal tbody tr:nth-child(odd) { background: #fbfbfc; }
    #expiringModal tbody tr:hover { background: #fff7ed; }
    #expiringModal .btn-expiring { padding: .5rem .9rem; border-radius: .5rem; background:#f59e0b; color:#fff; border:none; }
    #expiringModal .btn-expiring:hover { background:#d97706; color:#fff; }

    /* Expiry date styling */
    #expiringModal .expiry-date { font-weight:700; color: var(--danger); display: inline-flex; align-items: center; gap: .5rem; white-space: nowrap; font-size:1rem; letter-spacing:0.2px; }
    #expiringModal .expiry-badge { margin-left: .25rem; font-size: .72rem; padding: .18rem .6rem; border-radius: 999px; color: #fff; vertical-align:middle; box-shadow: 0 2px 6px rgba(12,38,64,0.06); display:inline-flex; align-items:center; justify-content:center; min-width:56px; }
    #expiringModal .expiry-soon { color: #b45309; }
    #expiringModal .expiry-soon .expiry-badge { background: #facc15; color: #92400e; }
    #expiringModal .expiry-soon .expiry-meta { color: #92400e; font-weight:600; }
    #expiringModal .expiry-critical { color: #b91c1c; }
    #expiringModal .expiry-critical .expiry-badge { background: #ef4444; }
    #expiringModal .expiry-expired { color: #6b7280; opacity: .95; }
    #expiringModal .expiry-expired .expiry-badge { background: #6b7280; }
    #expiringModal .expiry-meta { font-size: .82rem; color: #6b7280; margin-left: .35rem; }
    #expiringModal td.expiry-cell { text-align: center; width:160px; white-space: nowrap; }
    #expiringModal thead th.expiry-col { text-align: center; }
    &#64;media (max-width:576px){ #expiringModal td.expiry-cell{ white-space: normal; } }

    /* Modal footer */
    .expiring-modal-footer .btn-lg { padding: .55rem 1rem; font-size: .95rem; border-width:1px; }
    .expiring-modal-footer .expiring-full-list { min-width:140px; border-radius:8px; }
    .expiring-modal-footer .expiring-close { min-width:110px; border-radius:8px; box-shadow: 0 8px 20px rgba(16,24,40,0.12); }
    .expiring-modal-footer .expiring-full-list i, .expiring-modal-footer .expiring-close i { vertical-align: -2px; }
    .expiring-modal-footer .expiring-close:hover { transform: translateY(-1px); }
    &#64;media (max-width:575px){ .expiring-modal-footer .btn-lg{width:100%; display:block; margin-bottom:.5rem} .expiring-modal-footer .me-auto{display:none} }

    /* Employee modal */
    #employeeExpiriesModal { z-index: 2150 !important; }
    .modal-backdrop.employee-modal-backdrop { z-index: 2140 !important; background: rgba(0,0,0,0.45); }
    #employeeExpiriesModal.modal.show { display: flex !important; align-items: center; justify-content: center; padding: 1.25rem !important; }
    #employeeExpiriesModal .modal-dialog { margin: 0; max-width: 780px; width: min(780px, calc(100% - 3rem)); }
    #employeeExpiriesModal .modal-content { transform: translateY(-8px) scale(.995); opacity: 0; transition: transform .28s cubic-bezier(.2,.9,.2,1), opacity .18s ease; border-radius:14px; }
    #employeeExpiriesModal.modal.show .modal-content { transform: none; opacity: 1; }
    &#64;media (max-width:767px){ #employeeExpiriesModal .modal-dialog{ width: calc(100% - 2rem); max-width:none } }

    /* ── Responsive ── */
    &#64;media (max-width:768px) {
        .db-hero { flex-direction: column; align-items: flex-start; }
        .db-kpi-row { grid-template-columns: 1fr 1fr; }
        .db-kpi-value { font-size: 1.25rem; }
    }
    &#64;media (max-width:480px) {
        .db-kpi-row { grid-template-columns: 1fr; }
    }

    /* ══════════════════════════════
       Operator Training Record (OTR)
       ══════════════════════════════ */
    .otr-section {
        background: #fff;
        border-radius: 14px;
        border: 1px solid var(--gray-200);
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }
    .otr-header {
        background: linear-gradient(130deg, #1e3a5f 0%, #1d4ed8 100%);
        color: #fff;
        font-weight: 700;
        font-size: .95rem;
        padding: .65rem 1.25rem;
        display: flex;
        align-items: center;
    }
    .otr-body { padding: 0; }
    .otr-row {
        display: flex;
        align-items: center;
        padding: .65rem 1.25rem;
        border-bottom: 1px solid var(--gray-100);
        gap: 0;
    }
    .otr-row:last-child { border-bottom: none; }
    .otr-row-alt { background: #f8fafc; }
    .otr-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        min-width: 110px;
        padding: .35rem .5rem;
        border-right: 1px solid var(--gray-200);
        text-align: center;
    }
    .otr-label { font-size: .7rem; color: var(--gray-500); letter-spacing: .04em; text-transform: uppercase; margin-bottom: 2px; }
    .otr-val { font-size: 1.55rem; font-weight: 800; color: #1e3a5f; line-height: 1.1; }
    .otr-unit { font-size: .7rem; color: var(--gray-400); }
    .otr-dept-group {
        display: flex;
        flex-direction: column;
        gap: .4rem;
        padding-left: 1.25rem;
        flex: 0 0 auto;
    }
    /* KPI Grid Layout */
    .otr-kpi-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.65rem;
        padding: 0.8rem;
        align-items: stretch;
    }
    .otr-kpi-card {
        background: #fff;
        border: 1.5px solid #fed7aa;
        border-radius: 12px;
        padding: 0.8rem 0.9rem;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        min-height: 72px;
        transition: all .2s ease;
        position: relative;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(249,115,22,.07);
    }
    .otr-kpi-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, #ea580c, #fb923c);
    }
    .otr-kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 18px rgba(249,115,22,.18);
        border-color: #fb923c;
    }
    .otr-kpi-card-left {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        flex: 1;
    }
    .otr-kpi-icon {
        width: 36px; height: 36px;
        border-radius: 10px;
        background: linear-gradient(135deg, #fff7ed, #fed7aa);
        display: flex; align-items: center; justify-content: center;
        font-size: .9rem;
        color: #ea580c;
        flex-shrink: 0;
    }
    .otr-kpi-label {
        font-size: .55rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #94a3b8;
        letter-spacing: .05em;
    }
    .otr-kpi-value {
        font-size: 1.45rem;
        font-weight: 800;
        color: #ea580c;
        line-height: 1.1;
    }
    .otr-kpi-unit {
        font-size: .52rem;
        color: #cbd5e1;
        font-weight: 600;
    }
    
    /* Process Cards Grid */
    .otr-process-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.65rem;
        padding: 0.8rem;
        align-items: stretch;
    }
    .otr-process-card {
        background: #fff;
        border: 1.5px solid #bfdbfe;
        border-radius: 12px;
        padding: 0.85rem 1rem;
        display: flex;
        flex-direction: row;
        justify-content: flex-start;
        align-items: center;
        gap: 0.75rem;
        min-height: 72px;
        transition: all .2s ease;
        text-align: left;
        position: relative;
        overflow: hidden;
        cursor: pointer;
        font-family: inherit;
        box-shadow: 0 1px 4px rgba(29,78,216,.06);
    }
    .otr-process-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, #1d4ed8, #3b82f6);
    }
    .otr-process-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(29,78,216,.18);
        border-color: #3b82f6;
        background: linear-gradient(135deg, #eff6ff, #dbeafe);
    }
    .otr-process-card.active-dept {
        background: linear-gradient(135deg, #1d4ed8, #3b82f6);
        border-color: #1d4ed8;
        box-shadow: 0 6px 20px rgba(29,78,216,.35);
    }
    .otr-process-card.active-dept .otr-process-name { color: #fff; }

    .otr-process-card.active-dept .otr-process-icon {
        background: rgba(255,255,255,.2);
        color: #fff;
    }
    .otr-process-card:active {
        transform: translateY(-1px);
    }
    .otr-process-icon {
        width: 36px; height: 36px;
        border-radius: 10px;
        background: linear-gradient(135deg, #eff6ff, #bfdbfe);
        display: flex; align-items: center; justify-content: center;
        font-size: .9rem;
        color: #1d4ed8;
        flex-shrink: 0;
    }
    .otr-process-text { display: flex; flex-direction: column; gap: 0.1rem; }
    .otr-process-name {
        font-size: .88rem;
        font-weight: 700;
        color: #1e3a5f;
        line-height: 1.3;
    }
    
    /* Grid wrapper for KPI + Process */
    .otr-grid-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
        padding: 0;
    }
    
    @@media (max-width: 1024px) {
        .otr-grid-container {
            grid-template-columns: 1fr;
        }
        .otr-kpi-grid {
            grid-template-columns: repeat(3, 1fr);
        }
        .otr-process-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    
    @@media (max-width: 768px) {
        .otr-kpi-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.5rem;
            padding: 0.65rem;
        }
        .otr-process-grid {
            grid-template-columns: 1fr;
            gap: 0.5rem;
            padding: 0.65rem;
        }
        .otr-kpi-card {
            padding: 0.7rem;
            min-height: 60px;
        }
        .otr-process-card {
            padding: 0.8rem;
            min-height: 60px;
        }
        .otr-kpi-value {
            font-size: 1.25rem;
        }
        .otr-process-name {
            font-size: .65rem;
        }
    }
    
    /* KPI Department Filter */
    .kpi-filter-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }
    .kpi-filter-label {
        font-size: .75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--gray-600);
        letter-spacing: .04em;
    }
    .kpi-dept-buttons {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .kpi-dept-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.45rem 0.95rem;
        background: #1d4ed8;
        color: #fff;
        border: 2px solid transparent;
        border-radius: 8px;
        font-size: .75rem;
        font-weight: 700;
        cursor: pointer;
        transition: all .2s ease;
        white-space: nowrap;
        text-transform: uppercase;
        letter-spacing: .02em;
    }
    .kpi-dept-btn:hover {
        background: #1e40af;
        transform: translateY(-2px);
    }
    .kpi-dept-btn.active {
        background: linear-gradient(135deg, #ea580c, #fb923c);
        border-color: #c2410c;
        box-shadow: 0 4px 12px rgba(249,115,22,.25);
    }
    .kpi-dept-btn.all-data {
        background: #0f172a;
    }
    .kpi-dept-btn.all-data:hover {
        background: #1e293b;
    }
    .kpi-dept-btn.all-data.active {
        background: linear-gradient(135deg, #0f172a, #1e293b);
        border-color: #475569;
    }
    @@media (max-width: 768px) {
        .otr-row { flex-wrap: wrap; gap: .5rem; padding: .75rem; }
        .otr-stat { min-width: 90px; border-right: none; }
        .otr-dept-group { flex-direction: row; flex-wrap: wrap; padding-left: 0; }
    }

    /* ══════════════════════════════
       Skill Level Chart
       ══════════════════════════════ */
    .sl-section {
        background: #fff;
        border-radius: 14px;
        border: 1px solid var(--gray-200);
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }
    .sl-header {
        background: linear-gradient(130deg, #1e3a5f 0%, #1d4ed8 100%);
        color: #fff;
        font-weight: 700;
        font-size: .95rem;
        padding: .65rem 1.25rem;
        display: flex;
        align-items: center;
    }
    .sl-body { padding: 1.25rem; }
    .sl-chart-wrap { position: relative; height: 280px; }
    .sl-legend {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: .85rem;
        flex-wrap: wrap;
    }
    .sl-legend-title { font-size: .78rem; font-weight: 700; color: var(--gray-600); }
    .sl-legend-items { display: flex; gap: .75rem; flex-wrap: wrap; }
    .sl-legend-item {
        display: flex; align-items: center; gap: .3rem;
        font-size: .78rem; font-weight: 600; color: var(--gray-700);
    }
    .sl-dot { width: 12px; height: 12px; border-radius: 3px; flex-shrink: 0; display: inline-block; }

    /* ══════════════════════════════
       Bottom two-column grid (legacy - kept for reference)
       ══════════════════════════════ */
    .db-col-search, .db-col-download { min-width: 0; }
    .dbc-search-header {
        background: linear-gradient(130deg, #1e3a5f 0%, #1d4ed8 100%);
        color: #fff;
        font-weight: 700;
        font-size: .95rem;
        padding: .65rem 1.25rem;
        border-radius: 14px 14px 0 0;
        display: flex;
        align-items: center;
        margin-bottom: 0;
    }
    .db-col-search .qs-card {
        border-radius: 0 0 14px 14px !important;
        border-top: none !important;
        box-shadow: 0 4px 16px rgba(0,0,0,.07) !important;
        margin-bottom: 0 !important;
    }
    .db-col-search .qs-header { display: none; }

    /* ══════════════════════════════
       Main layout: Download+Search (left) / Quick Actions (right)
       ══════════════════════════════ */
    .db-main-layout {
        display: grid;
        grid-template-columns: 1.35fr 1fr;
        gap: 1.25rem;
        align-items: start;
        margin-bottom: 1.5rem;
    }
    .db-left-col {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-width: 0;
    }
    .db-right-col {
        min-width: 0;
        height: auto;
    }
    /* Remove any fixed/min-height that creates blank space */
    .db-main-layout .otr-section {
        height: auto;
        min-height: unset;
    }

    @@media (max-width: 1100px) {
        .db-main-layout {
            grid-template-columns: 1fr;
        }
        .db-dl-grid {
            grid-template-columns: repeat(3, 1fr);
        }
        .db-qa-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }
    @@media (max-width: 768px) {
        .db-dl-grid { grid-template-columns: repeat(3, 1fr); }
        .db-qa-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @@media (max-width: 600px) {
        .db-dl-grid { grid-template-columns: repeat(2, 1fr); }
        .db-qa-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 380px) {
        .db-dl-grid { grid-template-columns: repeat(2, 1fr); }
        .db-qa-grid { grid-template-columns: 1fr; }
    }

    /* ══════════════════════════════
       Download Reports Cards
       ══════════════════════════════ */
    .db-dl-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: .75rem;
        padding: 1rem 1.15rem;
    }
    
    .db-qa-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: .75rem;
        padding: 1rem 1.15rem;
    }
    
    .db-dl-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        padding: 1rem .65rem .85rem;
        background: var(--gray-50);
        border: 1.5px solid var(--gray-200);
        border-radius: 14px;
        text-decoration: none;
        cursor: pointer;
        text-align: center;
        height: auto;
        min-height: unset;
        transition: all .18s ease;
        position: relative;
        overflow: hidden;
        font-family: inherit;
        width: 100%;
    }
    .db-dl-card:hover {
        background: #fff;
        box-shadow: 0 6px 20px rgba(0,0,0,.10);
        transform: translateY(-3px);
        text-decoration: none;
        border-color: transparent;
    }
    .db-dl-card-strip {
        position: absolute; top: 0; left: 0; right: 0;
        height: 4px; border-radius: 14px 14px 0 0;
    }
    .db-dl-card-icon {
        width: 48px; height: 48px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.45rem;
        flex-shrink: 0;
        transition: transform .15s;
    }
    .db-dl-card:hover .db-dl-card-icon { transform: scale(1.1); }
    .db-dl-card-title {
        font-size: .8rem;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.3;
    }
    
    /* Quick Actions */
    .db-qa-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        padding: .85rem .65rem;
        background: var(--gray-50);
        border: 1.5px solid var(--gray-200);
        border-radius: 12px;
        text-decoration: none;
        cursor: pointer;
        text-align: center;
        height: auto;
        min-height: unset;
        transition: all .18s ease;
        position: relative;
        overflow: hidden;
        font-family: inherit;
    }
    .db-qa-card:hover {
        background: #fff;
        box-shadow: 0 6px 20px rgba(0,0,0,.10);
        transform: translateY(-3px);
        text-decoration: none;
        border-color: transparent;
    }
    .db-qa-card-badge {
        display: inline-block;
        font-size: .6rem;
        font-weight: 700;
        background: #fcd34d;
        color: #92400e;
        padding: 2px 6px;
        border-radius: 4px;
        text-transform: uppercase;
        margin-bottom: .15rem;
    }
    .db-qa-card-icon {
        width: 44px; height: 44px;
        border-radius: 11px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
        transition: transform .15s;
    }
    .db-qa-card:hover .db-qa-card-icon { transform: scale(1.1); }
    .db-qa-card-title {
        font-size: .74rem;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.2;
    }

    /* ════════════════════════════════════════════════════
       Design Enhancement Layer (frontend-design skill)
       ════════════════════════════════════════════════════ */

    @@keyframes db-rise {
        from { opacity: 0; transform: translateY(18px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes db-rise-fast {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes db-avatar-glow {
        0%, 100% { box-shadow: 0 0 0 0 rgba(251,146,60,.45), 0 0 0 0 rgba(251,146,60,.2); }
        50%       { box-shadow: 0 0 0 7px rgba(251,146,60,.18), 0 0 0 16px rgba(251,146,60,.05); }
    }
    @@keyframes db-header-shimmer {
        0%   { transform: translateX(-100%); }
        100% { transform: translateX(500%); }
    }

    /* Staggered page-load reveal */
    .db-hero         { animation: db-rise 0.52s cubic-bezier(.22,.9,.36,1) both; }
    .otr-section     { animation: db-rise 0.52s cubic-bezier(.22,.9,.36,1) 0.06s both; }
    .sl-section      { animation: db-rise 0.52s cubic-bezier(.22,.9,.36,1) 0.12s both; }
    .db-main-layout  { animation: db-rise 0.52s cubic-bezier(.22,.9,.36,1) 0.18s both; }

    .otr-kpi-card:nth-child(1) { animation: db-rise-fast .4s ease .08s both; }
    .otr-kpi-card:nth-child(2) { animation: db-rise-fast .4s ease .15s both; }
    .otr-kpi-card:nth-child(3) { animation: db-rise-fast .4s ease .22s both; }
    .otr-kpi-card:nth-child(4) { animation: db-rise-fast .4s ease .29s both; }
    .otr-kpi-card:nth-child(5) { animation: db-rise-fast .4s ease .36s both; }
    .otr-kpi-card:nth-child(6) { animation: db-rise-fast .4s ease .43s both; }

    .otr-process-card:nth-child(1) { animation: db-rise-fast .4s ease .10s both; }
    .otr-process-card:nth-child(2) { animation: db-rise-fast .4s ease .18s both; }
    .otr-process-card:nth-child(3) { animation: db-rise-fast .4s ease .26s both; }
    .otr-process-card:nth-child(4) { animation: db-rise-fast .4s ease .34s both; }

    .db-dl-card:nth-child(1) { animation: db-rise-fast .4s ease .08s both; }
    .db-dl-card:nth-child(2) { animation: db-rise-fast .4s ease .13s both; }
    .db-dl-card:nth-child(3) { animation: db-rise-fast .4s ease .18s both; }
    .db-dl-card:nth-child(4) { animation: db-rise-fast .4s ease .23s both; }
    .db-dl-card:nth-child(5) { animation: db-rise-fast .4s ease .28s both; }
    .db-dl-card:nth-child(6) { animation: db-rise-fast .4s ease .33s both; }

    /* Avatar: pulsing orange glow */
    .db-hero-avatar { animation: db-avatar-glow 3.5s ease-in-out infinite; }

    /* Hero name: heavier display weight */
    .db-hero-name {
        font-family: 'Akt', sans-serif;
        font-size: 1.4rem; font-weight: 800; letter-spacing: -.025em;
    }

    /* KPI numbers: distinctive tabular display font */
    .otr-kpi-value, .db-kpi-value {
        font-family: 'Akt', sans-serif;
        font-variant-numeric: tabular-nums;
        letter-spacing: -.04em;
    }

    /* Section headers: sweeping shimmer gloss */
    .otr-header, .sl-header, .dbc-search-header { overflow: hidden; }
    .otr-header::after, .sl-header::after, .dbc-search-header::after {
        content: '';
        position: absolute;
        top: 0; left: 0; bottom: 0; width: 18%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,.14), transparent);
        animation: db-header-shimmer 5s linear 1.2s infinite;
        pointer-events: none;
    }

    /* OTR KPI cards: left-edge accent on hover + glow */
    .otr-kpi-card::after {
        content: '';
        position: absolute;
        left: 0; top: 20%; bottom: 20%;
        width: 3px;
        background: linear-gradient(180deg, #fb923c, #ea580c);
        border-radius: 0 2px 2px 0;
        opacity: 0;
        transition: opacity .2s;
    }
    .otr-kpi-card:hover::after { opacity: 1; }
    .otr-kpi-card:hover {
        box-shadow: 0 8px 28px rgba(249,115,22,.2), 0 0 0 1.5px rgba(249,115,22,.35);
    }

    /* Download card strip: brighter on hover */
    .db-dl-card:hover .db-dl-card-strip { filter: brightness(1.2) saturate(1.15); }

    /* Department filter buttons: pill shape */
    .kpi-dept-btn { border-radius: 50px; }

    /* Quick action cards: deeper lift shadow */
    .db-qa-card:hover {
        box-shadow: 0 12px 32px rgba(0,0,0,.13), 0 0 0 1.5px rgba(0,0,0,.07);
    }

    </style>

<!-- ═══════════ Hero Banner ═══════════ -->
<div class="db-hero">
    <div class="db-hero-left">
        @{
            var userInitials = !string.IsNullOrWhiteSpace(Model.UserName) ? Model.UserName.Substring(0, 1).ToUpper() : "U";
        }
        <div class="db-hero-avatar">
            @if (!string.IsNullOrEmpty(Model.UserPhotoPath))
            {
                <img src="@OperatorCertificationRecord.Web.Services.EmployeeFileUrls.Photo(Model.UserPhotoPath)" alt="@Model.UserName"
                     onerror="if(this.src.includes('/api/photo/employee/')){this.alt='Photo unavailable';this.title='Photo unavailable';return;}this.onerror=null;this.parentElement.innerHTML='<span style=&quot;display:flex;align-items:center;justify-content:center;width:100%;height:100%;&quot;>@userInitials</span>';" />
            }
            else
            {
                @userInitials
            }
        </div>
        <div>
            <div class="db-hero-name">Welcome back, @Model.UserName</div>
            <div class="db-hero-dept">@Model.DepartmentName</div>
        </div>
    </div>
</div>

@if (!Model.DashboardDataAvailable)
{
    <div class="alert alert-warning" role="status">@Model.DashboardErrorMessage</div>
}

<!-- ═══════════ Operator Training Record ═══════════ -->
@if (Model.IsCurrentUserAdmin)
{
<div class="otr-section">
    <div class="otr-header">
        <i class="bi bi-clipboard2-data-fill me-2"></i>Operator Training record
        <button type="button" class="btn btn-sm btn-light ms-auto" onclick="openExpiringModal()" aria-controls="expiringModal">
            <i class="bi bi-clock-history me-1" aria-hidden="true"></i> Expiring soon
        </button>
    </div>
    
    <!-- Department Filter -->
    <div style="padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--gray-200); background: #f8fafc;">
        <div class="kpi-filter-row">
            <span class="kpi-filter-label"><i class="bi bi-funnel-fill me-2"></i>Filter by Department:</span>
            <div class="kpi-dept-buttons">
                <button type="button" class="kpi-dept-btn active all-data" data-department="all" aria-pressed="true" onclick="filterKpiByDept('all', this)">All Data</button>
                <button type="button" class="kpi-dept-btn" data-department="ta" aria-pressed="false" onclick="filterKpiByDept('ta', this)">TA Dept</button>
                <button type="button" class="kpi-dept-btn" data-department="qa" aria-pressed="false" onclick="filterKpiByDept('qa', this)">QA Dept</button>
                <button type="button" class="kpi-dept-btn" data-department="sc" aria-pressed="false" onclick="filterKpiByDept('sc', this)">SC Dept</button>
                <button type="button" class="kpi-dept-btn" data-department="planning" aria-pressed="false" onclick="filterKpiByDept('planning', this)">Planning</button>
            </div>
        </div>
    </div>
    
    <p id="kpi-filter-status" class="text-danger small px-3" role="status"></p>
    <div class="otr-body">
        <div class="otr-grid-container">
            <!-- KPI Cards (Left) -->
            <div class="otr-kpi-grid">
                <div class="otr-kpi-card">
                    <div class="otr-kpi-card-left">
                        <div class="otr-kpi-label">Operator</div>
                        <div class="otr-kpi-value" id="kpiOperator" data-all="@(Model.DashboardDataAvailable ? Model.TotalEmployees.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)">@(Model.DashboardDataAvailable ? Model.TotalEmployees.ToString("N0") : "?")</div>
                        <div class="otr-kpi-unit">person</div>
                    </div>
                    <div class="otr-kpi-icon"><i class="bi bi-people-fill"></i></div>
                </div>
                <div class="otr-kpi-card">
                    <div class="otr-kpi-card-left">
                        <div class="otr-kpi-label">Total Process</div>
                        <div class="otr-kpi-value" id="kpiProcess" data-all="@(Model.DashboardDataAvailable ? Model.TotalProcesses.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)">@(Model.DashboardDataAvailable ? Model.TotalProcesses.ToString("N0") : "?")</div>
                        <div class="otr-kpi-unit">process</div>
                    </div>
                    <div class="otr-kpi-icon"><i class="bi bi-diagram-3-fill"></i></div>
                </div>
                <div class="otr-kpi-card">
                    <div class="otr-kpi-card-left">
                        <div class="otr-kpi-label">Total Skill</div>
                        <div class="otr-kpi-value" id="kpiSkill" data-all="@(Model.DashboardDataAvailable ? Model.TotalSkills.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)">@(Model.DashboardDataAvailable ? Model.TotalSkills.ToString("N0") : "?")</div>
                        <div class="otr-kpi-unit">skill</div>
                    </div>
                    <div class="otr-kpi-icon"><i class="bi bi-stars"></i></div>
                </div>
                <div class="otr-kpi-card">
                    <div class="otr-kpi-card-left">
                        <div class="otr-kpi-label">Handicap</div>
                        <div class="otr-kpi-value" id="kpiHandicap" data-all="@(Model.DashboardDataAvailable ? Model.HandicapCount.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)">@(Model.DashboardDataAvailable ? Model.HandicapCount.ToString("N0") : "?")</div>
                        <div class="otr-kpi-unit">person</div>
                    </div>
                    <div class="otr-kpi-icon"><i class="bi bi-heart-pulse-fill"></i></div>
                </div>
                <div class="otr-kpi-card">
                    <div class="otr-kpi-card-left">
                        <div class="otr-kpi-label">Operator 1 skill</div>
                        <div class="otr-kpi-value" id="kpiOneSkill" data-all="@(Model.DashboardDataAvailable ? Model.OneSkillCount.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)">@(Model.DashboardDataAvailable ? Model.OneSkillCount.ToString("N0") : "?")</div>
                        <div class="otr-kpi-unit">person</div>
                    </div>
                    <div class="otr-kpi-icon"><i class="bi bi-person-check-fill"></i></div>
                </div>
                <div class="otr-kpi-card">
                    <div class="otr-kpi-card-left">
                        <div class="otr-kpi-label">Operator no skill</div>
                        <div class="otr-kpi-value" id="kpiNoSkill" data-all="@(Model.DashboardDataAvailable ? Model.NoSkillCount.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)">@(Model.DashboardDataAvailable ? Model.NoSkillCount.ToString("N0") : "?")</div>
                        <div class="otr-kpi-unit">person</div>
                    </div>
                    <div class="otr-kpi-icon"><i class="bi bi-person-x-fill"></i></div>
                </div>
            </div>
            
            <!-- Process Category Cards (Right) -->
            <div class="otr-process-grid">
                <button type="button" class="otr-process-card" id="pcTa" onclick="handleProcessClick('Ta Manufacturing')">
                    <div class="otr-process-icon"><i class="bi bi-gear-fill"></i></div>
                    <div class="otr-process-text">
                        <div class="otr-process-name">Ta Manufacturing</div>
                    </div>
                </button>
                <button type="button" class="otr-process-card" id="pcQa" onclick="handleProcessClick('QA')">
                    <div class="otr-process-icon"><i class="bi bi-shield-check"></i></div>
                    <div class="otr-process-text">
                        <div class="otr-process-name">QA</div>
                    </div>
                </button>
                <button type="button" class="otr-process-card" id="pcSc" onclick="handleProcessClick('SC Manufacturing')">
                    <div class="otr-process-icon"><i class="bi bi-lightning-charge-fill"></i></div>
                    <div class="otr-process-text">
                        <div class="otr-process-name">SC Manufacturing</div>
                    </div>
                </button>
                <button type="button" class="otr-process-card" id="pcPlanning" onclick="handleProcessClick('Production & Material Planning')">
                    <div class="otr-process-icon"><i class="bi bi-clipboard2-check-fill"></i></div>
                    <div class="otr-process-text">
                        <div class="otr-process-name">Production & Material Planning</div>
                    </div>
                </button>
            </div>
        </div>
    </div>
</div>
}

<!-- ═══════════ Skill Level Chart ═══════════ -->
@if (Model.IsCurrentUserAdmin)
{
<div class="sl-section">
    <div class="sl-header">
        <i class="bi bi-bar-chart-fill me-2"></i>Skill level
    </div>
    <div class="sl-body">
        <div class="sl-chart-wrap">
