                <span class="sl-legend-item"><span class="sl-dot" style="background:#16a34a"></span>L</span>
                <span class="sl-legend-item"><span class="sl-dot" style="background:#facc15"></span>U</span>
                <span class="sl-legend-item"><span class="sl-dot" style="background:#f97316"></span>O</span>
                <span class="sl-legend-item"><span class="sl-dot" style="background:#0f172a"></span>TTL</span>
