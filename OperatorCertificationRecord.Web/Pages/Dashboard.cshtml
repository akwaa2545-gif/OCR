@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
    /* ===== Skill Level Bar Chart ===== */
    (function(){
        var rawChartData = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(System.Text.Json.JsonSerializer.Serialize(Model.SkillLevelTrend ?? new System.Collections.Generic.List<OperatorCertificationRecord.Web.Models.SkillLevelMonthData>())))';
        var trendData = [];
        try { trendData = JSON.parse(rawChartData); } catch(e) { console.warn('[SkillChart] parse failed', e); }

        // Collect unique month keys sorted
        var monthMap = {};
        trendData.forEach(function(d){ var k = d.Year+'-'+String(d.Month).padStart(2,'0'); monthMap[k]={y:d.Year,m:d.Month}; });
        var sortedKeys = Object.keys(monthMap).sort();

        // Build labels (e.g. "Jan 24")
        var monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        var labels = sortedKeys.map(function(k){ var p=monthMap[k]; return monthNames[p.m-1]+' '+String(p.y).slice(2); });

        var levels = ['X','I','L','U','O'];
        var levelColors = { 'X':'#ef4444','I':'#86efac','L':'#16a34a','U':'#facc15','O':'#f97316' };

        var datasets = levels.map(function(lv){
            return {
                label: lv,
                data: sortedKeys.map(function(k){
                    var p=monthMap[k];
                    var row=trendData.find(function(d){return d.Year===p.y&&d.Month===p.m&&d.SkillLevel===lv;});
                    return row?row.Count:0;
                }),
                backgroundColor: levelColors[lv],
                stack: 'stack1',
                order: 1
            };
        });

        // TTL as line on secondary axis
        datasets.push({
            label:'TTL',
            type:'line',
            data: sortedKeys.map(function(k){
                var p=monthMap[k];
                return trendData.filter(function(d){return d.Year===p.y&&d.Month===p.m;}).reduce(function(s,d){return s+d.Count;},0);
            }),
            borderColor:'#0f172a',
            backgroundColor:'rgba(15,23,42,0.08)',
            borderWidth:2,
            pointRadius:4,
            fill:false,
            yAxisID:'ttl',
            order:0
        });

        var ctx = document.getElementById('skillLevelChart');
        if(!ctx||typeof Chart==='undefined') return;
        new Chart(ctx, {
            type:'bar',
            data:{ labels:labels, datasets:datasets },
            options:{
                responsive:true,
                maintainAspectRatio:false,
                plugins:{ legend:{ position:'bottom' }, tooltip:{ mode:'index' } },
                scales:{
                    x:{ stacked:true, grid:{ color:'rgba(0,0,0,.05)' } },
                    y:{ stacked:true, beginAtZero:true, grid:{ color:'rgba(0,0,0,.05)' } },
                    ttl:{ position:'right', beginAtZero:true, grid:{ drawOnChartArea:false }, ticks:{ color:'#64748b' } }
                }
            }
        });
    })();
    </script>
    <script src="~/js/dashboard-search.js" asp-append-version="true"></script>
    <script>
        // embed the server-side expiring list for client-side filtering (exposed on window for all scripts)
        window.expiringItems = window.expiringItems || [];
        var expiringItems = window.expiringItems;
        try {
            // Serialize on server but emit as a JS string so any embedded '<' or '<\/script>' fragments won't break page parsing.
            var _raw = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(System.Text.Json.JsonSerializer.Serialize(Model.ExpiringSoonList ?? new System.Collections.Generic.List<OperatorCertificationRecord.Web.Models.ExpiringSkill>())))';
            try {
                window.expiringItems = expiringItems = JSON.parse(_raw);
                console.debug('[Expiring] embedded expiringItems count:', (window.expiringItems || []).length);
            } catch(e) {
                console.warn('[Expiring] JSON parse failed, falling back to empty array', e);
                window.expiringItems = expiringItems = [];
            }
        } catch(e) {
            console.warn('[Expiring] failed to embed expiringItems', e);
            window.expiringItems = expiringItems = [];
        }
    </script>
    <script>
        function openExpiringModal() {
            const el = document.getElementById('expiringModal');
            if (!el) return;
            // move modal to body so no ancestor transforms interfere with Bootstrap centering
            if (el.parentElement !== document.body) {
                el._originalParent = el.parentElement;
                document.body.appendChild(el);
            }

            const m = new bootstrap.Modal(el);

            // restore original parent on hide
            el.addEventListener('hidden.bs.modal', function handler() {
                el.removeEventListener('hidden.bs.modal', handler);
                if (el._originalParent) {
                    el._originalParent.appendChild(el);
                    delete el._originalParent;
                }
            });

            // Defensive: ensure expiry highlighting runs immediately after the modal is shown
            // (covers cases where global handlers may not have been bound yet).
            el.addEventListener('shown.bs.modal', function once(){
                try { if (typeof highlightExpiryDatesInModal === 'function') highlightExpiryDatesInModal(); } catch(e) { /* ignore */ }
                el.removeEventListener('shown.bs.modal', once);
            });

            m.show();
        }
    </script>
